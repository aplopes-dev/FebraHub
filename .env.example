# FebraHub — variáveis de ambiente.
# Copie para .env e preencha. O .env NUNCA entra no Git.
#
# Gere cada segredo com valor aleatório próprio, um por variável:
#   openssl rand -hex 32

NODE_ENV=production
TAG=1.0.0

# ---------------- URLs ----------------
APP_URL=https://febracis.aplopes.com
FRONTEND_URL=https://febracis.aplopes.com
API_URL=https://febracis.aplopes.com/api
# Caminho relativo: o browser fala com a API pelo mesmo domínio, via Nginx.
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://febracis.aplopes.com
COOKIE_DOMAIN=febracis.aplopes.com

# ---------------- PostgreSQL ----------------
# O host é o nome do serviço no compose: o banco não publica porta no host.
POSTGRES_DB=febrahub
POSTGRES_USER=febrahub
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://febrahub:SENHA@postgres:5432/febrahub?schema=public&connection_limit=15&pool_timeout=20

# ---------------- Sessão ----------------
# Mínimo de 32 caracteres cada — a API não sobe com menos.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=

# ---------------- MinIO ----------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=febrahub
MINIO_REGION=us-east-1
UPLOAD_MAX_BYTES=26214400

# ---------------- ETLs ----------------
# Token de máquina das rotas /api/ingest. Substitui a service_role do Supabase,
# que ignorava toda a RLS: quem tivesse aquela chave tinha o banco inteiro.
# Este token só abre as rotas de ingestão, e só as tabelas de carga.
ETL_TOKEN=

# ---------------- Integrações OAuth ----------------
# Credenciais dos apps que a API usa para autorizar as fontes externas pelo
# painel de Integrações (sem Postman, sem ferramenta externa).
#
# ONDE ELAS FICAM EM PRODUÇÃO: em /opt/febrahub/etl.env, não neste .env — é o
# mesmo arquivo que os ETLs leem, e o docker-compose.prod.yml passou a apontá-lo
# também no serviço `api`. Estão listadas aqui para quem sobe o ambiente local
# saber que existem.
#
# A URL de redirecionamento que precisa estar cadastrada no painel de cada
# provedor é ${APP_URL}/api/integracoes/<fonte>/callback, exatamente assim:
#   Conta Azul → https://febracis.aplopes.com/api/integracoes/contaazul/callback
#   Meta Ads   → https://febracis.aplopes.com/api/integracoes/meta/callback
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
# O Conta Azul v2 roda sobre Cognito. Em branco, a API usa
# "openid profile aws.cognito.signin.user.admin".
CONTAAZUL_SCOPE=
META_APP_ID=
META_APP_SECRET=

# ---------------- Marketing · Instagram (login direto) ----------------
# Sidecar aiograpi-rest (API PRIVADA do Instagram) usado pela aba Marketing para
# conectar a conta oficial por login direto — DMs, publicações, stories, perfis
# e insights. É COMPLEMENTAR ao Zernio (chave sk_ gravada pela tela). Sem esta
# URL a seção "Instagram (login direto)" aparece como indisponível.
# Ex.: http://aiograpi:8000  (nome do serviço na rede do compose, sem barra final)
ALOOK_AIOGRAPI_URL=

# ---------------- seed ----------------
# Senha do usuário de QA criado pelo seed. Sem esta variável, ele não é criado.
SEED_QA_SENHA=

# ---------------- Loja · gateway de pagamento (ASAAS) ----------------
# Cardápio Digital e PDV usam o ASAAS para PIX e cartão. Sem ASAAS_API_KEY o
# provider "manual" assume (operador confirma; PIX vira placeholder).
#   Sandbox:  https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
# O webhook deve apontar para ${APP_URL}/api/loja-pedidos/publico/webhook/asaas
# e o "Token de autenticação" cadastrado no painel do ASAAS = ASAAS_WEBHOOK_TOKEN.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
# Minutos para o cardápio liberar reserva de pedido não pago (padrão 30):
LOJA_RESERVA_EXPIRA_MIN=30
# Minutos para lembrar o cliente de retirada de pedido pronto (padrão 5):
LOJA_LEMBRETE_PRONTO_MIN=5
