# NUNCA commitar credenciais.
# A service_role key do Supabase ignora toda a RLS —
# vazar ela é entregar o banco inteiro.
.env
.env.*
!.env.example
*.key
secrets/

#service
service_account.json
*service_account*.json

# Node
node_modules/
dist/
.vite/

# Python
__pycache__/
*.pyc
.venv/
venv/

# SO
.DS_Store
Thumbs.db

# Graphify — cache/backups regeneráveis; o grafo e o relatório entram no git
graphify-out/cache/
graphify-out/20*/

# Jars de cookie do e2e (sessão viva de produção — jamais versionar)
c_admin.txt
c_com.txt
e2e.csv
e2e.bin

# Dumps de banco (25MB cada — nao versionar; backup fica fora do git)
supabase/*.dump
# Credenciais de seed geradas (nao versionar)
CREDENCIAIS_SEED.txt
# Backups locais de compose
docker-compose.prod.yml.bak.*
_team_src/
