# =============================================================================
# Aplopes Platform — monorepo (gestao/, food/, apps/, packages/, services/)
# =============================================================================

# --- Dependencies ---
node_modules/
.pnpm-store/
# Monorepo usa pnpm — lockfiles de outros gerenciadores são artefato local
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb

# --- Monorepo / tooling cache ---
.turbo/
.cache/
.swc/
.eslintcache
.prettiercache

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Build outputs (Nest, Next, packages, Storybook) ---
dist/
.next/
out/
build/
storybook-static/
docs/api.html

# --- Environment & secrets ---
.env
.env.*
!.env.example
!**/.env.example
!.env.development
!**/.env.development
infra/platform-apps.env
services/platform-apps.env
services/.marketplace-api.env
services/.marketplace-bff.env

# --- OS / IDE ---
# .cursor/ e .claude/ (harness ACC) ficam versionados de propósito
# Exceção: MCP local pode conter tokens — versionar só mcp.json.example
.cursor/mcp.json
.claude/settings.local.json
.claude/launch.json
.claude/hookify.*.local.md
.cursor/hookify.*.local.md
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.pem

# Xcode — estado local do usuário
**/xcuserdata/
*.xcuserstate

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# --- Docker (volumes / dados locais) ---
city_pg_data/
gestao_pg_data/
aplopes_*_data/

# --- Test / coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
**/.playwright/

# --- Harness GAN (gerado em runtime por /gan-build) ---
gan-harness/

# --- Prisma (SQLite local / dev) ---
*.db
*.db-journal

# --- Deploy platforms ---
.vercel

# --- SSL local (certbot em dev; produção usa paths do host) ---
services/nginx/certbot/
services/nginx/letsencrypt/
# --- Legacy path (rename apps/platform → apps/admin, 2026-07-31) ---
# Evita commit acidental de prisma generate no diretório antigo.
apps/platform/

