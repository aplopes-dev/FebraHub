apps/marketplace/android/local.properties
apps/marketplace/android/api-client/.gradle/
apps/marketplace/android/api-client/build/
apps/marketplace/ios/**/DerivedData/
apps/marketplace/ios/**/.build/
apps/marketplace/web/dist/
apps/marketplace/web/node_modules/

# Graphify (grafo de código local)
graphify-out/

# Protótipo HTML local (bundle pesado; assets já estão em public/assets/home)
