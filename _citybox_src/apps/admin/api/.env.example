PORT=3103
DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/citybox_platform?schema=platform

# ─── Keycloak — realm próprio do admin (ADR C-16 / C-17) ─────────────────────
# O admin é o sistema de MAIOR privilégio: MFA TOTP obrigatório e sessão idle de
# 15 min no realm `citybox-admin`. Os usuários dele são a EQUIPE INTERNA Citybox
# (roles `platform_admin` / `platform_operator`), não lojistas.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=citybox-admin
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-admin
KEYCLOAK_CLIENT_ID=admin-web
KEYCLOAK_CLIENT_SECRET=admin-web-dev-secret
# Invariante 1 do C-16: o guard valida `azp` contra esta lista. O admin não
# recebe chamada M2M de ninguém — só o seu próprio app web.
KEYCLOAK_ALLOWED_AZP=admin-web

# Service account do PRÓPRIO realm. `manage-users` só em `citybox-admin`:
# substitui o `citybox-core-admin` global, que era o defeito D3 do C-16.
KEYCLOAK_PROVISIONING_CLIENT_ID=admin-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=admin-provisioning-dev-secret

# Convite (`execute-actions-email`) da equipe interna — aponta para o admin-web.
KEYCLOAK_INVITE_REDIRECT_URI=http://127.0.0.1:3108/auth/callback

RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
# Outbox transacional (ver AGENTS.md §5.12). Sem RABBITMQ_URL o relay não publica,
# mas os eventos ficam PENDING em platform.outbox_events — não são perdidos.
# OUTBOX_RELAY_ENABLED=false      # desliga só o relay; o enfileiramento continua
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_LEASE_SECONDS=30


REDIS_URL=redis://127.0.0.1:16379

CORS_ORIGINS=http://localhost:3103,http://127.0.0.1:3103,http://localhost:3108,http://127.0.0.1:3108

# Asaas (payment-gateway) — obrigatório para boot do módulo de pagamentos
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Chaves que começam com $: use aspas simples no .env local
ASAAS_API_KEY=dev-smoke-test-placeholder
ASAAS_WEBHOOK_TOKEN=dev-smoke-test-placeholder

# ─── Escrita M2M em verticais (PLAT-001 Fase 7) ──────────────────────────────
# URL base da clinica-api. Usada para criar membro da vertical pelo admin e para
# gerar as credenciais do responsável da organização.
# Ausente = o adapter resolve `undefined` e a rota responde "vertical não
# suportada", que é indistinguível de "essa vertical não tem API de membros".
CLINICA_API_URL=http://127.0.0.1:3172

# URL base do erp-api (sem /api). Com ERP_API_URL setado, Comércio passa a
# teamSource=vertical e o card "Responsável" aparece no detalhe da loja.
ERP_API_URL=http://127.0.0.1:3114

# URL base do imoveis-api (sem /api). Com IMOVEIS_API_URL setado, Imóveis passa a
# teamSource=vertical e o card "Gerar senha" do responsável aparece no detalhe.
IMOVEIS_API_URL=http://127.0.0.1:3112

# URL base do beautiful-api (sem /api). Com BEAUTIFUL_API_URL setado, Beautiful passa a
# teamSource=vertical e o card "Gerar senha" do responsável aparece no detalhe.
BEAUTIFUL_API_URL=http://127.0.0.1:3173

# ─── Credencial M2M por vertical (ADR C-16 / C-17) ───────────────────────────
# O client `admin-m2m` vive DENTRO do realm de cada vertical, não no realm do
# admin: cada vertical valida `issuer` e `azp` do seu próprio realm. Por isso são
# três valores por vertical, e não um token único reusado em todas.
#
# Esse client NÃO tem `manage-users` — só a realm role `platform.admin`, que é o
# que a vertical exige em `@RequirePermission('platform.admin')`. Criar usuário no
# Keycloak da vertical é do `<sistema>-provisioning` dela, nunca do admin (defeito
# D3 do ADR C-16).
#
# Ausentes = a rota falha nomeando a env que faltou, em vez de "não foi possível
# falar com a vertical" (que esconderia a causa).

KEYCLOAK_ERP_M2M_ISSUER=http://127.0.0.1:8080/realms/citybox-erp
KEYCLOAK_ERP_M2M_CLIENT_ID=admin-m2m
KEYCLOAK_ERP_M2M_CLIENT_SECRET=admin-m2m-dev-secret

KEYCLOAK_CLINICA_M2M_ISSUER=http://127.0.0.1:8080/realms/citybox-clinica
KEYCLOAK_CLINICA_M2M_CLIENT_ID=admin-m2m
KEYCLOAK_CLINICA_M2M_CLIENT_SECRET=admin-m2m-dev-secret

KEYCLOAK_IMOVEIS_M2M_ISSUER=http://127.0.0.1:8080/realms/citybox-imoveis
KEYCLOAK_IMOVEIS_M2M_CLIENT_ID=admin-m2m
KEYCLOAK_IMOVEIS_M2M_CLIENT_SECRET=admin-m2m-dev-secret

KEYCLOAK_BEAUTIFUL_M2M_ISSUER=http://127.0.0.1:8080/realms/citybox-beautiful
KEYCLOAK_BEAUTIFUL_M2M_CLIENT_ID=admin-m2m
KEYCLOAK_BEAUTIFUL_M2M_CLIENT_SECRET=admin-m2m-dev-secret
