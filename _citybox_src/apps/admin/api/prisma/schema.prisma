generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform"]
}

model User {
  id            String   @id @default(uuid())
  keycloakSub   String   @unique @map("keycloak_sub")
  email         String?
  displayName   String?  @map("display_name")
  role          String   @default("platform_operator") @map("role")
  photoKey      String?  @map("photo_key")
  photoMimeType String?  @map("photo_mime_type")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
  @@schema("platform")
}

// `Client` foi removido no PLAT-001 (Fase 10). A Loja é a unidade de billing: os dados
// cadastrais e de cobrança que viviam aqui (documento, personType, responsável, e-mail de
// cobrança, endereço) estão na própria `Store`, e a noção de "grupo de lojas" passou a ser
// a `Organization` **dentro de cada vertical**, não uma tabela da plataforma.

enum StoreStatus {
  IN_SETUP
  TRAINING
  PRODUCTION
  BLOCKED
  OFFLINE

  @@schema("platform")
}

enum StoreDeploymentStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED

  @@schema("platform")
}

model Store {
  id                       String                @id @default(uuid())
  vertical                 String
  /// Vertente da clínica (`odontologia` | `fisioterapia`). Null fora de Clínica.
  clinicStrand             String?               @map("clinic_strand")
  tradeName                String                @map("trade_name")
  slug                     String                @unique
  status                   StoreStatus           @default(IN_SETUP)
  deploymentStatus         StoreDeploymentStatus @default(PENDING) @map("deployment_status")
  document                 String?
  personType               String?               @map("person_type")
  responsibleName          String?               @map("responsible_name")
  billingEmail             String?               @map("billing_email")
  /// Id do customer no PSP (Asaas). Migrou de `Client` na Fase 10: é por ele que o
  /// webhook de pagamento descobre a que loja o pagamento pertence.
  gatewayCustomerId        String?               @unique @map("gateway_customer_id")
  legalName                String?               @map("legal_name")
  stateRegistration        String?               @map("state_registration")
  zipCode                  String?               @map("zip_code")
  street                   String?
  number                   String?
  complement               String?
  neighborhood             String?
  city                     String?
  state                    String?
  phone                    String?
  timezone                 String
  lastSeenAt               DateTime?             @map("last_seen_at") @db.Timestamptz(3)
  ordersToday              Int                   @default(0) @map("orders_today")
  ordersThisMonth          Int                   @default(0) @map("orders_this_month")
  revenueTodayCents        Int                   @default(0) @map("revenue_today_cents")
  averageTicketCents       Int                   @default(0) @map("average_ticket_cents")
  averageAcceptTimeSeconds Int                   @default(0) @map("average_accept_time_seconds")
  lastOrderAt              DateTime?             @map("last_order_at") @db.Timestamptz(3)
  lastAccessAt             DateTime?             @map("last_access_at") @db.Timestamptz(3)
  maintenanceMode          Boolean               @default(false) @map("maintenance_mode")
  visibleInApp             Boolean               @default(false) @map("visible_in_app")
  trialEndsAt              DateTime?             @map("trial_ends_at") @db.Timestamptz(3)
  sefazHomologacao         Boolean               @default(false) @map("sefaz_homologacao")
  contingenciaOffline      Boolean               @default(false) @map("contingencia_offline")
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  terminals     StoreTerminal[]
  errors        StoreError[]
  members       StoreMember[]
  modules       StoreModule[]
  integrations  StoreIntegration[]
  auditEvents   StoreAuditEvent[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([status])
  @@index([vertical])
  @@index([createdAt])
  @@map("stores")
  @@schema("platform")
}

model StoreTerminal {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  label      String
  status     String    @default("offline")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_terminals")
  @@schema("platform")
}

model StoreError {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  message    String
  severity   String   @default("warning")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@map("store_errors")
  @@schema("platform")
}

model Member {
  id                   String    @id @default(uuid())
  keycloakSub          String    @unique @map("keycloak_sub")
  username             String    @unique
  email                String    @unique
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  hasPassword          Boolean   @default(false) @map("has_password")
  isActive             Boolean   @default(true) @map("is_active")
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz(3)
  provisionalExpiresAt DateTime? @map("provisional_expires_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // O vínculo com lojas é **sempre** via `assignments` (`store_members`): um membro pode
  // operar em N lojas. A coluna escalar `store_id` que existia aqui não conseguia
  // expressar isso e vivia nula — foi removida na Fase 10 junto com `client_id`.
  assignments StoreMember[]

  @@map("members")
  @@schema("platform")
}

model StoreMember {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  memberId    String   @map("member_id")
  role        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([storeId, memberId])
  @@index([storeId])
  @@index([memberId])
  @@map("store_members")
  @@schema("platform")
}

model StoreModule {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  moduleKey String   @map("module_key")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, moduleKey])
  @@map("store_modules")
  @@schema("platform")
}

model StoreIntegration {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  integrationKey String   @map("integration_key")
  label          String
  status         String   @default("disconnected")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, integrationKey])
  @@map("store_integrations")
  @@schema("platform")
}

model StoreAuditEvent {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  severity   String   @default("info")
  actor      String
  actorRole  String?  @map("actor_role")
  module     String
  action     String
  details    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@map("store_audit_events")
  @@schema("platform")
}

enum PlanStatus {
  ACTIVE
  HIDDEN

  @@schema("platform")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED

  @@schema("platform")
}

enum SubscriptionCycle {
  MONTHLY
  YEARLY

  @@schema("platform")
}

model Plan {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String
  vertical    String?
  tier        String?
  maxStores   Int        @map("max_stores")
  maxNegocios Int?       @map("max_negocios")
  maxUsers    Int        @map("max_users")
  maxProducts Int?       @map("max_products")
  status      PlanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices PlanPrice[]

  @@index([vertical])
  @@map("plans")
  @@schema("platform")
}

model PlanPrice {
  id            String            @id @default(uuid())
  planId        String            @map("plan_id")
  stripePriceId String?           @unique @map("stripe_price_id")
  cycle         SubscriptionCycle
  priceCents    Int               @map("price_cents")
  status        PlanStatus        @default(ACTIVE)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, cycle])
  @@map("plan_prices")
  @@schema("platform")
}

model Subscription {
  id                   String             @id @default(uuid())
  storeId              String             @map("store_id")
  planPriceId          String             @map("plan_price_id")
  cycle                SubscriptionCycle
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(3)
  dayOfMonth            Int                @map("day_of_month")
  gatewaySubscriptionId String?            @unique @map("gateway_subscription_id")
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  store     Store     @relation(fields: [storeId], references: [id])
  planPrice PlanPrice @relation(fields: [planPriceId], references: [id])
  invoices  Invoice[]

  @@index([storeId])
  @@index([planPriceId])
  @@index([status])
  // A migration mantém um UNIQUE parcial garantindo no máximo uma assinatura
  // ACTIVE|TRIALING **por loja** (era por cliente antes da Fase 10 — sem trocar a chave,
  // dropar `client_id` deixaria a loja poder acumular assinaturas ativas e ser cobrada
  // duas vezes).
  @@map("subscriptions")
  @@schema("platform")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PAST_DUE
  VOID

  @@schema("platform")
}

model Invoice {
  id              String        @id @default(uuid())
  subscriptionId  String        @map("subscription_id")
  storeId         String        @map("store_id")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("BRL")
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime      @map("due_date") @db.Timestamptz(3)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  method           String?
  gatewayPaymentId String?     @unique @map("gateway_payment_id")
  invoiceUrl       String?     @map("invoice_url")
  notes            String?
  periodStart      DateTime    @map("period_start") @db.Timestamptz(3)
  periodEnd       DateTime      @map("period_end") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id])

  @@index([subscriptionId])
  @@index([storeId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
  @@schema("platform")
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("platform")
}

model PaymentGatewayWebhookEvent {
  id             String             @id @default(uuid())
  gatewayEventId String             @unique @map("gateway_event_id")
  provider       String
  eventType      String             @map("event_type")
  payload        Json
  status         WebhookEventStatus @default(PENDING)
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(3)
  errorMessage   String?            @map("error_message")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([gatewayEventId])
  @@index([status])
  @@map("payment_gateway_webhook_events")
  @@schema("platform")
}


enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("platform")
}

/// Outbox transacional (PLAT-001 / Fase 1). Gravado na MESMA transação da escrita de
/// domínio; o `OutboxRelayService` publica no RabbitMQ depois do commit. Sem isto, um
/// evento perdido significa loja paga sem organização provisionada na vertical, sem retry.
model OutboxEvent {
  id            String            @id @default(uuid())
  /// id do CloudEvent — chave de idempotência para o consumidor
  eventId       String            @unique @map("event_id")
  /// tipo versionado, ex.: citybox.store.created.v1
  type          String
  routingKey    String            @map("routing_key")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  /// envelope CloudEvent completo, pronto para publicar
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  /// backoff exponencial: o relay só considera linhas com availableAt <= now()
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
  @@schema("platform")
}
