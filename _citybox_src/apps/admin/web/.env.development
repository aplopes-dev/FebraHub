# admin-web — dev local
PORT=3108
ADMIN_API_URL=http://127.0.0.1:3103/api
NEXT_PUBLIC_ADMIN_ORIGIN=http://127.0.0.1:3108

# ─── Keycloak — realm próprio do admin (ADR C-16 / C-17) ─────────────────────
# Realm de maior privilégio: MFA TOTP obrigatório, sessão idle de 15 min.
# Nenhuma das três variáveis tem default no código — app mal configurado falha.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-admin
NEXT_PUBLIC_KEYCLOAK_CLIENT=admin-web
KEYCLOAK_ADMIN_WEB_SECRET=admin-web-dev-secret
