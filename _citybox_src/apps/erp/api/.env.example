# Obrigatório quando AUTH_DEV_BYPASS=true — o bypass só liga em development/test/local
NODE_ENV=development
PORT=3114
# Banco citybox_platform, schema erp (mesmo host/credenciais de food/api e platform/api)
DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/citybox_platform?schema=erp

# Keycloak — realm PRÓPRIO do ERP (ADR C-16: um realm por sistema).
# O issuer é único e obrigatório: não há lista de fallback, aceitar mais de um
# issuer seria aceitar token de mais de um realm.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=citybox-erp
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-erp
# Client do app web — usado para ler as client roles em `resource_access`.
KEYCLOAK_CLIENT_ID=erp-web
KEYCLOAK_CLIENT_SECRET=erp-web-dev-secret
# Clients cujos tokens esta API aceita (claim `azp`): o web dos lojistas e o
# chamador M2M do admin-api. Sem default — ver ADR C-17, bloco 1.
KEYCLOAK_ALLOWED_AZP=erp-web,admin-m2m

# Bypass de auth em dev (NUNCA em produção) — Authorization: Bearer dev-admin
# AUTH_DEV_BYPASS=true
# AUTH_DEV_USERNAME=admin
# AUTH_DEV_EMAIL=admin@citybox.local

# Keycloak Admin API — necessário para cadastrar membros (cria a identidade e a
# senha provisória). Service account `erp-provisioning`, com manage-users,
# view-users e query-users LIMITADOS ao realm citybox-erp.
KEYCLOAK_PROVISIONING_CLIENT_ID=erp-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=erp-provisioning-dev-secret

# RabbitMQ — consumidor de `citybox.store.*` (fila `erp-comercio.store-setup`).
# Mesmos nomes usados por clinica-api e food-api. Sem RABBITMQ_URL a API sobe
# normalmente, mas lojas da vertical Comércio criadas no admin NÃO são
# provisionadas (ficam presas em PROVISIONING lá).
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
RABBITMQ_EXCHANGE=citybox.events
RABBITMQ_DLX=citybox.dlx
# Desliga o consumidor sem tirar a URL (ex.: rodar duas instâncias e só uma consumir)
# ERP_COMERCIO_WORKER_ENABLED=false

# MinIO — imagens de produto (bucket `erp`, key {orgId}/catalogo/products/…)
MINIO_ENDPOINT=127.0.0.1:9000
# Deve casar com infra/minio/.env (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
MINIO_ACCESS_KEY=aplopes
MINIO_SECRET_KEY=citybox-minio-dev
MINIO_BUCKET=erp
MINIO_USE_SSL=false

# ─── Ponte para a services/fiscal-api (ADR C-16) ─────────────────────────────
# A fiscal-api não aceita mais token de usuário final: ela confia no sistema
# chamador. Quem valida "este usuário pode operar este Emitente" é a erp-api,
# que resolve o Emitente pelo CNPJ da organização ativa — o cliente não escolhe.
FISCAL_API_URL=http://127.0.0.1:3116/api

# Client `fiscal-m2m` do realm citybox-erp (service account, role fiscal_operator).
KEYCLOAK_FISCAL_M2M_CLIENT_ID=fiscal-m2m
KEYCLOAK_FISCAL_M2M_CLIENT_SECRET=fiscal-m2m-dev-secret
