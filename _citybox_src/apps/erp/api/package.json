{
  "name": "@citybox/erp-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "nest start --watch",
    "predev": "prisma generate",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "provision:orgs": "ts-node scripts/provision-organizations.ts",
    "db:backfill:financial-entries": "ts-node scripts/backfill-financial-entry-allocations.ts",
    "db:backfill:financial-group-classification": "ts-node scripts/backfill-financial-group-classification.ts",
    "db:backfill:financial-group-catalog-order": "ts-node scripts/backfill-financial-group-catalog-order.ts",
    "db:backfill:sale-order-payment-method-ids": "ts-node scripts/backfill-sale-order-payment-method-ids.ts",
    "db:migrate:pos-operators-to-memberships": "ts-node scripts/migrate-pos-operators-to-memberships.ts",
    "db:strip:caixa-withdrawal": "ts-node scripts/strip-caixa-withdrawal-permission.ts"
  },
  "dependencies": {
    "@citybox/messaging": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "jose": "^5.9.6",
    "minio": "^8.0.5",
    "ofx-js": "^1.1.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "^11.0.1",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.8.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*ofx-js)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
