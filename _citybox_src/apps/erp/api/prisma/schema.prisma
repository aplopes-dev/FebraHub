  paid

  @@schema("erp")
}

model FinancialEntry {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  operation      FinancialEntryOperation
  description    String                  @default("")
  amountCents    Int                     @map("amount_cents")
  /// Taxa, somada ao valor base para compor o total.
  feesCents      Int                     @default(0) @map("fees_cents")
  /// Multa, somada ao valor base para compor o total.
  finesCents     Int                     @default(0) @map("fines_cents")
  /// Cache recalculado, a cada `save()`, a partir da soma de `payments[].amountCents`
  /// — nunca aceito bruto do cliente (ver `status`).
  paidCents      Int                     @default(0) @map("paid_cents")
  /// Derivado (`paidCents >= amountCents + feesCents + finesCents`), recalculado
  /// junto de `paidCents` a cada `save()` — persistido para permitir filtro
  /// server-side (`WHERE status IN (...)`) sem carregar todas as linhas.
  status         FinancialEntryStatus    @default(pending)
  competenceDate DateTime                @map("competence_date") @db.Date
  dueDate        DateTime                @map("due_date") @db.Date
  partyName      String                  @default("") @map("party_name")
  customerId     String?                 @map("customer_id")
  /// Mutuamente exclusivo com `customerId` (validado na aplicação, não no schema).
  supplierId     String?                 @map("supplier_id")
  bankAccountId  String?                 @map("bank_account_id")
  /// Não editável pelo formulário — só o fechamento de `SaleOrder` preenche.
  /// Quando presente, o lançamento inteiro fica somente-leitura.
  saleOrderId    String?                 @map("sale_order_id")
  /// Mantida por compatibilidade histórica (pré-rateio) — nenhum código novo lê/escreve.
  categoryName   String                  @default("") @map("category_name")
  note           String                  @default("")

  /// Motor de recebíveis do contrato de cartões (`specs/erp/005-card-receivables-engine/`).
  /// Todos os campos abaixo são `null`/`false` para lançamentos fora do motor
  /// (manuais, ou vendas fechadas antes desta entrega — nunca recalculados).
  /// Valor bruto da venda para este recebível/parcela, antes da taxa da adquirente.
  grossAmountCents       Int?    @map("gross_amount_cents")
  /// Taxa da adquirente (percentual + tarifa fixa) descontada. Dedutiva — sem
  /// relação com `feesCents`/`finesCents` acima, que são aditivas (atraso/multa).
  acquirerFeeCents       Int?    @map("acquirer_fee_cents")
  /// Contrato de cartão resolvido no fechamento da venda (sistema-derivado, não
  /// escolhido pelo operador).
  cardContractId         String? @map("card_contract_id")
  /// Método de pagamento do contrato resolvido no fechamento.
  cardPaymentMethodId    String? @map("card_payment_method_id")
  /// Pagamento da venda de origem — base da idempotência do motor (junto de
  /// `installmentSequence`); nulo para o recebível agregado "resto do pedido"
  /// (pagamentos sem `cardPaymentType`) e para lançamentos manuais.
  saleOrderPaymentId     String? @map("sale_order_payment_id")
  /// 1-based; `1` mesmo quando há só 1 parcela (pagamento único, Pix, fallback).
  installmentSequence    Int?    @map("installment_sequence")
  /// Total de parcelas geradas para o pagamento de origem.
  installmentCount       Int?    @map("installment_count")
  /// `true` quando este recebível nasceu do fallback (sem contrato/método
  /// correspondente) para um pagamento que tinha `cardPaymentType` setado —
  /// indicador visível ao usuário financeiro, não só log técnico.
  cardSettlementFallback Boolean @default(false) @map("card_settlement_fallback")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount          BankAccount?               @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], onDelete: SetNull)
  customer             Customer?                  @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: SetNull)
  supplier             Supplier?                  @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: SetNull)
  installments         ContractInstallment[]
  payments             FinancialEntryPayment[]
  allocations          FinancialEntryAllocation[]
  attachments          FinancialEntryAttachment[]
  cardContract         CardContract?              @relation(fields: [cardContractId, organizationId], references: [id, organizationId], onDelete: SetNull)
  cardPaymentMethod    CardPaymentMethod?         @relation(fields: [cardPaymentMethodId, organizationId], references: [id, organizationId], onDelete: SetNull)
  saleOrderPayment     SaleOrderPayment?          @relation(fields: [saleOrderPaymentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Vínculos de conciliação bancária (`006-bank-reconciliation`) — existem só
  /// enquanto a conciliação está ativa (research.md D6 dessa feature).
  bankStatementMatches BankStatementMatch[]

  @@unique([id, organizationId])
  @@unique([saleOrderPaymentId, installmentSequence])
  @@index([organizationId, deletedAt])
  @@index([organizationId, operation])
  @@index([organizationId, competenceDate])
  @@index([organizationId, status])
  @@index([cardContractId])
  @@index([cardPaymentMethodId])
  @@map("financial_entries")
  @@schema("erp")
}

/// Uma linha de rateio de pagamento — parte do valor de um lançamento
/// efetivamente recebida/paga numa forma específica. Substituída por completo
/// (delete + recreate) a cada `save()` do lançamento — sem identidade estável
/// para o cliente entre saves (mesmo raciocínio de `SaleOrderPayment`).
model FinancialEntryPayment {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  financialEntryId String   @map("financial_entry_id")
  amountCents      Int      @map("amount_cents")
  paidAt           DateTime @map("paid_at") @db.Date
  /// Enum de aplicação fixo (dinheiro/pix/debito/credito/boleto/deposito/transferencia)
  /// — validado no DTO HTTP, não há cadastro de formas de pagamento ainda.
  paymentMethod    String   @map("payment_method")
  /// Livre, sem cadastro — mesmo padrão de `CardPaymentMethod.brand`.
  cardBrand        String?  @map("card_brand")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialEntry FinancialEntry @relation(fields: [financialEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([financialEntryId])
  @@map("financial_entry_payments")
  @@schema("erp")
}

/// Uma linha de rateio por categoria financeira — fatia do valor total de um
/// lançamento atribuída a uma conta do plano de contas + um centro de custo
/// (obrigatório). A soma de todas as linhas de um lançamento deve fechar com
/// o valor total (tolerância de 1 centavo) — validado na aplicação. Alimenta
/// a DRE. Substituída por completo a cada `save()`, mesmo padrão de `payments`.
model FinancialEntryAllocation {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  financialEntryId String  @map("financial_entry_id")
  chartOfAccountId String  @map("chart_of_account_id")
  costCenterId     String  @map("cost_center_id")
  amountCents      Int     @map("amount_cents")
  percentage       Decimal @db.Decimal(7, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialEntry FinancialEntry @relation(fields: [financialEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  costCenter     CostCenter     @relation(fields: [costCenterId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([financialEntryId])
  @@index([chartOfAccountId])
  @@index([costCenterId])
  @@map("financial_entry_allocations")
  @@schema("erp")
}

/// Um comprovante anexado a um lançamento. Único filho com CRUD HTTP próprio
/// (upload/download/remoção assíncronos, fora do payload principal de
/// criação/edição) — falha de anexo nunca bloqueia o salvamento do lançamento.
model FinancialEntryAttachment {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  financialEntryId String @map("financial_entry_id")
  fileName         String @map("file_name")
  /// Chave no MinIO — nunca exposta ao cliente (mesmo padrão de `imageUrl` em catalog).
  objectKey        String @map("object_key")
  contentType      String @map("content_type")
  sizeBytes        Int    @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialEntry FinancialEntry @relation(fields: [financialEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([financialEntryId])
  @@map("financial_entry_attachments")
  @@schema("erp")
}

// ─── Conciliação bancária (006-bank-reconciliation) ────────────────────────

enum BankStatementStatus {
  not_reconciled
  partially_reconciled
  reconciled

  @@schema("erp")
}

enum BankStatementTransactionStatus {
  pending
  reconciled
  discarded

  @@schema("erp")
}

enum BankStatementTransactionKind {
  credit // entrada — verde, RN-07
  debit // saída — vermelho, RN-07

  @@schema("erp")
}

/// Extrato bancário importado em OFX — o arquivo original fica no MinIO
/// (bucket `erp`, `BankReconciliationObjectKeyPolicy`), nunca no Postgres.
/// `status`/contadores são cache recalculado a cada ação sobre as
/// transações do extrato (mesma convenção de `FinancialEntry.status`/
/// `paidCents` — nunca aceito bruto do cliente).
model BankStatement {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  /// Opcional desde 007-financeiro-ajustes-ui FR-007: a importação não exige
  /// mais conta bancária resolvida — `null` quando o código do banco do
  /// arquivo não bate com exatamente 1 conta ativa da organização.
  bankAccountId  String? @map("bank_account_id")

  bankName      String   @default("") @map("bank_name")
  bankCode      String   @default("") @map("bank_code")
  branchNumber  String   @default("") @map("branch_number")
  accountNumber String   @default("") @map("account_number")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date

  status BankStatementStatus @default(not_reconciled)

  pendingCount    Int @default(0) @map("pending_count")
  reconciledCount Int @default(0) @map("reconciled_count")
  discardedCount  Int @default(0) @map("discarded_count")

  fileName       String @map("file_name")
  objectKey      String @map("object_key")
  importedByName String @default("") @map("imported_by_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount?               @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions BankStatementTransaction[]

  @@unique([id, organizationId])
  @@index([organizationId, bankAccountId, createdAt])
  @@map("bank_statements")
  @@schema("erp")
}

/// Uma linha extraída do OFX. `dedupeKey` (não `fitId` cru) é a chave real de
/// unicidade — `dedupeKey = fitId` quando presente, senão um hash de
/// `(postedAt, amountCents, memo)` (research.md D11 de 006-bank-reconciliation).
model BankStatementTransaction {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  bankStatementId String  @map("bank_statement_id")
  /// Denormalizado de `bankStatement.bankAccountId` — usado na query de
  /// candidatos do matcher sem precisar de join. Opcional desde
  /// 007-financeiro-ajustes-ui FR-007 (extrato pode não ter conta
  /// resolvida); o dedupe de importação passou a ser por organização, não
  /// mais por conta (`findExistingDedupeKeys`).
  bankAccountId   String? @map("bank_account_id")

  fitId     String @default("") @map("fit_id")
  dedupeKey String @map("dedupe_key")

  postedAt        DateTime                     @map("posted_at") @db.Date
  /// Sempre positivo — o sinal vem de `kind`, nunca daqui (mesma convenção de
  /// `BankTransaction.amountCents`).
  amountCents     Int                          @map("amount_cents")
  kind            BankStatementTransactionKind
  transactionType String                       @default("") @map("transaction_type")
  memo            String                       @default("")

  status       BankStatementTransactionStatus @default(pending)
  reconciledAt DateTime?                      @map("reconciled_at") @db.Timestamptz(3)
  discardedAt  DateTime?                      @map("discarded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankStatement BankStatement        @relation(fields: [bankStatementId, organizationId], references: [id, organizationId], onDelete: Cascade)
  matches       BankStatementMatch[]

  @@unique([id, organizationId])
  /// Dedupe por organização (não mais por conta) — coerente com
  /// `bankAccountId` opcional: um extrato sem conta resolvida ainda precisa
  /// deduplicar contra reimportação (007-financeiro-ajustes-ui FR-007).
  @@unique([organizationId, dedupeKey])
  @@index([organizationId, bankStatementId, status])
  @@map("bank_statement_transactions")
  @@schema("erp")
}

/// Vínculo N:1 transação↔lançamento (N lançamentos podem casar com 1
/// transação — repasse agrupado, FR-017 de 006-bank-reconciliation). Existe
/// só enquanto a conciliação está ativa — desfazer é hard delete
/// (research.md D6), não soft-delete.
model BankStatementMatch {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  bankStatementTransactionId String @map("bank_statement_transaction_id")
  financialEntryId           String @map("financial_entry_id")
  /// id do `FinancialEntryPayment` criado por esta conciliação — permite
  /// `removePayment(id)` exato ao desfazer, sem heurística de "pagamento mais
  /// recente". Sem `@relation` formal (value object embutido em
  /// `FinancialEntry.payments`, sem tabela própria consultável por FK).
  financialEntryPaymentId    String @map("financial_entry_payment_id")
  amountCents                Int    @map("amount_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction    BankStatementTransaction @relation(fields: [bankStatementTransactionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  financialEntry FinancialEntry           @relation(fields: [financialEntryId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([bankStatementTransactionId, financialEntryId])
  @@unique([id, organizationId])
  @@index([organizationId, financialEntryId])
  @@map("bank_statement_matches")
  @@schema("erp")
}

/// Terminal de PDV cadastrado por uma unidade — o dispositivo físico (desktop,
/// tablet) que vai se identificar contra a erp-api. Primeiro módulo da
/// integração PDV↔ERP (ver .claude/plans/_platform/pos-terminals-pdv-integration.plan.md);
/// pareamento real (troca de código por credencial de longa duração) é fatia futura.
model PosTerminal {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  branchId        String            @map("branch_id")
  name            String
  status          PosTerminalStatus @default(active)
  printer         String?
  scale           String?
  nfceContingency Boolean           @default(false) @map("nfce_contingency")
  offlineServerId String?           @map("offline_server_id")

  /// Código opaco de uso único, gerado por `POST .../pair`. `null` até a primeira
  /// geração; regenerar sobrescreve o anterior (não cumulativo).
  pairingCode          String?   @map("pairing_code")
  pairingCodeExpiresAt DateTime? @map("pairing_code_expires_at") @db.Timestamptz(3)

  /// SHA-256 do device token. O token em claro existe **uma vez**, na resposta
  /// do `redeem` — igual a chave de API. `null` = nunca pareado ou revogado.
  deviceTokenHash   String?   @map("device_token_hash")
  pairedAt          DateTime? @map("paired_at") @db.Timestamptz(3)
  /// Rótulo que o próprio dispositivo informou ("Windows · Caixa da frente"),
  /// para o gerente reconhecer o que está revogando.
  pairedDeviceLabel String?   @map("paired_device_label")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(3)

  /// Sobrescrita **deste** terminal sobre o padrão da loja.
  ///
  /// `null` = herda, e continua herdando quando o padrão mudar. Um `{}` não
  /// serviria: seria indistinguível de "configurado sem nada ligado", e o
  /// terminal deixaria de acompanhar a loja em silêncio.
  ///
  /// Só os **opcionais** entram — ver `resolveTerminalModules`.
  moduleOverrides Json? @map("module_overrides")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSessions      PosCashSession[]
  saleOrders        SaleOrder[]
  posDeliveryOrders PosDeliveryOrder[]

  @@unique([id, organizationId])
  /// O `redeem` e o `DeviceAuthGuard` procuram sem saber a organização — são
  /// as duas únicas consultas do sistema que rodam fora do escopo de tenant.
  @@index([pairingCode])
  @@index([deviceTokenHash])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, deletedAt])
  @@map("pos_terminals")
  @@schema("erp")
}

enum PosCashSessionStatus {
  open
  closed

  @@schema("erp")
}

enum PosCashMovementType {
  withdrawal
  reinforcement

  @@schema("erp")
}

/// Turno de caixa do PDV (abrir → movimentos/vendas → fechar).
model PosCashSession {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  branchId       String               @map("branch_id")
  posTerminalId  String               @map("pos_terminal_id")
  status         PosCashSessionStatus @default(open)

  openedAt DateTime  @map("opened_at") @db.Timestamptz(3)
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)

  openedByUserId String @map("opened_by_user_id")
  openedByName   String @map("opened_by_name")

  openingFloatCents Int @map("opening_float_cents")

  /// Contagens físicas no fechamento (canais do PDV). Null enquanto open.
  countedCashCents    Int? @map("counted_cash_cents")
  countedCreditCents  Int? @map("counted_credit_cents")
  countedDebitCents   Int? @map("counted_debit_cents")
  countedVoucherCents Int? @map("counted_voucher_cents")
  countedOtherCents   Int? @map("counted_other_cents")

  expectedCashCents     Int? @map("expected_cash_cents")
  differenceCashCents   Int? @map("difference_cash_cents")
  /// Soma das contagens informadas (todos os canais) no fechamento.
  declaredReceiptsCents Int? @map("declared_receipts_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  posTerminal  PosTerminal       @relation(fields: [posTerminalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  movements    PosCashMovement[]
  saleOrders   SaleOrder[]

  @@unique([id, organizationId])
  @@index([organizationId, openedAt])
  @@index([organizationId, status])
  @@index([posTerminalId, status])
  @@index([openedByUserId])
  @@map("pos_cash_sessions")
  @@schema("erp")
}

model PosCashMovement {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  sessionId      String              @map("session_id")
  type           PosCashMovementType
  amountCents    Int                 @map("amount_cents")
  reason         String              @default("")
  /// Alinhado ao Flutter `CashOperationType` (ex.: cashWithdrawal).
  operation      String

  operatorUserId String @map("operator_user_id")
  operatorName   String @map("operator_name")

  authorizedByUserId String? @map("authorized_by_user_id")
  authorizedByName   String? @map("authorized_by_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      PosCashSession @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([sessionId, createdAt])
  @@index([organizationId])
  @@map("pos_cash_movements")
  @@schema("erp")
}

// ---------------------------------------------------------------------------
// DELIVERY DA LOJA — pedido operacional (antes/junto do checkout PDV).
// ---------------------------------------------------------------------------

enum PosDeliveryOrderStatus {
  received
  preparing
  dispatched
  delivered
  cancelled

  @@schema("erp")
}

enum PosDeliveryFulfillment {
  delivery
  pickup

  @@schema("erp")
}

/// Pedido operacional de delivery/retirada da loja (multi-terminal, branch-scoped).
model PosDeliveryOrder {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  branchId       String                 @map("branch_id")
  number         Int
  status         PosDeliveryOrderStatus @default(received)
  fulfillment    PosDeliveryFulfillment @default(delivery)

  customerId   String? @map("customer_id")
  customerName String  @default("") @map("customer_name")

  addressZipCode    String? @map("address_zip_code")
  addressStreet     String? @map("address_street")
  addressNumber     String? @map("address_number")
  addressDistrict   String? @map("address_district")
  addressCity       String? @map("address_city")
  addressState      String? @map("address_state")
  addressComplement String? @map("address_complement")
  /// Texto de exibição; obrigatório quando fulfillment = delivery.
  addressText       String  @default("") @map("address_text")

  feeCents    Int     @default(0) @map("fee_cents")
  courierId   String? @map("courier_id")
  courierName String? @map("courier_name")

  posTerminalId  String? @map("pos_terminal_id")
  operatorUserId String? @map("operator_user_id")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?              @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: SetNull)
  courier      Carrier?               @relation(fields: [courierId, organizationId], references: [id, organizationId], onDelete: SetNull)
  posTerminal  PosTerminal?           @relation(fields: [posTerminalId, organizationId], references: [id, organizationId], onDelete: SetNull)
  /// Reverse da FK em SaleOrder.posDeliveryOrderId (1:N no Prisma; unique
  /// ativa é parcial em SQL — uma venda não-cancelada por delivery).
  saleOrders   SaleOrder[]            @relation("SaleOrderPosDelivery")
  lines        PosDeliveryOrderLine[]

  @@unique([organizationId, branchId, number])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, createdAt])
  @@index([posTerminalId])
  @@index([customerId])
  @@index([courierId])
  @@map("pos_delivery_orders")
  @@schema("erp")
}

model PosDeliveryOrderLine {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  deliveryOrderId String  @map("delivery_order_id")
  productId       String  @map("product_id")
  productName     String  @map("product_name")
  quantity        Decimal @db.Decimal(18, 6)
  unitPriceCents  Int     @map("unit_price_cents")
  notes           String  @default("")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryOrder PosDeliveryOrder @relation(fields: [deliveryOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product       Product          @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([deliveryOrderId])
  @@index([productId])
  @@map("pos_delivery_order_lines")
  @@schema("erp")
}

/// Alçadas do PDV — **uma por organização**.
///
/// Política é da empresa, não do terminal: limite por terminal seria explorável
/// escolhendo o caixa mais frouxo. Por isso `organizationId` é `@unique` e não
/// existe `branchId` aqui.
///
/// Ver `.claude/plans/_platform/pdv-erp-auth-offline.plan.md` (M5).
model PosPolicy {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Desconto acima disto exige supervisor. `100` = nunca exige.
  discountSupervisorAbovePercent Int     @default(10) @map("discount_supervisor_above_percent")
  /// Sangria acima disto exige supervisor. `0` = sempre exige.
  withdrawalSupervisorAboveCents Int     @default(50000) @map("withdrawal_supervisor_above_cents")
  cancellationRequiresSupervisor Boolean @default(true) @map("cancellation_requires_supervisor")
  refundRequiresSupervisor       Boolean @default(true) @map("refund_requires_supervisor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pos_policies")
  @@schema("erp")
}

/// Configuração fiscal do PDV — **uma por organização** (spec erp/013).
///
/// Qual modelo de documento fiscal o PDV emite ao concluir a venda. Entidade
/// própria, ao lado de `PosPolicy` e não dentro dela: tipo de documento fiscal
/// não é alçada de operador. `posDocumentModel` nulo = não configurado (a venda
/// conclui sem documento, comportamento atual). Não mora no Emitente da
/// fiscal-api (que não conhece PDV/organização).
model PosFiscalSettings {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// `MODEL_55` (NF-e) | `MODEL_65` (NFC-e) | null = não configurado.
  posDocumentModel String? @map("pos_document_model")
  /// Quem alterou por último (registro de auditoria — dado sensível).
  updatedByUserId  String? @map("updated_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pos_fiscal_settings")
  @@schema("erp")
}

/// Padrão de módulos do PDV — **um por organização**.
///
/// O que um terminal novo herda, e o que os terminais sem sobrescrita seguem
/// quando muda. Separado de `PosPolicy` de propósito: alçada é **permissão**
/// (quem pode fazer), módulo é **capacidade** (o que a loja faz). Uma tela só
/// mudaria duas coisas sem relação.
///
/// ⚠️ **Não confundir com o catálogo de módulos do `admin-api`**, que responde
/// "a loja pagou por isto?". Este responde "este caixa usa isto?".
///
/// Ver `.claude/plans/_platform/pdv-modulos-por-terminal.plan.md`.
model PosModuleDefaults {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Nome do perfil aplicado por último ("Restaurante", "Loja"…). Informativo:
  /// o que vale é [modules], porque o gerente pode ajustar depois de aplicar.
  profileName String? @map("profile_name")

  /// `{ "tables": "available", "delivery": "disabled", … }` — só os
  /// **opcionais**. O núcleo nunca entra: guardá-lo persistiria uma intenção
  /// que a resolução ignora.
  modules Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pos_module_defaults")
  @@schema("erp")
}

enum PosTerminalStatus {
  active
  inactive

  @@schema("erp")
}
