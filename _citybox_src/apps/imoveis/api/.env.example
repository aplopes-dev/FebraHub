PORT=3112
# Postgres local da Citybox escuta em 15433 — sem esta URL o pg.Pool cai em :5432.
DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/citybox_platform?schema=imoveis

# E-mail de alerta de lead do catálogo (SubmitPublicLead)
#
# DEV (recomendado): Mailpit captura tudo — UI em http://127.0.0.1:8025
#   pnpm infra:up:mailpit
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@citybox.local
SMTP_FROM_NAME=Citybox Imóveis
# LEADS_NOTIFY_EMAIL=voce@example.com   # extras além do e-mail do corretor
#
# PRODUÇÃO / Gmail (troque o bloco acima):
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=seu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=seu@gmail.com
# SMTP_FROM_NAME=Citybox Imóveis

# Google Calendar OAuth2 (por corretor)
# Console: https://console.cloud.google.com/apis — OAuth client tipo Web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3112/api/v1/users/me/integrations/google-calendar/callback
# Opcional: HMAC do state OAuth (default = GOOGLE_CLIENT_SECRET)
# GOOGLE_OAUTH_STATE_SECRET=
# Redirect pós-callback para o web
IMOVEIS_WEB_URL=http://localhost:3111

# Keycloak — realm próprio da vertical (ADR C-16 / C-17)
#
# `KEYCLOAK_ISSUER` é ÚNICO: não há lista de fallback de host. Aceitar mais de um
# issuer seria aceitar token de mais de um realm.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=citybox-imoveis
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-imoveis

# Client web (confidencial) — de onde vêm as client roles lidas do token.
KEYCLOAK_CLIENT_ID=imoveis-web
KEYCLOAK_CLIENT_SECRET=imoveis-web-dev-secret

# Invariante 1 do ADR C-16: o guard valida `azp` contra esta lista.
# `imoveis-web` = app dos corretores; `admin-m2m` = chamador M2M do admin-api
# (traz a realm role local `platform.admin`).
KEYCLOAK_ALLOWED_AZP=imoveis-web,admin-m2m

# Service account que cria os membros — `manage-users` SÓ no realm citybox-imoveis.
# Substitui o antigo `citybox-core-admin` global (defeito D3 do ADR C-16).
KEYCLOAK_PROVISIONING_CLIENT_ID=imoveis-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=imoveis-provisioning-dev-secret

# RabbitMQ — consumer `imoveis.store-setup` (citybox.store.#)
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
RABBITMQ_EXCHANGE=citybox.events
RABBITMQ_DLX=citybox.dlx
# IMOVEIS_WORKER_ENABLED=false  # desliga só o consumer; HTTP segue ativo
