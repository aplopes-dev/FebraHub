{
  "name": "@citybox/marketplace-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 70 --statements 80 --include 'src/auth/**' --include 'src/tenancy/**' --include 'src/health/**' --include 'src/outbox/**' --include 'src/users/**' --include 'src/identity/**' --exclude '**/*.d.ts' node --import tsx --test test/**/*.test.ts",
    "db:generate": "prisma generate --schema prisma/platform/schema.prisma",
    "db:generate:tenant": "prisma generate --schema prisma/tenant/schema.prisma",
    "db:migrate:tenant:dev": "prisma migrate dev --config tenant.config.ts",
    "db:migrate:tenant:deploy": "prisma migrate deploy --config tenant.config.ts",
    "db:migrate:tenant:status": "prisma migrate status --config tenant.config.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@citybox/messaging": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "minio": "^8.0.5",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "c8": "^10.1.3",
    "prisma": "7.8.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
