generator client {
  provider = "prisma-client"
  output   = "../../src/generated/platform"
}

datasource db {
  provider = "postgresql"
}

/// Verticais ativas na plataforma — gatilho para CREATE SCHEMA lazy no tenant (C-15).
model PlatformEnabledVertical {
  id            String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  vertical      String   @unique
  schemaCreated Boolean  @default(false)
  enabledAt     DateTime @default(now()) @db.Timestamptz(3)
}

model Organization {
  id            String                     @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  name          String
  createdAt     DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @db.Timestamptz(3)
  stores        Store[]
  subscriptions OrganizationSubscription[]
}

model Store {
  id             String                @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  organizationId String?               @db.Uuid
  organization   Organization?         @relation(fields: [organizationId], references: [id])
  name           String
  slug           String                @unique
  vertical       String                @default("food")
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  devices        DeviceCredential[]
  assignments    StoreUserAssignment[]

  @@index([organizationId])
  @@index([name])
}

/// Vínculo usuário ↔ loja na plataforma (seletor do backoffice).
/// keycloakSub referencia identidade no Keycloak (sem FK — convite pode preceder PlatformUser).
model StoreUserAssignment {
  id          String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  storeId     String   @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  keycloakSub String
  /// Verticais que mantêm este vínculo (ex.: food, legal). Vazio → registro removido.
  verticals   String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([storeId, keycloakSub])
  @@index([keycloakSub])
}

model DeviceCredential {
  id        String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  storeId   String   @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  tokenHash String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId])
}

model PushDeviceToken {
  id        String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  storeId   String?  @db.Uuid
  userId    String?
  platform  String
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId])
}

model NotificationLog {
  id        String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  channel   String
  eventType String
  storeId   String?  @db.Uuid
  status    String   @default("queued")
  payload   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([channel, storeId])
}

model AdminAuditLog {
  id         String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  actorSub   String
  action     String
  resource   String
  resourceId String?  @db.Uuid
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorSub])
  @@index([action, createdAt])
}

model SaaSPlan {
  id         String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  code       String   @unique
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model OrganizationSubscription {
  id             String       @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planCode       String
  status         String       @default("active")
  startedAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([organizationId])
  @@index([planCode])
}

/// Projeção local do usuário Keycloak (foto + cache de exibição).
/// Índice parcial único em lower(trim(email)) — ver migration baseline (não expressável no Prisma).
model PlatformUser {
  id            String   @id @default(dbgenerated("citybox_uuid_v7()")) @db.Uuid
  keycloakSub   String   @unique
  email         String?
  displayName   String?
  photoKey      String?
  photoMimeType String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}
