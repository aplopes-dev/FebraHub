# Porta HTTP (prefixo global /api)
PORT=3102

# Postgres do domínio consumer (schema "consumer" criado via prisma db push)
CONSUMER_DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/ilheus_dev?schema=consumer

# Redis (cache + tokens de reset de senha)
REDIS_URL=redis://127.0.0.1:16379

# Keycloak — realm próprio do marketplace (ADR C-16) + mediação de auth (ADR C-07).
# Realm e clients são declarativos: infra/keycloak/import/citybox-marketplace-realm.json,
# aplicados por `pnpm keycloak:sync`. Não há mais script imperativo de setup.
KEYCLOAK_BASE_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=citybox-marketplace
# Issuer ÚNICO. Sem lista de fallback (invariante 1 do ADR C-16). Se vazio, é
# derivado de ${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}.
KEYCLOAK_ISSUER=http://127.0.0.1:8180/realms/citybox-marketplace
# Client PÚBLICO com PKCE — não tem secret.
KEYCLOAK_CLIENT_ID=marketplace-app
# Service account com manage-users LIMITADO a este realm.
KEYCLOAK_PROVISIONING_CLIENT_ID=marketplace-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=marketplace-provisioning-dev-secret

# Typesense (busca de produtos; fallback automático para Postgres ILIKE)
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=citybox-dev-typesense-key
TYPESENSE_PRODUCTS_COLLECTION=consumer_products

# Base pública do BFF (montagem de URLs absolutas)
PUBLIC_BASE_URL=http://127.0.0.1:3102/api

# Integração com a marketplace-api core (espelho transacional dos pedidos)
# Vazio = desabilitado (pedidos só no schema consumer)
CORE_API_URL=
CORE_STORE_ID=00000000-0000-7000-8000-000000000001
