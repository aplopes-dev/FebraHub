PORT=3173
# Banco citybox_platform (ou citybox local), schema beautiful
DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/citybox?schema=beautiful

# CORS browser→Nest desligado por padrão (web usa BFF /api/proxy/beautiful).
# Só preencha se precisar de acesso browser direto à API (exceção).
# CORS_ORIGINS=

# Keycloak — realm PRÓPRIO do Beautiful (ADR C-16). Sem fallback de issuer:
# aceitar mais de um issuer é aceitar token de mais de um realm.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=citybox-beautiful
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-beautiful

# Client web dos lojistas (confidencial) — de onde vêm as client roles do JWT
KEYCLOAK_CLIENT_ID=beautiful-web
KEYCLOAK_CLIENT_SECRET=beautiful-web-dev-secret

# Clients cujo `azp` esta API aceita: o app web + o M2M do admin-api.
# É `azp`, não `aud` — sem audience mapper o Keycloak põe `aud: account`.
KEYCLOAK_ALLOWED_AZP=beautiful-web,admin-m2m

# Service account do próprio realm — POST /v1/members (convite) e provisionamento
# do OWNER. Tem `manage-users` APENAS em citybox-beautiful (substitui o antigo
# citybox-core-admin global).
KEYCLOAK_PROVISIONING_CLIENT_ID=beautiful-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=beautiful-provisioning-dev-secret

# Dev: libera Bearer dev-admin p/ curl/Swagger (NUNCA em produção; web não usa)
AUTH_DEV_BYPASS=true

# Seed opcional (dev). Preferência: criar loja no admin (vertical Beautiful).
# Sem SEED_STORE_ID o db:seed não cria org/loja.
# SEED_STORE_ID=
# SEED_OWNER_KEYCLOAK_SUB=
SEED_OWNER_USERNAME=lojista
SEED_OWNER_EMAIL=lojista@citybox.com
SEED_OWNER_FIRST_NAME=Maria
SEED_OWNER_LAST_NAME=Lojista
SEED_ORGANIZATION_NAME=Beautiful Demo
SEED_STORE_NAME=Beautiful Demo

# RabbitMQ — consumer store-setup (citybox.store.*) no processo HTTP
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
# RABBITMQ_EXCHANGE=citybox.events
# RABBITMQ_DLX=citybox.dlx
# BEAUTIFUL_WORKER_ENABLED=false

# MinIO (logo do estabelecimento — bucket citybox-beautiful)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=aplopes
MINIO_SECRET_KEY=citybox-minio-dev
MINIO_BUCKET=citybox-beautiful
MINIO_USE_SSL=false
