PORT=3115

# Origem do app (OAuth redirect_uri / post_logout)
NEXT_PUBLIC_BACKOFFICE_ORIGIN=http://127.0.0.1:3115

# Keycloak — realm PRÓPRIO do Beautiful, client próprio (ADR C-16).
# Não há default no código: sem estas duas o app falha em vez de adivinhar.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-beautiful
NEXT_PUBLIC_KEYCLOAK_CLIENT=beautiful-web
# Secret do client confidencial `beautiful-web` (server-only, nunca NEXT_PUBLIC_)
KEYCLOAK_CLIENT_SECRET=beautiful-web-dev-secret
# Issuer interno para o BFF (evita hairpin via nginx); mesmo realm
KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8080/realms/citybox-beautiful

# Upstream do proxy BFF /api/proxy/beautiful (server-only)
BEAUTIFUL_API_URL=http://127.0.0.1:3173/api
