PORT=3172
# Banco único citybox, schema clinica
DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=clinica

# Keycloak — realm PRÓPRIO da clínica (ADR C-16). Contrato de env do ADR C-17.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=citybox-clinica
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-clinica

# Client web deste sistema — usado para ler client roles do token (resource_access).
KEYCLOAK_CLIENT_ID=clinica-web
KEYCLOAK_CLIENT_SECRET=clinica-web-dev-secret

# Clients cujos tokens esta API aceita (claim `azp`). Sem default: obrigatório.
# `admin-m2m` é o service account do admin-api DENTRO deste realm (role platform.admin).
KEYCLOAK_ALLOWED_AZP=clinica-web,admin-m2m

# Credencial de provisionamento — `manage-users` APENAS no realm citybox-clinica.
# Obrigatória para provisionar o RESPONSÁVEL da organização (evento
# `citybox.store.created.v1`). Sem as duas, o provisionamento loga
# "Credencial clinica-provisioning não configurada" e a organização nasce SEM
# ninguém com acesso.
KEYCLOAK_PROVISIONING_CLIENT_ID=clinica-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=clinica-provisioning-dev-secret

CORS_ORIGINS=http://localhost:3107,http://127.0.0.1:3107

# Object storage (MinIO local — ver services/infra ou infra/minio)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=aplopes
MINIO_SECRET_KEY=aplopes-minio-dev
MINIO_USE_SSL=false
MINIO_BUCKET=citybox-clinica

# ZapSign (assinatura eletrônica) — sandbox: https://sandbox.api.zapsign.com.br
# Em produção ZAPSIGN_WEBHOOK_SECRET é obrigatório (header Authorization Bearer ou X-ZapSign-Secret).
# ZAPSIGN_API_TOKEN=
# ZAPSIGN_BASE_URL=https://api.zapsign.com.br
# ZAPSIGN_WEBHOOK_SECRET=

# SEED_STORE_ID=

# Worker store-setup (RabbitMQ) — mesmo padrão food-api
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
RABBITMQ_EXCHANGE=citybox.events
RABBITMQ_DLX=citybox.dlx
# CLINIC_WORKER_ENABLED=false
# CLINIC_WHATSAPP_ENABLED=false
# WHATSAPP_AUTH_DIR=./data/whatsapp
# CLINIC_SEED_DEMO_PROFESSIONAL_ID=   # override store_members.id do agendamento demo

# Equipe demo (gerente + atendente) via platform-api
PLATFORM_API_URL=http://127.0.0.1:3103
# PLATFORM_API_BEARER=   # default: dev-admin se AUTH_DEV_BYPASS=true
# AUTH_DEV_BYPASS=true
