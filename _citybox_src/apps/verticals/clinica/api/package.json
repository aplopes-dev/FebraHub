{
  "name": "@citybox/clinica-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "bash scripts/dev-with-worker.sh",
    "dev:http": "nest start --watch",
    "start:prod": "node dist/src/main",
    "start:worker": "node dist/src/main-worker",
    "start:whatsapp": "node dist/src/main-whatsapp",
    "dev:worker": "nest start --entryFile main-worker --watch",
    "dev:whatsapp": "nest start --entryFile main-whatsapp --watch",
    "lint": "eslint \"{src}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "openapi:export": "ts-node scripts/export-openapi.ts"
  },
  "dependencies": {
    "@citybox/clinica-permissions": "workspace:*",
    "@citybox/messaging": "workspace:*",
    "@hapi/boom": "^10.0.1",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.0.3",
    "jose": "^5.9.6",
    "minio": "^8.0.5",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.8.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@citybox/messaging$": "<rootDir>/src/shared/infra/messaging/__mocks__/citybox-messaging.ts",
      "^@citybox/messaging/clinic-strand$": "<rootDir>/../../../../packages/messaging/src/contracts/clinic-strand.ts",
      "^@citybox/messaging/professional-council$": "<rootDir>/../../../../packages/messaging/src/contracts/professional-council.ts"
    }
  }
}
