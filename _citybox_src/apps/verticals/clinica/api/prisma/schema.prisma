generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["clinica"]
}

model ClinicStore {
  storeId            String   @id @map("store_id")
  tradeName          String   @map("trade_name")
  legalName          String?  @map("legal_name")
  slug               String
  vertical           String
  document           String?
  stateRegistration  String?  @map("state_registration")
  usesClientDocument Boolean  @default(true) @map("uses_client_document")
  zipCode            String?  @map("zip_code")
  street             String?
  number             String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?  @db.VarChar(2)
  phone              String?
  timezone           String
  platformUpdatedAt  DateTime @map("platform_updated_at") @db.Timestamptz(3)
  syncedAt           DateTime @map("synced_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vertical])
  @@map("clinic_stores")
  @@schema("clinica")
}

model ClinicStoreSetup {
  storeId     String   @id @map("store_id")
  version     Int
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)

  @@map("clinic_store_setups")
  @@schema("clinica")
}

model ContractModel {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  content   String   @default("") @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patientEmissions PatientContractEmission[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([storeId, isDefault])
  @@map("contract_models")
  @@schema("clinica")
}

model ProfessionalServiceHours {
  id                         String   @id @default(uuid())
  storeId                    String   @map("store_id")
  memberId                   String   @map("member_id")
  defaultConsultationMinutes Int      @default(30) @map("default_consultation_minutes")
  fixedLunchBreakEnabled     Boolean  @default(false) @map("fixed_lunch_break_enabled")
  lunchBreakStart            String?  @map("lunch_break_start") @db.VarChar(5)
  lunchBreakEnd              String?  @map("lunch_break_end") @db.VarChar(5)
  weekSchedule               Json     @map("week_schedule")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, memberId])
  @@index([storeId])
  @@map("professional_service_hours")
  @@schema("clinica")
}

// --- Modelos existentes (planos / perfil da loja) ---

enum ClinicPlanStatus {
  active
  inactive

  @@schema("clinica")
}

enum ClinicPlanTreatmentInit {
  copy_default
  empty

  @@schema("clinica")
}

model ClinicStoreProfile {
  storeId            String   @id @map("store_id")
  clinicName         String   @default("") @map("clinic_name")
  cnpj               String   @default("")
  communicationsName String   @default("") @map("communications_name")
  responsible        String   @default("")
  logoObjectKey      String?  @map("logo_object_key") @db.VarChar(512)
  logoMimeType       String?  @map("logo_mime_type") @db.VarChar(64)
  openingTime        String   @default("08:00") @map("opening_time")
  closingTime        String   @default("18:00") @map("closing_time")
  email              String   @default("")
  phone              String   @default("")
  mobile             String   @default("")
  cep                String   @default("")
  street             String   @default("")
  number             String   @default("")
  complement         String   @default("")
  neighborhood       String   @default("")
  city               String   @default("")
  state              String   @default("") @db.VarChar(2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("clinic_store_profiles")
  @@schema("clinica")
}

model ClinicPlan {
  id            String                   @id @default(uuid())
  storeId       String                   @map("store_id")
  name          String
  sortOrder     Int                      @map("sort_order")
  status        ClinicPlanStatus         @default(active)
  isDefault     Boolean                  @default(false) @map("is_default")
  treatmentInit ClinicPlanTreatmentInit? @map("treatment_init")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @map("updated_at") @db.Timestamptz(3)
  specialties   ClinicPlanSpecialty[]
  treatments    ClinicPlanTreatment[]
  patients      Patient[]
  budgetItems   BudgetItem[]

  @@index([storeId])
  @@map("clinic_plans")
  @@schema("clinica")
}

enum ClinicPlanLocationUiType {
  tooth
  face_region
  body_region
  session
  none

  @@schema("clinica")
}

model ClinicPlanSpecialty {
  id             String                   @id @default(uuid())
  storeId        String                   @map("store_id")
  planId         String                   @map("plan_id")
  name           String
  locationUiType ClinicPlanLocationUiType @default(tooth) @map("location_ui_type")
  sortOrder      Int                      @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @map("updated_at") @db.Timestamptz(3)
  plan        ClinicPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  treatments  ClinicPlanTreatment[]

  @@index([planId])
  @@index([storeId])
  @@map("clinic_plan_specialties")
  @@schema("clinica")
}

model ClinicPlanTreatment {
  id              String                    @id @default(uuid())
  storeId         String                    @map("store_id")
  planId          String                    @map("plan_id")
  specialtyId     String                    @map("specialty_id")
  name            String
  valueCents      Int                       @map("value_cents")
  costCents       Int                       @map("cost_cents")
  enabled         Boolean                   @default(true)
  acceptsFaces    Boolean                   @default(false) @map("accepts_faces")
  locationUiType  ClinicPlanLocationUiType? @map("location_ui_type")
  sortOrder       Int                       @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @map("updated_at") @db.Timestamptz(3)
  plan         ClinicPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  specialty    ClinicPlanSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  budgetItems    BudgetItem[]
  appointments   Appointment[]

  @@index([planId])
  @@index([specialtyId])
  @@index([storeId])
  @@map("clinic_plan_treatments")
  @@schema("clinica")
}

// --- Anamnese ---

enum AnamnesisTemplateStatus {
  active
  inactive

  @@schema("clinica")
}

enum AnamnesisQuestionType {
  yes_no_unknown
  yes_no_unknown_text
  text
  left_right_unknown
  rich_text
  single_choice

  @@schema("clinica")
}

enum AnamnesisQuestionScope {
  global
  clinic

  @@schema("clinica")
}

enum AnamnesisAlertTrigger {
  yes
  no

  @@schema("clinica")
}

model AnamnesisTemplate {
  id        String                  @id @default(uuid())
  storeId   String                  @map("store_id")
  name      String
  status    AnamnesisTemplateStatus @default(active)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  templateQuestions AnamnesisTemplateQuestion[]
  customQuestions   AnamnesisQuestion[]         @relation("TemplateCustomQuestions")
  patientAnamneses  PatientAnamnesis[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("anamnesis_templates")
  @@schema("clinica")
}

model AnamnesisQuestion {
  id             String                 @id @default(uuid())
  storeId        String?                @map("store_id")
  templateId     String?                @map("template_id")
  text           String
  type           AnamnesisQuestionType
  scope          AnamnesisQuestionScope
  auxiliaryText  String?                @map("auxiliary_text")
  /// Opções de `single_choice`: `[{ value, label, allowsOther? }]`.
  options        Json?
  generatesAlert Boolean                @default(false) @map("generates_alert")
  alertWhen      AnamnesisAlertTrigger? @map("alert_when")
  alertName      String?                @map("alert_name")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  template      AnamnesisTemplate?          @relation("TemplateCustomQuestions", fields: [templateId], references: [id], onDelete: Cascade)
  templateLinks AnamnesisTemplateQuestion[]

  @@index([storeId])
  @@index([templateId])
  @@map("anamnesis_questions")
  @@schema("clinica")
}

model AnamnesisTemplateQuestion {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  templateId String   @map("template_id")
  questionId String   @map("question_id")
  sortOrder  Int      @map("sort_order")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  template AnamnesisTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  question AnamnesisQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([templateId, questionId])
  @@index([storeId])
  @@index([templateId])
  @@map("anamnesis_template_questions")
  @@schema("clinica")
}

// --- Pacientes ---

enum PatientStatus {
  active
  inactive

  @@schema("clinica")
}

enum PatientGender {
  male
  female
  other

  @@schema("clinica")
}

enum PatientReferralOriginSystemKey {
  indicacao
  indicacao_profissional
  indicacao_profissional_externo
  google
  instagram
  facebook
  outro

  @@schema("clinica")
}

model PatientCategory {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String
  /** Hex `#rrggbb` (livre; UI usa seletor de saturação). */
  colorId     String   @map("color_id") @db.VarChar(7)
  isProtected Boolean  @default(false) @map("is_protected")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patients Patient[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("patient_categories")
  @@schema("clinica")
}

model PatientReferralOrigin {
  id        String                           @id @default(uuid())
  storeId   String                           @map("store_id")
  name      String
  systemKey PatientReferralOriginSystemKey?  @map("system_key")
  isSystem  Boolean                          @default(false) @map("is_system")
  createdAt DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)

  patients Patient[]

  @@unique([storeId, name])
  @@unique([storeId, systemKey])
  @@index([storeId])
  @@map("patient_referral_origins")
  @@schema("clinica")
}

model ExternalReferralProfessional {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  phone     String   @default("")
  cro       String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patients Patient[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("external_referral_professionals")
  @@schema("clinica")
}

model Patient {
  id                  String                 @id @default(uuid())
  storeId             String                 @map("store_id")
  status              PatientStatus          @default(active)
  name                String
  cpf                 String?                @db.VarChar(11)
  rg                  String                 @default("")
  birthDate           DateTime?              @map("birth_date") @db.Date
  gender              PatientGender
  photoObjectKey      String?                @map("photo_object_key") @db.VarChar(512)
  photoMimeType       String?                @map("photo_mime_type") @db.VarChar(64)
  phone               String                 @default("")
  landlinePhone       String                 @default("") @map("landline_phone")
  email               String                 @default("")
  socialNetwork       String                 @default("") @map("social_network")
  medicalRecordNumber String                 @default("") @map("medical_record_number")
  referralOriginId    String?                @map("referral_origin_id")
  referredByPatientId String?                @map("referred_by_patient_id")
  referredByMemberId  String?                @map("referred_by_member_id")
  referredByMemberName String?               @map("referred_by_member_name")
  referredByExternalProfessionalId String?   @map("referred_by_external_professional_id")
  profession          String                 @default("")
  categoryId          String                 @map("category_id")
  guardianName        String                 @default("") @map("guardian_name")
  guardianBirthDate   DateTime?              @map("guardian_birth_date") @db.Date
  guardianCpf         String?                @map("guardian_cpf") @db.VarChar(11)
  guardianPhone       String                 @default("") @map("guardian_phone")
  guardianNotes       String                 @default("") @map("guardian_notes")
  zipCode             String                 @default("") @map("zip_code")
  street              String                 @default("")
  streetNumber        String                 @default("") @map("street_number")
  complement          String                 @default("")
  neighborhood        String                 @default("")
  city                String                 @default("")
  state               String                 @default("") @db.VarChar(2)
  planId              String?                @map("plan_id")
  planNumber          String                 @default("") @map("plan_number")
  planHolderName      String                 @default("") @map("plan_holder_name")
  planHolderCpf       String?                @map("plan_holder_cpf") @db.VarChar(11)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  searchVector        Unsupported("tsvector")? @map("search_vector")

  category           PatientCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  plan               ClinicPlan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  referralOrigin     PatientReferralOrigin?  @relation(fields: [referralOriginId], references: [id], onDelete: SetNull)
  referredByPatient  Patient?                @relation("PatientReferrals", fields: [referredByPatientId], references: [id], onDelete: SetNull)
  referredPatients   Patient[]               @relation("PatientReferrals")
  referredByExternalProfessional ExternalReferralProfessional? @relation(fields: [referredByExternalProfessionalId], references: [id], onDelete: SetNull)

  budgets       Budget[]
  treatments    PatientTreatment[]
  evolutions    TreatmentEvolution[]
  nutritionInitiations PatientNutritionInitiation[]
  anamneses     PatientAnamnesis[]
  appointments  Appointment[]
  fitIns        FitIn[]
  returnAlerts  ReturnAlert[]
  financialEntries   FinancialEntry[]
  contractEmissions  PatientContractEmission[]
  prescriptions      PatientPrescription[]
  certificates       PatientCertificate[]
  folders            PatientFolder[]
  files              PatientFile[]
  toothAnnotations          PatientToothAnnotation[]
  bodyRegionAnnotations     PatientBodyRegionAnnotation[]
  bodyMetrics               PatientBodyMetric[]
  salesOpportunities SalesOpportunity[]
  whatsappMessages   WhatsappMessage[]
  electronicSignatures ElectronicSignature[]

  @@unique([storeId, cpf])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, categoryId])
  @@index([storeId, name])
  @@index([storeId, referralOriginId])
  @@index([storeId, referredByExternalProfessionalId])
  @@index([searchVector], type: Gin, map: "idx_patients_fts")
  @@map("patients")
  @@schema("clinica")
}

// --- Orçamentos e Tratamentos (CLIN-041) ---

enum BudgetStatus {
  pending
  approved
  rejected
  expired

  @@schema("clinica")
}

enum BudgetDiscountType {
  fixed
  percent

  @@schema("clinica")
}

enum BudgetItemLocationType {
  tooth
  body_region
  session
  none

  @@schema("clinica")
}

enum PatientTreatmentSource {
  budget
  standalone

  @@schema("clinica")
}

enum PatientTreatmentStatus {
  active
  completed

  @@schema("clinica")
}

enum TreatmentEvolutionSource {
  treatment
  standalone
  nutrition_init

  @@schema("clinica")
}

enum EvolutionHistoryAction {
  created
  edited
  confirmed

  @@schema("clinica")
}

model Budget {
  id                 String              @id @default(uuid())
  storeId            String              @map("store_id")
  patientId          String              @map("patient_id")
  description        String              @default("")
  date               DateTime            @db.Date
  observations       String              @default("") @db.Text
  responsibleId      String              @map("responsible_id")
  responsibleName    String              @default("") @map("responsible_name")
  discountType       BudgetDiscountType? @map("discount_type")
  discountValue      Int?                @map("discount_value")
  subtotalCents      Int                 @map("subtotal_cents")
  finalValueCents    Int                 @map("final_value_cents")
  installmentEnabled Boolean             @default(false) @map("installment_enabled")
  downPaymentCents   Int                 @default(0) @map("down_payment_cents")
  installmentsCount  Int                 @default(0) @map("installments_count")
  status             BudgetStatus        @default(pending)
  supersedesBudgetId String?             @map("supersedes_budget_id")
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(3)
  rejectedAt         DateTime?           @map("rejected_at") @db.Date
  rejectionReason    String?             @map("rejection_reason") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  supersedesBudget Budget?            @relation("BudgetSupersedes", fields: [supersedesBudgetId], references: [id], onDelete: SetNull)
  supersededBy     Budget[]           @relation("BudgetSupersedes")
  items            BudgetItem[]
  treatments          PatientTreatment[]
  financialEntries    FinancialEntry[]
  contractEmissions   PatientContractEmission[]
  salesOpportunity    SalesOpportunity?

  @@index([storeId])
  @@index([storeId, patientId])
  @@index([storeId, patientId, status])
  @@map("budgets")
  @@schema("clinica")
}

model BudgetItem {
  id               String                 @id @default(uuid())
  storeId          String                 @map("store_id")
  budgetId         String                 @map("budget_id")
  planId           String                 @map("plan_id")
  treatmentId      String                 @map("treatment_id")
  professionalId   String                 @map("professional_id")
  professionalName String                 @default("") @map("professional_name")
  planName         String                 @default("") @map("plan_name")
  treatmentName    String                 @default("") @map("treatment_name")
  valueCents       Int                    @map("value_cents")
  locationType     BudgetItemLocationType @default(none) @map("location_type")
  locationLabel    String                 @default("") @map("location_label")
  sessionIndex     Int?                   @map("session_index")
  sessionTotal     Int?                   @map("session_total")
  sortOrder        Int                    @map("sort_order")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget     Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  plan       ClinicPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  treatment  ClinicPlanTreatment @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  treatments PatientTreatment[]
  financialEntries FinancialEntry[]

  @@index([budgetId])
  @@index([storeId])
  @@map("budget_items")
  @@schema("clinica")
}

model PatientTreatment {
  id               String                 @id @default(uuid())
  storeId          String                 @map("store_id")
  patientId        String                 @map("patient_id")
  source           PatientTreatmentSource
  status           PatientTreatmentStatus @default(active)
  budgetId         String?                @map("budget_id")
  budgetItemId     String?                @map("budget_item_id")
  planId           String?                @map("plan_id")
  treatmentId      String?                @map("treatment_id")
  professionalId   String?                @map("professional_id")
  professionalName String                 @default("") @map("professional_name")
  planName         String                 @default("") @map("plan_name")
  treatmentName    String                 @default("") @map("treatment_name")
  description      String                 @default("")
  valueCents       Int                    @map("value_cents")
  locationType     BudgetItemLocationType @default(none) @map("location_type")
  locationLabel    String                 @default("") @map("location_label")
  sessionIndex     Int?                   @map("session_index")
  sessionTotal     Int?                   @map("session_total")
  diagnosis        String                 @default("") @db.Text
  observation      String                 @default("") @db.Text
  sortOrder        Int                    @map("sort_order")
  finalizedAt      DateTime?              @map("finalized_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient    Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  budget     Budget?             @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  budgetItem BudgetItem?         @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  evolutions TreatmentEvolution[]
  nutritionInitiations PatientNutritionInitiation[]

  @@index([storeId])
  @@index([storeId, patientId])
  @@index([storeId, patientId, status])
  @@map("patient_treatments")
  @@schema("clinica")
}

enum EvolutionSignatureStatus {
  unsigned
  pending
  signed

  @@schema("clinica")
}

model TreatmentEvolution {
  id               String                   @id @default(uuid())
  storeId          String                   @map("store_id")
  patientId        String                   @map("patient_id")
  treatmentId      String?                  @map("treatment_id")
  source           TreatmentEvolutionSource
  description      String                   @default("")
  valueCents       Int?                     @map("value_cents")
  evolutionNotes   String                   @default("") @map("evolution_notes") @db.Text
  professionalId   String?                  @map("professional_id")
  professionalName String                   @default("") @map("professional_name")
  finalizedAt      DateTime                 @map("finalized_at") @db.Timestamptz(3)
  soapSubjective   String?                  @map("soap_subjective") @db.Text
  soapObjective    String?                  @map("soap_objective") @db.Text
  soapAssessment   String?                  @map("soap_assessment") @db.Text
  soapPlan         String?                  @map("soap_plan") @db.Text
  cid10Codes       Json?                    @map("cid10_codes")
  confirmedAt      DateTime?                @map("confirmed_at") @db.Timestamptz(3)
  confirmedBy      String?                  @map("confirmed_by")
  confirmationHash String?                  @map("confirmation_hash") @db.VarChar(128)
  signatureStatus  EvolutionSignatureStatus @default(unsigned) @map("signature_status")
  signatureRequestId String?                @map("signature_request_id")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient  Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment PatientTreatment?         @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  signatureRequest ElectronicSignature? @relation(fields: [signatureRequestId], references: [id], onDelete: SetNull)
  history  EvolutionHistory[]
  images   TreatmentEvolutionImage[]
  nutritionInitiation PatientNutritionInitiation?

  @@index([storeId])
  @@index([storeId, patientId])
  @@index([treatmentId])
  @@index([signatureRequestId])
  @@map("treatment_evolutions")
  @@schema("clinica")
}

/**
 * Pacote clínico da Nutrição (Inicializar): Anamnese / Corporal / Plano.
 * Conteúdo das seções ainda TBD — JSON estável para evolução do produto.
 * Cada save cria um card de evolução (`source = nutrition_init`).
 */
model PatientNutritionInitiation {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  patientId        String   @map("patient_id")
  treatmentId      String   @map("treatment_id")
  evolutionId      String   @unique @map("evolution_id")
  patientAnamnesisId String? @unique @map("patient_anamnesis_id")
  anamnesis        Json     @default("{}")
