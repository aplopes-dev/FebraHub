// ===========================================================================
// Tenancy própria da vertical (PLAT-001 / Fase 3)
//
// Organization = a conta operacional da loja dentro da clínica, 1:1 com a Store do
// platform-api (referência LÓGICA via storeId — não há FK cross-schema).
// Clinic       = a unidade operacional real. Uma Organization tem de 1 a N, limitado
//                pelo plano (planMaxClinics, snapshot atualizado por evento).
//
// IMPORTANTE: a Clinic raiz nasce com `id` IGUAL ao `store_id` legado. É o que permite
// que as 49 tabelas que já carregam `store_id` continuem válidas sem reescrever valor —
// o rename cosmético `store_id -> clinic_id` fica para depois, se algum dia.
// ===========================================================================

enum OrganizationStatus {
  active
  suspended

  @@schema("clinica")
}

enum ClinicStatus {
  active
  archived

  @@schema("clinica")
}

model Organization {
  id      String             @id @default(uuid())
  /// Store do platform-api. Referência lógica, populada por evento.
  storeId String             @unique @map("store_id")
  name    String
  status  OrganizationStatus @default(active)
  /// Vertente da clínica. Imutável após o create. Default cobre lojas já provisionadas.
  clinicStrand String @default("odontologia") @map("clinic_strand")

  /// Snapshot do plano — evita chamada síncrona ao platform-api para validar quota.
  planId         String? @map("plan_id")
  planTier       String? @map("plan_tier")
  planMaxClinics Int?    @map("plan_max_clinics")
  planMaxUsers   Int?    @map("plan_max_users")

  /// true quando o uso atual excede o plano (downgrade). Bloqueia CRIAÇÃO de novos
  /// recursos; nunca apaga dado existente por causa de billing.
  overQuota Boolean @default(false) @map("over_quota")

  /// Motivo da suspensão, quando vier do evento (ex.: invoice_past_due).
  suspendedReason String? @map("suspended_reason")

  platformUpdatedAt DateTime? @map("platform_updated_at") @db.Timestamptz(3)
  syncedAt          DateTime  @map("synced_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinics Clinic[]
  members Member[]

  @@index([status])
  @@map("organizations")
  @@schema("clinica")
}

model Clinic {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  slug           String
  /// A clínica criada junto com a organização. Só uma por organização.
  isRoot         Boolean      @default(false) @map("is_root")
  status         ClinicStatus @default(active)

  legalName         String? @map("legal_name")
  document          String?
  stateRegistration String? @map("state_registration")
  zipCode           String? @map("zip_code")
  street            String?
  number            String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String? @db.VarChar(2)
  phone             String?
  timezone          String  @default("America/Sao_Paulo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ClinicMember[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("clinics")
  @@schema("clinica")
}

// ===========================================================================
// Equipe própria da vertical (PLAT-001 / Fase 4)
//
// Antes, a clínica não tinha tabela de pessoas: guardava `platform.store_members.id`
// como String solta em ~15 colunas (professionalId, memberId, responsibleId...), sem FK,
// com o nome denormalizado ao lado, e resolvia tudo via platform-api.
//
// IMPORTANTE: `Member.id` reaproveita o `store_members.id` legado no backfill. É o que
// mantém o histórico clínico (agendamentos, orçamentos, comissões) apontando para a
// pessoa certa. Sem isso, todo o histórico de profissional fica órfão.
// ===========================================================================

enum MemberStatus {
  active
  disabled

  @@schema("clinica")
}

/// Inscrição do profissional no conselho de classe (CRM/CRO/CREFITO/CRN).
enum ProfessionalCouncilType {
  CRM
  CRO
  CREFITO
  CRN

  @@schema("clinica")
}

/// Papel do membro **na organização** — ortogonal ao papel clínico de `ClinicMember.role`.
///
/// `OWNER` é o responsável pela organização: a pessoa cadastrada pelo operador da
/// plataforma (`owner.responsibleName` do evento `citybox.store.created.v1`), a única que
/// não pode ser removida nem desativada pela tela de equipe. Ser responsável **não** diz
/// nada sobre o que a pessoa faz na clínica: o dono pode ser dentista, recepcionista ou
/// nenhum dos dois — isso continua sendo decidido por clínica em `ClinicMember.role`
/// (`gerente`, `dentista`, `recepcionista`, `auxiliar`, `financeiro`).
///
/// Vocabulário alinhado com `MembershipRole` do `erp-comercio` (`OWNER`/`ADMIN`/`MEMBER`);
/// aqui só existem dois valores porque a clínica ainda não tem nível intermediário.
enum OrganizationMemberRole {
  OWNER
  COLLABORATOR

  @@schema("clinica")
}

model Member {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  /// Identidade no Keycloak. Criada/removida atomicamente junto com este registro.
  keycloakSub    String       @unique @map("keycloak_sub")
  username       String       @unique
  email          String?
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  status         MemberStatus @default(active)

  /// Responsável pela organização vs. colaborador. Invariante: **no máximo um `OWNER`
  /// vivo por organização**, garantido pelo índice único parcial
  /// `members_one_owner_per_organization` (só Postgres — o Prisma não modela unique
  /// parcial, então o índice é escrito à mão na migration).
  organizationRole OrganizationMemberRole @default(COLLABORATOR) @map("organization_role")

  /// Inscrição no conselho (CRM/CRO) — preenchida na 1ª emissão de receituário/atestado.
  councilType   ProfessionalCouncilType? @map("council_type")
  councilNumber String?                  @map("council_number") @db.VarChar(20)
  councilUf     String?                  @map("council_uf") @db.Char(2)

  hasPassword          Boolean   @default(false) @map("has_password")
  provisionalExpiresAt DateTime? @map("provisional_expires_at") @db.Timestamptz(3)
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinics      ClinicMember[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, organizationRole])
  @@map("members")
  @@schema("clinica")
}

/// Escopo de acesso: um membro atua em uma ou mais clínicas da organização.
model ClinicMember {
  id          String   @id @default(uuid())
  clinicId    String   @map("clinic_id")
  memberId    String   @map("member_id")
  /// Catálogo de papéis é da vertical (ver clinic-role.catalog.ts), não do platform.
  role        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([clinicId, memberId])
  @@index([clinicId])
  @@index([memberId])
  @@map("clinic_members")
  @@schema("clinica")
}

/// Dedupe de eventos consumidos (PLAT-001 / Fase 5).
///
/// O outbox do platform-api entrega **at-least-once**: um crash entre o publish e a
/// marcação republica a linha quando o lease expira. Sem esta tabela, um `store.created`
/// reentregue tentaria criar a organização de novo.
model ProcessedEvent {
  eventId     String   @id @map("event_id")
  type        String
  aggregateId String   @map("aggregate_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([aggregateId])
  @@map("processed_events")
  @@schema("clinica")
}

// --- WhatsApp (Baileys) ---

enum WhatsappConnectionStatus {
  disconnected
  qr_pending
  connected
  error

  @@schema("clinica")
}

enum WhatsappTemplateKey {
  appointment_confirmation
  mgm
  debit_overdue
  treatment_return
  birthday
  nps

  @@schema("clinica")
}

enum WhatsappMessageDirection {
  outbound
  inbound

  @@schema("clinica")
}

enum WhatsappMessageStatus {
  queued
  sent
  delivered
  failed
  received

  @@schema("clinica")
}

model WhatsappConnection {
  storeId      String                    @id @map("store_id")
  status       WhatsappConnectionStatus  @default(disconnected)
  phoneE164    String?                   @map("phone_e164") @db.VarChar(20)
  lastError    String?                   @map("last_error") @db.Text
  authStateKey String                    @default("") @map("auth_state_key") @db.VarChar(512)
  qrBase64     String?                   @map("qr_base64") @db.Text
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("whatsapp_connections")
  @@schema("clinica")
}

model WhatsappTemplate {
  id        String              @id @default(uuid())
  storeId   String              @map("store_id")
  key       WhatsappTemplateKey
  body      String              @db.Text
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([storeId, key])
  @@index([storeId])
  @@map("whatsapp_templates")
  @@schema("clinica")
}

model WhatsappMessage {
  id                String                   @id @default(uuid())
  storeId           String                   @map("store_id")
  patientId         String                   @map("patient_id")
  appointmentId     String?                  @map("appointment_id")
  direction         WhatsappMessageDirection
  body              String                   @db.Text
  toE164            String                   @map("to_e164") @db.VarChar(20)
  status            WhatsappMessageStatus    @default(queued)
  templateKey       WhatsappTemplateKey?     @map("template_key")
  providerMessageId String?                  @map("provider_message_id") @db.VarChar(128)
  correlationId     String?                  @map("correlation_id")
  expiresAt         DateTime?                @map("expires_at") @db.Timestamptz(3)
  attemptCount      Int                      @default(0) @map("attempt_count")
  lastError         String?                  @map("last_error") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([storeId, patientId, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt])
  @@index([storeId, correlationId])
  @@index([storeId, toE164, createdAt(sort: Desc)])
  @@map("whatsapp_messages")
  @@schema("clinica")
}
