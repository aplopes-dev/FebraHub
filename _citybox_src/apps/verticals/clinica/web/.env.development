PORT=3113

# Keycloak — realm PRÓPRIO da clínica (ADR C-16). Secret de dev do Keycloak local
# segue a convenção `<clientId>-dev-secret`.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-clinica
NEXT_PUBLIC_KEYCLOAK_CLIENT=clinica-web
KEYCLOAK_CLIENT_SECRET=clinica-web-dev-secret
KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8080/realms/citybox-clinica

# Origem deste app (redirect_uri OAuth e post_logout_redirect_uri)
NEXT_PUBLIC_BACKOFFICE_ORIGIN=http://127.0.0.1:3113

# Upstreams
CLINICA_API_URL=http://127.0.0.1:3172/api
