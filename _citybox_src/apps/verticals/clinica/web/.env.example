# Keycloak — realm PRÓPRIO da clínica (ADR C-16). NÃO há SSO com admin/ERP:
# são realms distintos, cada um com a sua sessão e a sua base de identidade.
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.citybox.com/realms/citybox-clinica
NEXT_PUBLIC_KEYCLOAK_CLIENT=clinica-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_INTERNAL_ISSUER=http://citybox_keycloak:8080/realms/citybox-clinica

# Origem deste app (redirect_uri OAuth e post_logout_redirect_uri).
# Precisa estar cadastrada como Valid Redirect URI do client `clinica-web`:
#   <origem>/auth/callback
NEXT_PUBLIC_BACKOFFICE_ORIGIN=https://clinica.citybox.com

# Upstreams
CLINICA_API_URL=https://api.citybox.com/clinica/api
