# Copie para platform-apps.env e ajuste (gitignored).
# Em staging/produção: AUTH_DEV_BYPASS=false
AUTH_DEV_BYPASS=false

# platform/api (ex admin-api)
PORT=3103
DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/citybox_platform?schema=platform
KEYCLOAK_ISSUER=https://auth.citybox.com/realms/citybox-dev
KEYCLOAK_ADMIN_CLIENT_ID=citybox-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=citybox-core-admin-dev-secret
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
REDIS_URL=redis://127.0.0.1:16379
CORS_ORIGINS=https://backoffice.citybox.com,https://admin.citybox.com,https://app.citybox.com,https://city.citybox.com

# platform/web (ex admin-web)
KEYCLOAK_ADMIN_WEB_SECRET=citybox-admin-dev-secret
KEYCLOAK_BACKOFFICE_SECRET=citybox-backoffice-dev-secret
KEYCLOAK_INVITE_REDIRECT_URI=https://backoffice.citybox.com/auth/sso
BACKOFFICE_ORIGIN=https://backoffice.citybox.com

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=citybox
MINIO_SECRET_KEY=citybox-minio-dev
MINIO_USERS_BUCKET=citybox-platform-users
SWAGGER_ENABLED=false

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@citybox.com
SMTP_PASS=
SMTP_FROM=contact@citybox.com
NOTIFY_EMAIL_TO=contact@citybox.com

PAYMENT_API_BASE_URL=http://127.0.0.1:3106/api
PAYMENT_API_KEY=dev-core-api-key
PAYMENTS_WEBHOOK_SECRET=dev-payments-webhook-secret-min-32-chars!!
PAYMENTS_DEFAULT_MERCHANT_ID=019aff00-0000-7000-8000-000000000002
PAYMENTS_PLATFORM_RECIPIENT_ID=019aff00-0000-7000-8000-000000000002
