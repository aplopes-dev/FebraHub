# fiscal-api (@citybox/fiscal-api) — container da stack citybox-platform.
# Copiado para .env automaticamente por infra/scripts/up.sh na primeira subida.
#
# Este arquivo configura o CONTAINER. Para rodar no host (pnpm --filter … dev),
# o arquivo é services/fiscal-api/.env — os dois são independentes.

FISCAL_API_PORT=3116

# Postgres — deve casar com infra/postgres/.env (POSTGRES_USER/POSTGRES_PASSWORD).
# O host é o nome do container na rede citybox-platform, não 127.0.0.1.
POSTGRES_USER=citybox
POSTGRES_PASSWORD=citybox
# Banco compartilhado com food/clinica; o fiscal-api usa o schema `fiscal`.
FISCAL_DB_NAME=citybox

# Auth (ADR C-16): a fiscal-api não tem realm próprio — valida tokens dos realms
# dos sistemas consumidores, em lista fechada. Hoje só o ERP consome.
KEYCLOAK_ALLOWED_ISSUERS=http://citybox_keycloak:8080/realms/citybox-erp
KEYCLOAK_ALLOWED_AZP=fiscal-m2m

# MinIO — deve casar com infra/minio/.env (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD).
# O bucket `fiscal` já é criado pelo init de infra/minio.
MINIO_ENDPOINT=citybox_minio:9000
MINIO_ACCESS_KEY=aplopes
MINIO_SECRET_KEY=citybox-minio-dev
MINIO_BUCKET=fiscal

# AES-256-GCM (32 bytes em base64) para a senha do certificado A1 em repouso.
# Valor abaixo é DEV-ONLY e versionado de propósito, para a stack subir usável.
# NUNCA usar em produção — gerar um por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FISCAL_CERT_ENCRYPTION_KEY=2EJ0td0IGpR/7BW1WEJHQ5+NtE/3qOT2H0Qs2BPS558=

# v1 só opera em homologação — deixar o endpoint de produção fora daqui é intencional.
SEFAZ_BA_NFE_HOMOLOGATION_ENDPOINT=https://hnfe.sefaz.ba.gov.br

# ─── Bypass de autenticacao para teste local ─────────────────────────────────
# Libera o token `Bearer dev-admin` no Swagger, sem precisar do Keycloak de pe.
# Exige AS DUAS: o AuthGuard checa `NODE_ENV !== 'production'` E o bypass.
#
# ⚠️ Somente em maquina de desenvolvimento. `dev-admin` entra como
# `platform_admin`, que passa por cima da checagem de acesso ao Emitente.
# FISCAL_NODE_ENV=development
# AUTH_DEV_BYPASS=true

# ─── Cupom fiscal — NFC-e, modelo 65 (spec 005) ──────────────────────────────
# URLs de consulta publica da SEFAZ-BA. SEM valor padrao: sem elas a emissao de
# cupom e recusada com 424. Sao DUAS, diferentes entre si — o XSD define
# `qrCode` e `urlChave` como elementos separados.
# NFCE_QRCODE_URL_BA_HOMOLOGATION=
# NFCE_CHAVE_URL_BA_HOMOLOGATION=

# Limite de valor sem consumidor identificado e prazo de contingencia. Ambos
# tem padrao no codigo (R$ 10.000 / 24h), mas os dois carecem de confirmacao
# junto a SEFAZ-BA antes de producao.
# NFCE_CONSUMER_LIMIT_BA=10000
# NFCE_CONTINGENCY_DEADLINE_HOURS=24

# Dreno automatico da fila de contingencia. So com UMA instancia da API.
# NFCE_CONTINGENCY_DRAIN=off
