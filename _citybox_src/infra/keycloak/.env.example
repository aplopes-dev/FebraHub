KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=citybox
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_PORT=8080

# Dev local (WSL) — URLs do realm apontam para localhost, não auth.citybox.com
KC_HOSTNAME=127.0.0.1
KC_HOSTNAME_URL=http://127.0.0.1:8080
KC_HOSTNAME_STRICT_HTTPS=false

# Produção/staging — descomente e remova as linhas acima
# KC_HOSTNAME=auth.citybox.com
# KC_HOSTNAME_URL=https://auth.citybox.com
# KC_HOSTNAME_STRICT_HTTPS=true
