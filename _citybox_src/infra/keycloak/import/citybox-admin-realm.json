{
  "realm": "citybox-admin",
  "displayName": "Citybox Admin",
  "enabled": true,
  "loginTheme": "citybox",
  "accountTheme": "citybox",
  "emailTheme": "citybox",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt"
  ],
  "defaultLocale": "pt",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "accessTokenLifespan": 900,
  "passwordPolicy": "length(14) and notUsername and notEmail and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Operação da plataforma Citybox — acesso total ao painel admin."
      },
      {
        "name": "platform_operator",
        "description": "Operação restrita do painel admin (sem gestão de usuários da plataforma)."
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-web",
      "name": "Citybox Admin — painel de operação",
      "description": "Equipe interna do Citybox. Sessão curta (15min idle) e MFA obrigatório: é o realm de maior privilégio.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3108/auth/callback",
        "http://localhost:3108/auth/callback",
        "https://admin.citybox.com/auth/callback",
        "https://admin.aplopes.com/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3108",
        "http://localhost:3108",
        "https://admin.citybox.com",
        "https://admin.aplopes.com"
      ],
      "attributes": {
        "use.refresh.tokens": "true"
      },
      "secretEnv": "KEYCLOAK_ADMIN_WEB_SECRET"
    },
    {
      "clientId": "admin-provisioning",
      "name": "Admin — service account de provisionamento",
      "description": "Usada pela admin-api para gerenciar usuários DA EQUIPE CITYBOX. manage-users LIMITADO a este realm — não alcança usuário de vertical nenhuma.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "serviceAccountClientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      },
      "secretEnv": "KEYCLOAK_ADMIN_PROVISIONING_SECRET"
    }
  ]
}
