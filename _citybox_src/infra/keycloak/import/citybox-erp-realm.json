{
  "realm": "citybox-erp",
  "displayName": "Citybox ERP",
  "enabled": true,
  "loginTheme": "citybox",
  "accountTheme": "citybox",
  "emailTheme": "citybox",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt"
  ],
  "defaultLocale": "pt",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 1800,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "platform.admin",
        "description": "Chamador de plataforma (admin-api via M2M). Atribuída EXCLUSIVAMENTE ao service account admin-m2m — nunca a usuário humano. Autorização de lojista vem do schema erp (Membership + PermissionProfile)."
      },
      {
        "name": "fiscal_operator",
        "description": "Opera a fiscal-api em nome do ERP. Atribuída EXCLUSIVAMENTE ao service account fiscal-m2m — a fiscal-api mapeia esta role para as permissões fiscais."
      }
    ]
  },
  "clients": [
    {
      "clientId": "erp-web",
      "name": "ERP — backoffice do lojista",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3107/auth/callback",
        "http://127.0.0.1:3107/auth/sso",
        "http://localhost:3107/auth/callback",
        "http://localhost:3107/auth/sso",
        "https://backoffice.citybox.com/auth/callback",
        "https://backoffice.citybox.com/auth/sso",
        "https://backoffice.aplopes.com/auth/callback",
        "https://backoffice.aplopes.com/auth/sso"
      ],
      "webOrigins": [
        "http://127.0.0.1:3107",
        "http://localhost:3107",
        "https://backoffice.citybox.com",
        "https://backoffice.aplopes.com"
      ],
      "attributes": {
        "use.refresh.tokens": "true"
      },
      "secretEnv": "KEYCLOAK_ERP_WEB_SECRET"
    },
    {
      "clientId": "erp-provisioning",
      "name": "ERP — service account de provisionamento",
      "description": "Usada pela erp-api para criar/gerenciar membros. manage-users LIMITADO a este realm.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "serviceAccountClientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      },
      "secretEnv": "KEYCLOAK_ERP_PROVISIONING_SECRET"
    },
    {
      "clientId": "admin-m2m",
      "name": "Citybox admin — chamador M2M",
      "description": "Credencial que o admin-api usa para chamar a erp-api. NÃO tem manage-users: só a role platform.admin, que a erp-api exige em @RequirePermission('platform.admin').",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "serviceAccountRealmRoles": [
        "platform.admin"
      ],
      "secretEnv": "KEYCLOAK_ERP_M2M_CLIENT_SECRET"
    },
    {
      "clientId": "fiscal-m2m",
      "name": "ERP — chamador M2M da fiscal-api",
      "description": "Credencial que a erp-api usa para chamar a services/fiscal-api. A fiscal-api nao tem realm proprio: ela confia no sistema chamador, que ja validou o vinculo usuario-loja antes de chamar.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "serviceAccountRealmRoles": [
        "fiscal_operator"
      ],
      "secretEnv": "KEYCLOAK_FISCAL_M2M_CLIENT_SECRET"
    }
  ]
}
