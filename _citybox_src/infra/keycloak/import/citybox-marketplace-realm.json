{
  "realm": "citybox-marketplace",
  "displayName": "Citybox",
  "enabled": true,
  "loginTheme": "citybox",
  "accountTheme": "citybox",
  "emailTheme": "citybox",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt"
  ],
  "defaultLocale": "pt",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 5184000,
  "accessTokenLifespan": 1800,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "consumer",
        "description": "Consumidor do marketplace (B2C). População inteiramente distinta dos realms de backoffice."
      }
    ]
  },
  "clients": [
    {
      "clientId": "marketplace-app",
      "name": "Citybox — app do consumidor",
      "description": "Client publico com PKCE. directAccessGrants HABILITADO: o marketplace-bff media o login do consumidor por Direct Access Grant (ADR C-07). Desabilitar quebra POST /auth/login com 400 unauthorized_client.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3000/auth/callback",
        "http://localhost:3000/auth/callback",
        "https://app.citybox.com/auth/callback",
        "citybox://auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000",
        "https://app.citybox.com"
      ],
      "attributes": {
        "use.refresh.tokens": "true",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "marketplace-provisioning",
      "name": "Marketplace — service account de provisionamento",
      "description": "Usada pelo marketplace-bff/api para criar contas de consumidor. manage-users LIMITADO a este realm.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "serviceAccountClientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      },
      "secretEnv": "KEYCLOAK_MARKETPLACE_PROVISIONING_SECRET"
    }
  ]
}
