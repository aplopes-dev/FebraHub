{
  "name": "@citybox/keycloak-theme",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-keycloak-theme": "vite build && keycloakify build",
    "preview": "vite preview",
    "test:keycloak": "keycloakify start-keycloak --port 8081 --keycloak-version 26.6.0 --import ./preview-realm.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@citybox/mui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "keycloakify": "^11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
