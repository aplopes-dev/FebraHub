# ============================================================
# CITYBOX — Dev local (Opção A)
# Postgres, Keycloak, Redis, RabbitMQ, Typesense, MinIO: Docker
# Acesso direto por localhost — sem /etc/hosts nem nginx local
# ============================================================

# ─── Banco de dados (LOCAL — Docker :15433) ───
PLATFORM_DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/citybox_platform
TENANT_DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15433/ilheus_dev

# ─── Keycloak (LOCAL — Docker :8080) ───
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/citybox-dev
KEYCLOAK_ADMIN_CLIENT_ID=citybox-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=citybox-core-admin-dev-secret
KEYCLOAK_ADMIN_WEB_SECRET=citybox-admin-dev-secret
KEYCLOAK_BACKOFFICE_SECRET=citybox-backoffice-dev-secret
KEYCLOAK_INVITE_REDIRECT_URI=http://127.0.0.1:3107/auth/sso
BACKOFFICE_ORIGIN=http://127.0.0.1:3107

# ─── APIs locais (ERP / admin-web) ───
CORE_API_URL=http://127.0.0.1:3101/api
FOOD_API_URL=http://127.0.0.1:3171/api
ADMIN_API_URL=http://127.0.0.1:3103/api

# ─── RabbitMQ (LOCAL — Docker) ───
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox

# ─── Redis (LOCAL — Docker; infra/redis/.env usa REDIS_PORT=16379) ───
REDIS_URL=redis://127.0.0.1:16379

# ─── Typesense (LOCAL — Docker) ───
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=citybox-dev-typesense-key

# ─── MinIO (LOCAL — Docker) ───
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=citybox
MINIO_SECRET_KEY=citybox-minio-dev
MINIO_USERS_BUCKET=citybox-platform-users
MINIO_USE_SSL=false

# ─── Auth ───
AUTH_DEV_BYPASS=false
# Para testar sem token: AUTH_DEV_BYPASS=true (nunca em prod)

# ─── CORS (dev local — só localhost) ───
CORS_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3107,http://localhost:3108,http://localhost:3170,http://127.0.0.1:3101,http://127.0.0.1:3102,http://127.0.0.1:3103,http://127.0.0.1:3107,http://127.0.0.1:3108,http://127.0.0.1:3170

# ─── Swagger ───
SWAGGER_ENABLED=true

# ─── Rate limit ───
PROFILE_RATE_LIMIT_MAX=100
PROFILE_RATE_LIMIT_WINDOW_MS=900000

# ─── Payment API ───
PAYMENT_API_BASE_URL=http://127.0.0.1:3106/api
PAYMENT_API_KEY=dev-core-api-key
PAYMENTS_DEFAULT_MERCHANT_ID=019aff00-0000-7000-8000-000000000002
PAYMENTS_PLATFORM_RECIPIENT_ID=019aff00-0000-7000-8000-000000000002
PAYMENTS_WEBHOOK_SECRET=dev-payments-webhook-secret-min-32-chars!!

# ─── SMTP (opcional — convites Keycloak; deixe vazio se não for testar e-mail) ───
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=Citybox
# NOTIFY_EMAIL_TO=