                    "type": "string",
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "currentPassword": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
