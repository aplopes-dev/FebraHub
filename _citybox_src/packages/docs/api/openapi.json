    "/api/v1/orders/{orderId}/checkout": {
      "post": {
        "operationId": "PaymentsController_checkoutOrder",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "customer",
                  "paymentMethods"
                ],
                "properties": {
                  "customer": {
                    "type": "object",
                    "required": [
                      "name",
                      "cpfCnpj"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "example": "Maria Silva"
                      },
                      "cpfCnpj": {
                        "type": "string",
                        "example": "12345678901"
                      },
                      "email": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      }
                    }
                  },
                  "paymentMethods": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "PIX"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "storeSharePercent": {
                    "type": "number",
                    "example": 95
                  },
                  "provider": {
                    "type": "string"
                  },
                  "routingStrategy": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string"
                    },
                    "charges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "subOrderId": {
                            "type": "string"
                          },
                          "storeId": {
                            "type": "string"
                          },
                          "externalReference": {
                            "type": "string"
                          },
                          "charge": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "orders"
        ]
      }
    }
