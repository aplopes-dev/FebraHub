    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "amqplib": "^0.10.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.10.0",
    "typescript": "~6.0.3"
