PORT=3106
NODE_ENV=development

DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15435/citybox_payments
REDIS_URL=redis://127.0.0.1:16379
RABBITMQ_URL=amqp://citybox:citybox@127.0.0.1:5672/citybox
RABBITMQ_EXCHANGE=citybox.events
RABBITMQ_DLX=citybox.dlx

PAYMENTS_ENCRYPTION_KEY=dev-32-byte-key-change-in-prod!!
# Opcional dev (substituem defaults em código)
PAYMENTS_DEV_ENCRYPTION_KEY=dev-32-byte-key-change-in-prod!!
PAYMENTS_DEV_CORE_API_KEY=dev-core-api-key
PAYMENTS_DEV_ADMIN_API_KEY=dev-admin-key
PAYMENTS_API_CLIENTS={"core-api":{"key":"dev-core-api-key","tenantId":"019aff00-0000-7000-8000-000000000001"},"admin":{"key":"dev-admin-key","tenantId":"019aff00-0000-7000-8000-000000000001","admin":true}}
PAYMENTS_DEFAULT_TENANT_ID=019aff00-0000-7000-8000-000000000001
PAYMENTS_JWT_SECRET=dev-jwt-secret

CORS_ORIGINS=http://localhost:3101,http://127.0.0.1:3101,http://localhost:3107,http://127.0.0.1:3107
SWAGGER_ENABLED=true

ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token configurado no painel Asaas → Webhooks (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

PAGBANK_ENV=sandbox
# Token Bearer sandbox — mesmo padrão do citybox-food (Pagamentos → Configuração)
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_TOKEN=

INFINITEPAY_HANDLE=
INFINITEPAY_ENV=sandbox
INFINITEPAY_WEBHOOK_TOKEN=
INFINITEPAY_WEBHOOK_URL=
INFINITEPAY_REDIRECT_URL=
# PAYMENTS_FEATURE_INFINITEPAY=true
# UNLEASH_URL=http://127.0.0.1:4242/api
# UNLEASH_API_TOKEN=
# UNLEASH_APP_NAME=payment-api

STONE_API_KEY=
STONE_ENV=sandbox
STONE_BUSINESS_MODEL=subacquirer
STONE_WEBHOOK_TOKEN=
STONE_OPENBANK_ACCOUNT_ID=
# PAYMENTS_FEATURE_STONE=true

PAYMENTS_DEFAULT_FEE_PERCENT=2.99
PAYMENTS_DEFAULT_FEE_FIXED=0
PAYMENTS_SETTLEMENT_DAYS_PIX=1
PAYMENTS_SETTLEMENT_DAYS_BOLETO=2
PAYMENTS_SETTLEMENT_DAYS_CARD=30

# Webhook interno → core-api (mesmo valor em PAYMENTS_WEBHOOK_SECRET no core-api)
PAYMENTS_WEBHOOK_SECRET=dev-payments-webhook-secret-min-32-chars!!
PAYMENTS_WEBHOOK_MAX_ATTEMPTS=3
PAYMENTS_SETTLEMENT_BATCH_SIZE=10
PAYMENTS_RATE_LIMIT_MAX=120
PAYMENTS_PUBLIC_RATE_LIMIT_MAX=30
PAYMENTS_RATE_LIMIT_WINDOW_SEC=60
# PAYMENTS_WEBHOOK_DLQ_PUBLISH=false
# Docker (rede citybox-platform): citybox_core_api | host local: http://127.0.0.1:3101/...
CORE_API_INTERNAL_WEBHOOK_URL=http://citybox_core_api:3101/api/v1/internal/payments/webhooks
# Definido pelo docker-compose. NÃO descomentar em dev local fora do Docker.
# PAYMENT_API_IN_DOCKER=true
# PAYMENT_API_DOCKER_ALLOWED_HOSTS=citybox_core_api

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=citybox
MINIO_SECRET_KEY=citybox-minio-dev
