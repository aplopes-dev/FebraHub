{
  "name": "@citybox/payment-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 70 --statements 80 --include 'src/common/**' --include 'src/modules/auth/**' --include 'src/modules/charges/**' --include 'src/modules/providers/**' --exclude '**/*.d.ts' --exclude 'src/generated/**' node --import tsx --test test/**/*.test.ts",
    "db:generate": "DATABASE_URL=postgresql://citybox:citybox@127.0.0.1:15435/citybox_payments prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "jobs:daily-settlement": "tsx src/jobs/daily-settlement.job.ts"
  },
  "dependencies": {
    "@citybox/messaging": "workspace:*",

    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "pg": "^8.16.0",
    "ioredis": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "c8": "^10.1.3",
    "prisma": "7.8.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  }
}
