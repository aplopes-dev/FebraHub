# Copie para services/platform-apps.env (gitignored) — produção aplopes.com
# Banco único: citybox — cada API usa ?schema= (platform, erp, clinica, imoveis, …)

AUTH_DEV_BYPASS=false

# ─── Banco único citybox ─────────────────────────────────────────────────────
CITYBOX_DATABASE_NAME=citybox
CITYBOX_DATABASE_USER=aplopes
CITYBOX_DATABASE_PASSWORD=aplopes
CITYBOX_DATABASE_HOST_DOCKER=aplopes_postgres
CITYBOX_DATABASE_PORT_DOCKER=5432
CITYBOX_DATABASE_HOST=127.0.0.1
CITYBOX_DATABASE_PORT=15433

# Migrations no host (deploy script)
PLATFORM_DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=platform
CLINICA_DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=clinica
ERP_DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=erp
IMOVEIS_DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=imoveis
BEAUTIFUL_DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=beautiful
FISCAL_DATABASE_URL=postgresql://aplopes:aplopes@127.0.0.1:15433/citybox?schema=fiscal

# Runtime Docker (hostname interno na rede aplopes-platform)
PLATFORM_DATABASE_URL_DOCKER=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=platform
CLINICA_DATABASE_URL_DOCKER=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=clinica
ERP_DATABASE_URL_DOCKER=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=erp
IMOVEIS_DATABASE_URL_DOCKER=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=imoveis
BEAUTIFUL_DATABASE_URL_DOCKER=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=beautiful
FISCAL_DATABASE_URL_DOCKER=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=fiscal

# platform-api (alias — compose injeta DATABASE_URL a partir de PLATFORM_DATABASE_URL_DOCKER)
DATABASE_URL=postgresql://aplopes:aplopes@aplopes_postgres:5432/citybox?schema=platform

# ─── Keycloak — um realm por sistema (ADR C-16/C-17) ────────────────────────
KEYCLOAK_BASE_URL=https://auth.aplopes.com
# Lista explícita — sem isso o sync também recria o legado citybox-dev.
KEYCLOAK_REALMS=citybox-admin,citybox-erp,citybox-clinica,citybox-beautiful,citybox-imoveis,citybox-marketplace
KEYCLOAK_ADMIN_ISSUER=https://auth.aplopes.com/realms/citybox-admin
KEYCLOAK_ERP_ISSUER=https://auth.aplopes.com/realms/citybox-erp
KEYCLOAK_CLINICA_ISSUER=https://auth.aplopes.com/realms/citybox-clinica
KEYCLOAK_BEAUTIFUL_ISSUER=https://auth.aplopes.com/realms/citybox-beautiful
KEYCLOAK_IMOVEIS_ISSUER=https://auth.aplopes.com/realms/citybox-imoveis
KEYCLOAK_MARKETPLACE_ISSUER=https://auth.aplopes.com/realms/citybox-marketplace

# Gere valores aleatórios independentes (ex.: openssl rand -base64 48).
# Não reutilize secrets entre realms nem mantenha os placeholders em produção.
KEYCLOAK_ADMIN_WEB_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PROVISIONING_SECRET=CHANGE_ME
KEYCLOAK_ERP_WEB_SECRET=CHANGE_ME
KEYCLOAK_ERP_PROVISIONING_SECRET=CHANGE_ME
KEYCLOAK_ERP_M2M_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_FISCAL_M2M_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_CLINICA_WEB_SECRET=CHANGE_ME
KEYCLOAK_CLINICA_PROVISIONING_SECRET=CHANGE_ME
KEYCLOAK_CLINICA_M2M_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_BEAUTIFUL_WEB_SECRET=CHANGE_ME
KEYCLOAK_BEAUTIFUL_PROVISIONING_SECRET=CHANGE_ME
KEYCLOAK_BEAUTIFUL_M2M_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_IMOVEIS_WEB_SECRET=CHANGE_ME
KEYCLOAK_IMOVEIS_PROVISIONING_SECRET=CHANGE_ME
KEYCLOAK_IMOVEIS_M2M_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_MARKETPLACE_PROVISIONING_SECRET=CHANGE_ME

# ─── admin-api ───────────────────────────────────────────────────────────────
PORT=3103
RABBITMQ_URL=amqp://citybox:citybox@aplopes_rabbitmq:5672/citybox
REDIS_URL=redis://aplopes_redis:6379
CORS_ORIGINS=https://admin.aplopes.com,https://backoffice.aplopes.com,https://clinica.aplopes.com,https://imoveis.aplopes.com
# Worker clinica-api → platform-api (reforço seed equipe demo). Compose já defaulta o hostname interno.
PLATFORM_API_URL=http://aplopes_admin_api:3103

# Origens públicas usadas nos redirects OAuth e no sync dos realms
BACKOFFICE_ORIGIN=https://backoffice.aplopes.com
ADMIN_ORIGIN=https://admin.aplopes.com
CLINICA_ORIGIN=https://clinica.aplopes.com
BEAUTIFUL_ORIGIN=https://salao.aplopes.com
IMOVEIS_ORIGIN=https://imoveis.aplopes.com
MARKETPLACE_ORIGIN=https://citybox.com.br
KEYCLOAK_SEED_USER_PASSWORD=aplopes
KEYCLOAK_INVITE_REDIRECT_URI=https://admin.aplopes.com/auth/callback

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aplopes
MINIO_SECRET_KEY=aplopes-minio-dev
MINIO_USERS_BUCKET=aplopes-platform-users

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@aplopes.com
SMTP_PASS=
SMTP_FROM=contact@aplopes.com
NOTIFY_EMAIL_TO=contact@aplopes.com

PAYMENT_API_BASE_URL=http://payment_api:3106/api
PAYMENT_API_KEY=dev-core-api-key
PAYMENTS_WEBHOOK_SECRET=dev-payments-webhook-secret-min-32-chars!!
PAYMENTS_DEFAULT_MERCHANT_ID=019aff00-0000-7000-8000-000000000002
PAYMENTS_PLATFORM_RECIPIENT_ID=019aff00-0000-7000-8000-000000000002

# Typesense
TYPESENSE_API_KEY=aplopes-dev-typesense-key

# ─── Asaas (payment gateway — platform-api) ─────────────────────────────────
# Chaves Asaas com $ no início: no .env real use $$ (Docker) ou aspas simples (shell).
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ─── Imóveis (imoveis-api :3112 + imoveis-web :3111) ─────────────────────────
IMOVEIS_MINIO_BUCKET=citybox-imoveis
IMOVEIS_WEB_URL=https://imoveis.aplopes.com
NEXT_PUBLIC_IMOVEIS_API_URL=https://imoveis.aplopes.com/api
# Store id da loja Imóveis (catálogo público `/agents/:slug` e rotas /v1/public/stores/:storeId/…)
# Sem isso o web cai no fallback `dev-store-imoveis` e o catálogo responde 404 em produção.
IMOVEIS_STORE_ID=
NEXT_PUBLIC_IMOVEIS_STORE_ID=
# Hostname = container_name do apps/imoveis/infra (imoveis_api), não o service name
IMOVEIS_API_URL=http://imoveis_api:3112
