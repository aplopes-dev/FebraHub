// --------------------------------------------------------------------
// EVENTOS
// Eventos — pedidos e participantes do Sympla.
// --------------------------------------------------------------------

/// Pedido do Sympla. valorTotal e bruto; valorLiquido ja desconta os ~11,5%
/// da plataforma. Receita de evento nao entra na mesma conta que receita de
/// curso: R$ 46 e R$ 6.138 somados nao significam nada.
model FatoPedido {
  pedidoId               String    @id @map("pedido_id")
  eventoId               String?   @map("evento_id")
  statusPedido           String?   @map("status_pedido")
  dataPedido             DateTime? @map("data_pedido") @db.Timestamp(6)
  dataAtualizacaoPedido  DateTime? @map("data_atualizacao_pedido") @db.Timestamp(6)
  dataAprovacaoPedido    DateTime? @map("data_aprovacao_pedido") @db.Timestamp(6)
  valorTotal             Decimal?  @map("valor_total") @db.Decimal
  moeda                  String?
  compradorNome          String?   @map("comprador_nome")
  compradorEmail         String?   @map("comprador_email")
  dataPedidoDia          DateTime? @map("data_pedido_dia") @db.Date
  compradorSobrenome     String?   @map("comprador_sobrenome")
  valorLiquido           Decimal?  @map("valor_liquido") @db.Decimal
  formaPagamento         String?   @map("forma_pagamento")
  compradorDocumento     String?   @map("comprador_documento")
  compradorDocumentoTipo String?   @map("comprador_documento_tipo")
  utmSource              String?   @map("utm_source")
  utmMedium              String?   @map("utm_medium")
  utmCampaign            String?   @map("utm_campaign")
  taxaPlataforma         Decimal?  @map("taxa_plataforma") @db.Decimal
  docNorm                String?   @map("doc_norm")
  emailCompradorNorm     String?   @map("email_comprador_norm")

  @@map("fato_pedidos")
}

/// Ingresso. Evento nao e topo de funil: dos alunos que foram a evento, 68%
/// ja eram alunos. A conversao real evento -> curso e 2,9%, em 61 dias
/// (docs/DESCOBERTAS.md §2).
model FatoParticipante {
  participanteId        String    @id @map("participante_id")
  eventoId              String?   @map("evento_id")
  pedidoId              String?   @map("pedido_id")
  statusPedido          String?   @map("status_pedido")
  dataPedido            DateTime? @map("data_pedido") @db.Timestamp(6)
  dataAtualizacaoPedido DateTime? @map("data_atualizacao_pedido") @db.Timestamp(6)
  dataAprovacaoPedido   DateTime? @map("data_aprovacao_pedido") @db.Timestamp(6)
  nomeParticipante      String?   @map("nome_participante")
  emailParticipante     String?   @map("email_participante")
  numeroIngresso        String?   @map("numero_ingresso")
  qrCodeIngresso        String?   @map("qr_code_ingresso")
  tipoIngresso          String?   @map("tipo_ingresso")
  valorIngresso         Decimal?  @map("valor_ingresso") @db.Decimal
  dataPedidoDia         DateTime? @map("data_pedido_dia") @db.Date
  emailNorm             String?   @map("email_norm")
  checkIn               Boolean?  @map("check_in")
  desconto              Decimal?  @db.Decimal

  @@map("fato_participantes")
}

model FatoAvaliacaoEvento {
