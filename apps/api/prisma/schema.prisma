  fonte        String?
  dataVenda    DateTime? @map("data_venda") @db.Date
  mesRef       DateTime? @map("mes_ref") @db.Date
  descricao    String?
  formaPagto   String?   @map("forma_pagto")
  valor        Decimal?  @db.Decimal
  quantidade   Decimal?  @db.Decimal
  cliente      String?
  documento    String?
