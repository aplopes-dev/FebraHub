/// Turno de caixa (abrir -> vendas/sangrias -> fechar).
model PdvCaixaSessao {
  id             String   @id @default(uuid()) @db.Uuid
  terminalId     String   @map("terminal_id") @db.Uuid
  situacao       String   @default("aberto") // aberto | fechado
  abertoEm       DateTime @default(now()) @map("aberto_em") @db.Timestamptz(6)
  fechadoEm      DateTime? @map("fechado_em") @db.Timestamptz(6)
  abertoPorId    String   @map("aberto_por_id") @db.Uuid
  abertoPorNome  String   @map("aberto_por_nome")
  fundoAbertura  Decimal  @default(0) @map("fundo_abertura") @db.Decimal(14, 2)
  contadoDinheiro Decimal? @map("contado_dinheiro") @db.Decimal(14, 2)
  esperadoDinheiro Decimal? @map("esperado_dinheiro") @db.Decimal(14, 2)
  diferenca      Decimal? @db.Decimal(14, 2)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  terminal       PdvTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  movimentos     PdvCaixaMovimento[]
  vendas         PdvVenda[]
  @@index([situacao, abertoEm(sort: Desc)])
  @@index([terminalId, situacao])
  @@map("pdv_caixa_sessoes")
}

/// Sangria (retirada) ou reforço (aporte) de caixa.
model PdvCaixaMovimento {
