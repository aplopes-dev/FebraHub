// --------------------------------------------------------------------
// OPERACAO
// Operacao — estado das integracoes.
// --------------------------------------------------------------------

model IntegracaoStatus {
  fonte           String    @id
  nomeExibicao    String?   @map("nome_exibicao")
  ultimaSync      DateTime? @map("ultima_sync") @db.Timestamptz(6)
  registros       Int?
  status          String?
  mensagem        String?
  duracaoSegundos Decimal?  @map("duracao_segundos") @db.Decimal
  atualizadoEm    DateTime? @map("atualizado_em") @db.Timestamptz(6)

  @@map("integracao_status")
}

/// Token de OAuth das integracoes, em claro. Divida conhecida: o valor certo
/// e cifrar em repouso com chave fora do banco. Enquanto nao for, esta
/// tabela nao pode aparecer em dump compartilhado nem em log.
model IntegracaoToken {
  integracao   String    @id
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiraEm     DateTime? @map("expira_em") @db.Timestamptz(6)
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamptz(6)

  @@map("integracao_tokens")
}

/// Parametro `state` do OAuth2, de uso unico e validade curta (15 min).
/// Existe porque o callback e PUBLICO — quem o chama e o navegador
/// redirecionado pelo provedor, entao nao ha sessao para conferir. Sem o
/// state, qualquer um poderia chamar o callback com um `code` proprio e
/// plantar a conta dele como integracao da Febracis.
model IntegracaoEstadoOauth {
  state    String   @id
  fonte    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([criadoEm], map: "ix_integracao_estado_oauth_criado_em")
  @@map("integracao_estado_oauth")
}

// --------------------------------------------------------------------
// CRM — nucleo (Fase 2/Etapa 1; docs/INTEGRACAO_HUB_CRM.md)
// Porte funcional do crm-aplopes achatado para tenant unico: sem
// organizationId/memberships — o recorte e o setor 'crm'. Nasceu VAZIO
// (decisao de 02/08/2026: as carteiras da origem sao de outras empresas),
// por isso segue a convencao pt-BR da casa. Referencias de usuario sao
// uuid soltos, como nas demais tabelas de negocio. Dinheiro em centavos.
// --------------------------------------------------------------------

model CrmCliente {
  id            String    @id @default(uuid()) @db.Uuid
  nome          String
  /// 'pj' | 'pf'
  tipoPessoa    String    @default("pj") @map("tipo_pessoa") @db.VarChar(2)
  /// lead | oportunidade | cliente_ativo | inativo | perdido — "Leads" e
  /// este cadastro filtrado por estagio, como na origem.
  estagio       String    @default("lead")
  documento     String?
  segmento      String?
  origem        String?
  telefone      String?
  email         String?
  site          String?
  instagram     String?
  cidade        String?
  observacao    String?
  responsavelId String?   @map("responsavel_id") @db.Uuid
  criadoPor     String?   @map("criado_por") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  contatos   CrmClienteContato[]
  atividades CrmClienteAtividade[]
  negocios   CrmNegocio[]
  tarefas    CrmTarefa[]
  conversasWa WaConversa[]

  /// Relações do módulo Comercial (Pessoa Única — PRD §3)
  oportunidades    ComOportunidade[]
  vendasComprador  ComVenda[] @relation("VendasComprador")
  vendasBeneficiario ComVenda[] @relation("VendasBeneficiario")
  leadsOrigem      ComLeadOrigem[]

  /// Integração Sympla
  sympla_orders        SymplaOrder[]
  sympla_participantes SymplaParticipante[]

  @@index([estagio])
  @@index([nome])
  @@index([responsavelId])
  @@map("crm_clientes")
}

model CrmClienteContato {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  cliente   CrmCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  cargo     String?
  email     String?
  telefone  String?
  principal Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  negocios CrmNegocio[]

  @@index([clienteId])
  @@map("crm_cliente_contatos")
}

model CrmClienteAtividade {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  cliente   CrmCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  texto     String
  autorId   String?  @map("autor_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([clienteId, criadoEm])
  @@map("crm_cliente_atividades")
}

model CrmFunil {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String
  cor      String?
  status   String   @default("ativo")
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  etapas   CrmEtapa[]
  negocios CrmNegocio[]

  @@map("crm_funis")
}

model CrmEtapa {
  id            String   @id @default(uuid()) @db.Uuid
  funilId       String   @map("funil_id") @db.Uuid
  funil         CrmFunil @relation(fields: [funilId], references: [id], onDelete: Cascade)
  nome          String
  cor           String?
  probabilidade Int      @default(0)
  /// aberta | ganha | perdida — mover para ganha/perdida fecha o negocio.
  tipo          String   @default("aberta")
  ordem         Int      @default(0)
  sistema       Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  negocios CrmNegocio[]

  @@index([funilId, ordem])
  @@map("crm_etapas")
}

model CrmNegocio {
  id                String    @id @default(uuid()) @db.Uuid
  funilId           String    @map("funil_id") @db.Uuid
  funil             CrmFunil  @relation(fields: [funilId], references: [id])
  etapaId           String    @map("etapa_id") @db.Uuid
  etapa             CrmEtapa  @relation(fields: [etapaId], references: [id])
  clienteId         String    @map("cliente_id") @db.Uuid
  cliente           CrmCliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  contatoId         String?   @map("contato_id") @db.Uuid
  contato           CrmClienteContato? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  titulo            String
  valorCentavos     BigInt    @default(0) @map("valor_centavos")
  responsavelId     String?   @map("responsavel_id") @db.Uuid
  motivoPerda       String?   @map("motivo_perda")
  ultimaAtividadeEm DateTime? @map("ultima_atividade_em") @db.Timestamptz(6)
  fechadoEm         DateTime? @map("fechado_em") @db.Timestamptz(6)
  criadoPor         String?   @map("criado_por") @db.Uuid
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  atividades CrmNegocioAtividade[]
  tarefas    CrmTarefa[]

  @@index([funilId, etapaId])
  @@index([clienteId])
  @@index([responsavelId])
  @@map("crm_negocios")
}

model CrmNegocioAtividade {
  id        String     @id @default(uuid()) @db.Uuid
  negocioId String     @map("negocio_id") @db.Uuid
  negocio   CrmNegocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tipo      String     @default("nota")
  texto     String
  autorId   String?    @map("autor_id") @db.Uuid
  criadoEm  DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([negocioId, criadoEm])
  @@map("crm_negocio_atividades")
}

model CrmTarefa {
  id            String      @id @default(uuid()) @db.Uuid
  /// Vinculo opcional dos dois lados — melhoria sobre a origem (la, so negocio).
  negocioId     String?     @map("negocio_id") @db.Uuid
  negocio       CrmNegocio? @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  clienteId     String?     @map("cliente_id") @db.Uuid
  cliente       CrmCliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  titulo        String
  tipo          String      @default("follow_up")
  prioridade    String      @default("media")
  venceEm       DateTime?   @map("vence_em") @db.Timestamptz(6)
  concluidaEm   DateTime?   @map("concluida_em") @db.Timestamptz(6)
  resultado     String?
  responsavelId String?     @map("responsavel_id") @db.Uuid
  criadoPor     String?     @map("criado_por") @db.Uuid
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([concluidaEm, venceEm])
  @@index([negocioId])
  @@index([clienteId])
  @@map("crm_tarefas")
}

// --------------------------------------------------------------------
// WHATSAPP (Fase 2/Etapa 2) — conexao unica (Baileys no processo da API,
// como a origem roda em producao; sessao em volume), conversas por telefone
// e mensagens com midia no MinIO.
// --------------------------------------------------------------------

model WaConexao {
  id             Int       @id @default(1)
  status         String    @default("desconectado")
  telefone       String?
  nomeExibicao   String?   @map("nome_exibicao")
  qrCode         String?   @map("qr_code")
  qrGeradoEm     DateTime? @map("qr_gerado_em") @db.Timestamptz(6)
  conectadoEm    DateTime? @map("conectado_em") @db.Timestamptz(6)
  desconectadoEm DateTime? @map("desconectado_em") @db.Timestamptz(6)
  ultimoErro     String?   @map("ultimo_erro")
  atualizadoEm   DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@map("wa_conexao")
}

model WaConversa {
  id           String    @id @default(uuid()) @db.Uuid
  tipo         String    @default("direta")
  /// Telefone normalizado (so digitos) — a chave natural da conversa direta.
  telefone     String    @unique
  jid          String?
  nomeContato  String?   @map("nome_contato")
  crmClienteId String?   @map("crm_cliente_id") @db.Uuid
  crmCliente   CrmCliente? @relation(fields: [crmClienteId], references: [id], onDelete: SetNull)
  atribuidaA   String?   @map("atribuida_a") @db.Uuid
  /// Nome denormalizado do responsavel — a lista mostra sem join.
  atribuidaNome String?  @map("atribuida_nome")
  status       String    @default("aberta")
  naoLidas     Int       @default(0) @map("nao_lidas")
  ultimaMsg    String?   @map("ultima_msg")
  ultimaMsgEm  DateTime? @map("ultima_msg_em") @db.Timestamptz(6)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  excluidaEm   DateTime? @map("excluida_em") @db.Timestamptz(6)

  mensagens WaMensagem[]

  @@index([ultimaMsgEm(sort: Desc)])
  @@index([crmClienteId])
  @@map("wa_conversas")
}

model WaMensagem {
  id                String     @id @default(uuid()) @db.Uuid
  conversaId        String     @map("conversa_id") @db.Uuid
  conversa          WaConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  direcao           String
  tipoRemetente     String     @default("contato") @map("tipo_remetente")
  operadorId        String?    @map("operador_id") @db.Uuid
  tipoConteudo      String     @default("texto") @map("tipo_conteudo")
  texto             String?
  midiaChave        String?    @map("midia_chave")
  midiaNome         String?    @map("midia_nome")
  midiaMime         String?    @map("midia_mime")
  midiaTamanho      Int?       @map("midia_tamanho")
  midiaNotaVoz      Boolean    @default(false) @map("midia_nota_voz")
  /// key.id do Baileys — chave da deduplicacao (unique parcial na migration).
  providerMessageId String?    @map("provider_message_id")
  /// Citacao (responder mensagem): id remoto + trecho + de quem era a
  /// original — o suficiente para renderizar e rolar ate ela se existir.
  citacaoProviderId String?    @map("citacao_provider_id")
  citacaoTexto      String?    @map("citacao_texto")
  citacaoDeMim      Boolean?   @map("citacao_de_mim")
  remoteJid         String?    @map("remote_jid")
  deMim             Boolean    @default(false) @map("de_mim")
  status            String     @default("enviada")
  erro              String?
  criadoEm          DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([conversaId, criadoEm])
  @@map("wa_mensagens")
}

// --------------------------------------------------------------------
// AGENTES DE IA (Fase 2/Etapa 3) — ponte com a plataforma Aplopes AI.
// O motor e EXTERNO; tokens cifrados AES-256-GCM (chave em env).
// --------------------------------------------------------------------

model AgentesConexao {
  id                   Int       @id @default(1)
  workspaceId          String?   @map("workspace_id")
  workspaceNome        String?   @map("workspace_nome")
  baseUrl              String?   @map("base_url")
  tokenCifrado         String?   @map("token_cifrado")
  webhookSecretCifrado String?   @map("webhook_secret_cifrado")
  agentePadraoId       String?   @map("agente_padrao_id")
  agentePadraoNome     String?   @map("agente_padrao_nome")
  status               String    @default("desconectado")
  /// sha256 do token fhk_live_ que o admin cola no Aplopes; o claro nao fica.
  tokenConexaoHash     String?   @map("token_conexao_hash")
  tokenGeradoEm        DateTime? @map("token_gerado_em") @db.Timestamptz(6)
  pareadoEm            DateTime? @map("pareado_em") @db.Timestamptz(6)
  sincronizadoEm       DateTime? @map("sincronizado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@map("agentes_conexao")
}

model AgentesConversa {
  id               String    @id @default(uuid()) @db.Uuid
  refExterna       String    @unique @map("ref_externa")
  issueRemotaId    String?   @map("issue_remota_id")
  conversaRemotaId String?   @map("conversa_remota_id")
  titulo           String
  status           String    @default("BACKLOG")
  agenteId         String?   @map("agente_id")
  agenteNome       String?   @map("agente_nome")
  solicitanteId    String?   @map("solicitante_id") @db.Uuid
  solicitanteNome  String?   @map("solicitante_nome")
  temPendente      Boolean   @default(false) @map("tem_pendente")
  /// Organizacao LOCAL do atendimento (a plataforma remota nao tem esses
  /// campos): prioridade baixa|normal|alta|urgente, etiquetas livres e o
  /// usuario do FebraHub responsavel pelo acompanhamento.
  prioridade       String    @default("normal")
  etiquetas        String[]  @default([])
  responsavelId    String?   @map("responsavel_id") @db.Uuid
  responsavelNome  String?   @map("responsavel_nome")
  crmClienteId     String?   @map("crm_cliente_id") @db.Uuid
  /// Rota do FebraHub de onde a conversa nasceu (contexto do widget).
  origemContexto   String?   @map("origem_contexto")
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  sincronizadoEm   DateTime? @map("sincronizado_em") @db.Timestamptz(6)

  mensagens AgentesMensagem[]

  @@index([atualizadoEm(sort: Desc)])
  @@index([status])
  @@index([responsavelId])
  @@map("agentes_conversas")
}

model AgentesMensagem {
  id         String          @id @default(uuid()) @db.Uuid
  conversaId String          @map("conversa_id") @db.Uuid
  conversa   AgentesConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor      String
  conteudo   String
  agenteId   String?         @map("agente_id")
  agenteNome String?         @map("agente_nome")
  remotoId   String?         @map("remoto_id")
  /// Metadados dos anexos [{artifactId, filename, contentType, size}] — o
  /// binario vive no Aplopes; o download e proxy autenticado pela API.
  anexosJson String?         @map("anexos_json")
  lida       Boolean         @default(false)
  criadoEm   DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([conversaId, criadoEm])
  @@map("agentes_mensagens")
}

model AgentesEvento {
  id             String   @id @default(uuid()) @db.Uuid
  eventoRemotoId String   @unique @map("evento_remoto_id")
  tipo           String
  processadoEm   DateTime @default(now()) @map("processado_em") @db.Timestamptz(6)

  @@map("agentes_eventos")
}

// --------------------------------------------------------------------
// INTELIGENCIA TERRITORIAL
// Empresas georreferenciadas, portadas do hub.aplopes.com (repo
// aplopes-dev/hub). Nomes de tabela/coluna PRESERVADOS do sistema de
// origem de proposito: a migracao de dados e um dump/restore direto e o
// ETL (derivado de dim_alunos — a mesma tabela que ja vive neste banco)
// porta 1:1. Ingles no meio de um schema pt-BR e o preco documentado de
// nao reescrever uma carga de 13,7 mil registros ja validada.
// --------------------------------------------------------------------

enum CompanyStatus {
  ativa
  suspensa
  inapta
  baixada
}

enum ContactType {
  telefone
  email
  site
}

enum ConnectionType {
  grupo
  socio
  comercial
}

model Niche {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  color     String
  icon      String
  companies Company[]
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  @@map("niches")
}

/// Empresa (ou registro-pessoa) derivada de dim_alunos pelo ETL territorial.
/// revenue/employeeCount/cnae vem zerados da carga real — o GDE nao fornece.
model Company {
  id              String        @id @default(uuid())
  legalName       String
  tradeName       String
  /// CNPJ, CPF ou placeholder SEM-DOC-#####
  document        String        @unique
  /// "cnpj" | "cpf" | "nd"
  documentType    String        @default("nd") @db.VarChar(4)
  nicheId         String
  niche           Niche         @relation(fields: [nicheId], references: [id])
  cnae            String
  cnaeDescription String
  state           String        @db.VarChar(2)
  city            String
  latitude        Decimal?      @db.Decimal(9, 6)
  longitude       Decimal?      @db.Decimal(9, 6)
  revenue         Decimal       @db.Decimal(14, 2)
  revenueRange    String        @db.VarChar(4)
