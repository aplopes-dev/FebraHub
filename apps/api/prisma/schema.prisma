}

/// CisPay. Nao use codSalesforce como join: casa com 2,7% das vendas e caiu
/// para 0% em 2026, porque a Febracis passou a cobrar por link de pagamento
/// direto (docs/DESCOBERTAS.md §5). A tabela vale pelo fluxo de caixa
/// (24.890 parcelas com data de liquidacao) e pelo MDR de 3,10% — o unico
/// numero do projeto conferido contra o extrato bancario.
/// valorBruto aqui e POR PARCELA, nao o total da venda.
model FatoLiquidacaoCartao {
  parcelaId         String    @id @map("parcela_id")
  pagamentoCartaoId String?   @map("pagamento_cartao_id")
  codSalesforce     String?   @map("cod_salesforce")
  linkSalesforce    String?   @map("link_salesforce")
  subsellerId       String?   @map("subseller_id")
  dataVenda         DateTime? @map("data_venda") @db.Date
  dataLiquidacao    DateTime? @map("data_liquidacao") @db.Date
  formaPagamento    String?   @map("forma_pagamento")
  tipoTransacao     String?   @map("tipo_transacao")
  bandeira          String?
  cartaoMascarado   String?   @map("cartao_mascarado")
  numeroParcela     Int?      @map("numero_parcela")
  totalParcelas     Int?      @map("total_parcelas")
  valorBruto        Decimal?  @map("valor_bruto") @db.Decimal
  valorLiquido      Decimal?  @map("valor_liquido") @db.Decimal
  taxaCispay        Decimal?  @map("taxa_cispay") @db.Decimal
  pctMdr            Decimal?  @map("pct_mdr") @db.Decimal
  nsu               String?
  autorizacao       String?
  documento         String?
  docNorm           String?   @map("doc_norm")
  nomePortador      String?   @map("nome_portador")

  @@map("fato_liquidacao_cartao")
}

