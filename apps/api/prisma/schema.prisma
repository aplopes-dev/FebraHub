/// A EXCECAO da regra "todo id e text": cupomId, clienteId, vendedorId e
/// produtoId sao bigint no banco. Sao contadores internos do PDV da loja,
/// nao documento nem id de sistema externo. Declarar String aqui quebraria
/// o Client em runtime — o tipo tem que ser o do banco.
model FatoLojaCupom {
  cupomId      BigInt    @id @map("cupom_id")
  numeroCupom  Int?      @map("numero_cupom")
  serie        String?
  chave        String?
  dataEmissao  DateTime? @map("data_emissao") @db.Date
  valor        Decimal?  @db.Decimal
  clienteId    BigInt?   @map("cliente_id")
  vendedorId   BigInt?   @map("vendedor_id")
  cancelado    Boolean?
  devolvido    Boolean?
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamptz(6)

  @@map("fato_loja_cupom")
}

