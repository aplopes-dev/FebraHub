  @@map("fato_loja_fechamento")
}

model FatoLojaMetaMes {
  mesRef       DateTime  @id @map("mes_ref") @db.Date
  ano          Int?
  mesNome      String?   @map("mes_nome")
  master       Decimal?  @db.Decimal
  basica       Decimal?  @db.Decimal
  minima       Decimal?  @db.Decimal
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamptz(6)
  origemDado   String    @default("planilha") @map("origem_dado")

  @@map("fato_loja_meta_mes")
}

model FatoLojaMetaCurso {
  mesRef       DateTime  @map("mes_ref") @db.Date
  curso        String
  metaProdutos Decimal?  @map("meta_produtos") @db.Decimal
  metaCurso    Decimal?  @map("meta_curso") @db.Decimal
  metaTotal    Decimal?  @map("meta_total") @db.Decimal
  alunos       Int?
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamptz(6)
  origemDado   String    @default("planilha") @map("origem_dado")

  @@id([mesRef, curso])
  @@map("fato_loja_meta_curso")
