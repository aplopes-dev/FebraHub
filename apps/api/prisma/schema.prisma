  produtoId     BigInt    @id @map("produto_id")
  codigo        String?
  descricao     String?
  precoUnitario Decimal?  @map("preco_unitario") @db.Decimal
  saldo         Decimal?  @db.Decimal
  fisico        Decimal?  @db.Decimal
  reservado     Decimal?  @db.Decimal
  estoqueMinimo Decimal?  @map("estoque_minimo") @db.Decimal
  dataPosicao   DateTime? @map("data_posicao") @db.Date
  atualizadoEm  DateTime? @map("atualizado_em") @db.Timestamptz(6)
  custoMedio    Decimal?  @map("custo_medio") @db.Decimal

  @@map("fato_loja_estoque")
}

model FatoLojaCurso {
