/// Meta Ads, granularidade diaria por anuncio. PK composta
/// (data, campanhaId, anuncioKey).
model FatoMetaInsights {
  data         DateTime  @db.Date
  contaId      String?   @map("conta_id")
  campanhaId   String    @map("campanha_id")
  campanhaNome String?   @map("campanha_nome")
  adsetId      String?   @map("adset_id")
  adsetNome    String?   @map("adset_nome")
  anuncioId    String?   @map("anuncio_id")
  anuncioNome  String?   @map("anuncio_nome")
  impressoes   BigInt?
  alcance      BigInt?
  cliques      BigInt?
