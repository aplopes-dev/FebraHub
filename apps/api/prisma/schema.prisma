  @@index([vendaId])
  @@map("pdv_venda_pagamentos")
}

// ====================================================================
// FINANCEIRO ERP — contas a pagar/receber + DRE. Convive com as views
// analiticas (vw_financeiro_*) que vem do Salesforce/Sympla; estas sao
// as tabelas operacionais do ERP proprio. Uma venda do PDV gera um
// lancamento 'receber' (ja pago). Cadastros de apoio (conta, centro de
// custo, grupo, plano de contas) sustentam o rateio da DRE.
// ====================================================================

model FinanceiroContaBancaria {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  banco        String   @default("")
  saldoInicial Decimal  @default(0) @map("saldo_inicial") @db.Decimal(14, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  lancamentos  FinanceiroLancamento[]
  @@map("financeiro_contas_bancarias")
}

model FinanceiroCentroCusto {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String   @unique
  sistema   Boolean  @default(false)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  rateios   FinanceiroRateio[]
  @@map("financeiro_centros_custo")
}

model FinanceiroGrupo {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @unique
  tipo          String   // receita | despesa
  classificacao String   @default("resultado") // resultado | patrimonial
  ordem         Int      @default(0)
  sistema       Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  contas        FinanceiroPlanoConta[]
  @@map("financeiro_grupos")
}

model FinanceiroPlanoConta {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @unique
  grupoId       String   @map("grupo_id") @db.Uuid
  disponivelPdv Boolean  @default(false) @map("disponivel_pdv")
  sistema       Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  grupo         FinanceiroGrupo @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  rateios       FinanceiroRateio[]
  @@index([grupoId])
  @@map("financeiro_planos_conta")
}

/// Conciliação Stone — cada linha é uma transação de cartão capturada na
/// maquininha, importada do arquivo XML da API de Conciliação Stone
/// (GET /v2/merchant/{StoneCode}/conciliation-file/{data}). Read-only: a venda
/// acontece avulsa no POS; aqui só espelhamos p/ conferência financeira.
/// Idempotente por acquirerTransactionKey (NSU único da adquirente).
model StoneConciliacaoTransacao {
  id                 String   @id @default(uuid()) @db.Uuid
  stoneCode          String   @map("stone_code")
  referenceDate      DateTime @map("reference_date") @db.Date
  /// NSU/chave única da adquirente — âncora de idempotência.
  acquirerTransactionKey String @unique @map("acquirer_transaction_key")
  initiatorTransactionKey String? @map("initiator_transaction_key")
  authorizationDateTime  DateTime? @map("authorization_datetime") @db.Timestamptz(6)
  captureDateTime        DateTime? @map("capture_datetime") @db.Timestamptz(6)
  accountType        String?  @map("account_type")   // 1 credito | 2 debito
  brandId            String?  @map("brand_id")
  brandNome          String?  @map("brand_nome")
  cardNumber         String?  @map("card_number")     // mascarado
  numberOfInstallments Int    @default(1) @map("number_of_installments")
  authorizationCode  String?  @map("authorization_code")
  poiSerialNumber    String?  @map("poi_serial_number")
  grossAmount        Decimal  @default(0) @map("gross_amount") @db.Decimal(14, 2)
  netAmount          Decimal  @default(0) @map("net_amount") @db.Decimal(14, 2)
  feeAmount          Decimal  @default(0) @map("fee_amount") @db.Decimal(14, 2)
  previsionPaymentDate DateTime? @map("prevision_payment_date") @db.Date
  cancelado          Boolean  @default(false)
  /// XML bruto da transação (auditoria).
  bruto              Json?
  importadoEm        DateTime @default(now()) @map("importado_em") @db.Timestamptz(6)
  @@index([stoneCode, referenceDate])
  @@index([poiSerialNumber])
  @@index([previsionPaymentDate])
  @@map("stone_conciliacao_transacoes")
}

/// Controle de importação por dia — evita rebaixar o mesmo arquivo e registra
/// o resultado (quantidade, erro). Um registro por (stoneCode, referenceDate).
model StoneConciliacaoImport {
  id            String   @id @default(uuid()) @db.Uuid
  stoneCode     String   @map("stone_code")
  referenceDate DateTime @map("reference_date") @db.Date
  status        String   @default("ok")  // ok | vazio | erro
  quantidade    Int      @default(0)
  erro          String?
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  @@unique([stoneCode, referenceDate])
  @@map("stone_conciliacao_imports")
}

model FinanceiroLancamento {
  id             String   @id @default(uuid()) @db.Uuid
  operacao       String   // receber | pagar
  descricao      String   @default("")
  valor          Decimal  @db.Decimal(14, 2)
  juros          Decimal  @default(0) @db.Decimal(14, 2)
  multa          Decimal  @default(0) @db.Decimal(14, 2)
  valorPago      Decimal  @default(0) @map("valor_pago") @db.Decimal(14, 2)
  situacao       String   @default("pendente") // pendente | pago
  dataCompetencia DateTime @map("data_competencia") @db.Date
  dataVencimento DateTime @map("data_vencimento") @db.Date
  pagoEm         DateTime? @map("pago_em") @db.Date
  contraparte    String   @default("")
  formaPagamento String?  @map("forma_pagamento")
  contaBancariaId String? @map("conta_bancaria_id") @db.Uuid
  vendaId        String?  @map("venda_id") @db.Uuid
  origem         String   @default("manual") // manual | pdv
  observacao     String   @default("")
  excluidoEm     DateTime? @map("excluido_em") @db.Timestamptz(6)
  criadoPorId    String?  @map("criado_por_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  contaBancaria  FinanceiroContaBancaria? @relation(fields: [contaBancariaId], references: [id], onDelete: SetNull)
  rateios        FinanceiroRateio[]
  @@index([operacao, dataCompetencia(sort: Desc)])
  @@index([situacao, dataVencimento])
  @@index([excluidoEm])
  @@map("financeiro_lancamentos")
}

/// Rateio de um lançamento por conta contábil + centro de custo — alimenta a DRE.
model FinanceiroRateio {
  id            String   @id @default(uuid()) @db.Uuid
  lancamentoId  String   @map("lancamento_id") @db.Uuid
  planoContaId  String   @map("plano_conta_id") @db.Uuid
  centroCustoId String   @map("centro_custo_id") @db.Uuid
  valor         Decimal  @db.Decimal(14, 2)
  percentual    Decimal  @default(0) @db.Decimal(7, 4)
  lancamento    FinanceiroLancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  planoConta    FinanceiroPlanoConta @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  centroCusto   FinanceiroCentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  @@index([lancamentoId])
  @@map("financeiro_rateios")
}

// ====================================================================
// LOJA — cadastro rico de produto, categorias e estoque OPERACIONAL por
// LOCAL (LOJA / DEPOSITO). Nasce da necessidade do grande evento: o PDV e o
// Cardapio precisam de estoque confiavel e proprio, separado do ETL do Omie
// (fato_loja_estoque), que pode sobrescrever saldos durante a operacao.
// Migration 31.
// ====================================================================

model LojaCategoria {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  descricao    String   @default("")
  cor          String?
  icone        String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  produtos     LojaProduto[]

  @@index([ordem, nome])
  @@map("loja_categorias")
}

model LojaProduto {
  id                String   @id @default(uuid()) @db.Uuid
  nome              String
  sku               String?
  codigoBarras      String?  @map("codigo_barras")
  descricao         String   @default("")
  imagemUrl         String?  @map("imagem_url")
  categoriaId       String?  @map("categoria_id") @db.Uuid
  preco             Decimal  @default(0) @db.Decimal(14, 2)
  custo             Decimal? @db.Decimal(14, 2)
  unidade           String   @default("un")
  /// Vinculo opcional com o estoque legado do Omie (fato_loja_estoque.produto_id).
  produtoEstoqueId  BigInt?  @map("produto_estoque_id")
  ativo             Boolean  @default(true)
  vendePdv          Boolean  @default(true) @map("vende_pdv")
  exibeCardapio     Boolean  @default(true) @map("exibe_cardapio")
  precisaPreparacao Boolean  @default(false) @map("precisa_preparacao")
  controlaEstoque   Boolean  @default(true) @map("controla_estoque")
  /// Quando true, ignora a verificação de saldo no checkout/PDV (permite vender mesmo sem estoque).
  vendeSemEstoque   Boolean  @default(false) @map("vende_sem_estoque")
  /// Quando true, o produto aparece na seção "Destaques" do cardápio digital (acima das categorias).
  emDestaque        Boolean  @default(false) @map("em_destaque")
  estoqueMinimo     Decimal  @default(0) @map("estoque_minimo") @db.Decimal(14, 3)
  ordem             Int      @default(0)
  /// Código interno do produto no Omie (campo codigo_interno / codigo). Sincronizado bidirecional.
  skuOmie           String?  @map("sku_omie")
  criadoPorId       String?  @map("criado_por_id") @db.Uuid
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  categoria         LojaCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  saldos            LojaEstoqueSaldo[]
  movimentos        LojaEstoqueMovimento[]
  vendaItens        PdvVendaItem[]
  pedidoItens       LojaPedidoItem[]
  omieLancamentos   OmieLancamento[]

  @@unique([skuOmie])
  @@index([categoriaId])
  @@index([ativo, ordem, nome])
  @@index([produtoEstoqueId])
  @@map("loja_produtos")
}

/// Saldo operacional por (produto, local). Local fisico: LOJA ou DEPOSITO.
model LojaEstoqueSaldo {
  produtoId    String   @map("produto_id") @db.Uuid
  local        String   // LOJA | DEPOSITO
  saldoFisico  Decimal  @default(0) @map("saldo_fisico") @db.Decimal(14, 3)
  reservado    Decimal  @default(0) @db.Decimal(14, 3)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  produto      LojaProduto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([produtoId, local])
  @@index([local])
  @@map("loja_estoque_saldos")
}

/// Ledger de movimentacoes de estoque da Loja (rastro por local).
model LojaEstoqueMovimento {
  id           String   @id @default(uuid()) @db.Uuid
  produtoId    String   @map("produto_id") @db.Uuid
  local        String   // LOJA | DEPOSITO
  tipo         String   // entrada|saida|ajuste|reserva|liberacao|transferencia|devolucao|cancelamento|inventario
  quantidade   Decimal  @db.Decimal(14, 3)
  saldoApos    Decimal? @map("saldo_apos") @db.Decimal(14, 3)
  origem       String   @default("manual") // manual|pdv|cardapio|compras|transferencia
  referenciaId String?  @map("referencia_id")
  observacao   String   @default("")
  usuarioId    String?  @map("usuario_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  produto      LojaProduto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, criadoEm(sort: Desc)])
  @@index([local, criadoEm(sort: Desc)])
  @@index([origem, referenciaId])
  @@map("loja_estoque_movimentos")
}

// -------------------- LOJA: PEDIDOS --------------------

model LojaOperacao {
  id            String    @id @default(uuid()) @db.Uuid
  nome          String
  descricao     String    @default("")
  modo          String    @default("RETIRADA_BALCAO")
  status        String    @default("ativa")
  slug          String?   @unique
  /// Cartaz/pôster do evento exibido na 1ª coluna do Painel TV (PRD §22).
  /// Configurável por operação — NÃO hardcoded no componente da TV.
  cartazUrl     String?   @map("cartaz_url")
  inicio        DateTime? @db.Timestamptz(6)
  fim           DateTime? @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  pedidos       LojaPedido[]
  numeracao     LojaNumeracaoPedido?

  @@index([status])
  @@map("loja_operacoes")
}

model LojaPedido {
  id                String    @id @default(uuid()) @db.Uuid
  numero            Int
  /// Senha da fila (PRD §4-5): número sequencial OPERACIONAL, separado do
  /// numero do pedido. Atribuido SÓ quando o pedido entra na fila (pagamento
  /// confirmado + precisa preparo). Começa em 1 por operação, 2 dígitos na UI.
  /// Único por operação; nunca reutilizado (não volta a 01, não repõe senha
  /// cancelada). Null enquanto o pedido não entrou na fila.
  senhaFila         Int?      @map("senha_fila")
  operacaoId        String?   @map("operacao_id") @db.Uuid
  canal             String    @default("CARDAPIO_DIGITAL")
  status            String    @default("AGUARDANDO_PAGAMENTO")
  clienteNome       String    @default("") @map("cliente_nome")
  clienteTel        String?   @map("cliente_tel")
  operadorId        String?   @map("operador_id") @db.Uuid
  operadorNome      String?   @map("operador_nome")
  subtotal          Decimal   @default(0) @db.Decimal(14, 2)
  desconto          Decimal   @default(0) @db.Decimal(14, 2)
  total             Decimal   @default(0) @db.Decimal(14, 2)
  posicaoFila       Int?      @map("posicao_fila")
  precisaPreparacao Boolean   @default(false) @map("precisa_preparacao")
  confirmadoEm      DateTime? @map("confirmado_em") @db.Timestamptz(6)
  entrouFilaEm      DateTime? @map("entrou_fila_em") @db.Timestamptz(6)
  preparacaoEm      DateTime? @map("preparacao_em") @db.Timestamptz(6)
  prontoEm          DateTime? @map("pronto_em") @db.Timestamptz(6)
  retiradoEm        DateTime? @map("retirado_em") @db.Timestamptz(6)
  /// Token opaco (base64url) impresso no QR do comprovante do cliente. O
  /// vendedor escaneia e resgata a retirada por ele. Gerado na confirmacao do
  /// pagamento; unico; nunca reutilizado. Prova de compra paga.
  tokenRetirada     String?   @unique @map("token_retirada")
  /// Quem (usuario) e quando resgatou a retirada pelo QR.
  retiradoPorId     String?   @map("retirado_por_id") @db.Uuid
  retiradoPorNome   String?   @map("retirado_por_nome")
  /// Codigo SECRETO de retirada, 3 digitos (100..999, aleatorio). Diferente da
  /// senha_fila (publica, aparece no painel/TV): este e privado, mostrado so ao
  /// proprio cliente no comprovante. O vendedor DIGITA este codigo no balcao
  /// para localizar o pedido, conferir/editar o carrinho e imprimir. Unico
  /// apenas entre os pedidos ATIVOS da mesma operacao (garantido em codigo, sob
  /// advisory lock); reaproveitavel apos o pedido finalizar.
  codigoRetirada    Int?      @map("codigo_retirada")
  canceladoEm       DateTime? @map("cancelado_em") @db.Timestamptz(6)
  motivoCancel      String?   @map("motivo_cancel")
  lancamentoId      String?   @map("lancamento_id") @db.Uuid
  observacoes       String    @default("")
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  operacao          LojaOperacao?         @relation(fields: [operacaoId], references: [id], onDelete: SetNull)
  itens             LojaPedidoItem[]
  pagamentos        LojaPedidoPagamento[]
  historico         LojaPedidoHistorico[]
  omieLancamento    OmieLancamento?

  @@unique([operacaoId, numero])
  /// INVARIANTE 4 (PRD §46): duas entradas não têm a mesma senha na operação.
  @@unique([operacaoId, senhaFila])
  @@index([status, posicaoFila])
  @@index([operacaoId, status, entrouFilaEm])
  @@index([operacaoId, status, criadoEm(sort: Desc)])
  @@index([canal, status, criadoEm(sort: Desc)])
  @@index([operacaoId, codigoRetirada], map: "loja_pedidos_codigo_retirada_idx")
  @@map("loja_pedidos")
}

model LojaPedidoItem {
  id          String     @id @default(uuid()) @db.Uuid
  pedidoId    String     @map("pedido_id") @db.Uuid
  produtoId   String     @map("produto_id") @db.Uuid
  descricao   String
  quantidade  Decimal    @db.Decimal(12, 3)
  precoUnit   Decimal    @map("preco_unit") @db.Decimal(14, 2)
  total       Decimal    @db.Decimal(14, 2)
  observacao  String     @default("")
  pedido      LojaPedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto     LojaProduto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("loja_pedido_itens")
}

model LojaPedidoPagamento {
  id              String    @id @default(uuid()) @db.Uuid
  pedidoId        String    @map("pedido_id") @db.Uuid
  provider        String    @default("manual")
  forma           String
  status          String    @default("PENDENTE")
  valor           Decimal   @db.Decimal(14, 2)
  gatewayId       String?   @map("gateway_id")
  gatewayPayload  Json?     @map("gateway_payload")
  pixQrcode       String?   @map("pix_qrcode")
  pixCopiaCola    String?   @map("pix_copia_cola")
  pixExpiracao    DateTime? @map("pix_expiracao") @db.Timestamptz(6)
  confirmadoEm    DateTime? @map("confirmado_em") @db.Timestamptz(6)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  pedido          LojaPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([gatewayId])
  @@map("loja_pedido_pagamentos")
}

model LojaPedidoHistorico {
  id          String    @id @default(uuid()) @db.Uuid
  pedidoId    String    @map("pedido_id") @db.Uuid
  deStatus    String?   @map("de_status")
  paraStatus  String    @map("para_status")
  origem      String    @default("sistema")
  usuarioId   String?   @map("usuario_id") @db.Uuid
  observacao  String    @default("")
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  pedido      LojaPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, criadoEm(sort: Desc)])
  @@map("loja_pedido_historico")
}

model LojaNumeracaoPedido {
  operacaoId  String       @id @map("operacao_id") @db.Uuid
  /// Contador do NÚMERO do pedido (identificação transacional, inicia em 1001).
  ultimo      Int          @default(0)
  /// Contador da SENHA da fila (PRD §9): sequência atômica separada, inicia em 1.
  /// Incrementado sob a MESMA linha (lock por PK) → nunca gera senha duplicada
  /// nem reutiliza uma senha cancelada.
  ultimaSenha Int          @default(0) @map("ultima_senha")
  operacao    LojaOperacao @relation(fields: [operacaoId], references: [id], onDelete: Cascade)

  @@map("loja_numeracao_pedido")
}

/// Auditoria de eventos criticos da Loja (PRD §48). Registro imutavel de
/// quem fez o que, quando, sobre qual entidade, com antes/depois.
model LojaAuditoria {
  id           String   @id @default(uuid()) @db.Uuid
  entidade     String
  entidadeId   String?  @map("entidade_id") @db.Uuid
  acao         String
  origem       String   @default("sistema")
  usuarioId    String?  @map("usuario_id") @db.Uuid
  usuarioNome  String?  @map("usuario_nome")
  antes        Json?
  depois       Json?
  observacao   String   @default("")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId, criadoEm(sort: Desc)])
  @@index([acao, criadoEm(sort: Desc)])
  @@index([criadoEm(sort: Desc)])
  @@map("loja_auditoria")
}

// ====================================================================
// FISCAL — emissao de cupom fiscal (NFC-e mod 65, via SVRS) e cupom nao
// fiscal (recibo interno). Portado/adaptado do @citybox/fiscal-api.
//
// A Febracis e o UNICO emitente, entao a config e um singleton (linha id=1),
// diferente do citybox que era multi-tenant por Loja. O certificado A1 e o
// token do CSC vivem cifrados (AES-256-GCM, FISCAL_CERT_ENCRYPTION_KEY); o
// PFX cru fica no MinIO sob chave cifrada, nunca no banco.
// ====================================================================

/// Configuracao fiscal do emitente (singleton, id=1). Dados que vao no XML da
/// NFC-e e no cabecalho do cupom nao fiscal.
model FiscalConfig {
  id                  Int      @id @default(1)
  /// homologacao | producao — ambiente da SEFAZ/SVRS para onde a nota vai.
  ambiente            String   @default("homologacao")
  razaoSocial         String   @map("razao_social")
  nomeFantasia        String?  @map("nome_fantasia")
  cnpj                String
  /// Inscricao Estadual — obrigatoria para NFC-e.
  inscricaoEstadual   String?  @map("inscricao_estadual")
  inscricaoMunicipal  String?  @map("inscricao_municipal")
  /// Regime tributario: 1 Simples, 2 Simples excesso, 3 Regime normal.
  regimeTributario    String   @default("3") @map("regime_tributario")
  /// Endereco do emitente (logradouro, numero, bairro, municipio, cMun IBGE, uf, cep).
  endereco            Json?
  uf                  String   @default("BA")
  /// Codigo IBGE do municipio do emitente (7 digitos) — 2927408 = Salvador.
  codigoMunicipio     String?  @map("codigo_municipio")
  telefone            String?
  /// CSC (Codigo de Seguranca do Contribuinte) e seu ID, por ambiente.
  /// Token cifrado; nunca retornado pela API.
  cscId               String?  @map("csc_id")
  cscTokenCifrado     String?  @map("csc_token_cifrado")
  /// Serie da NFC-e (default 1).
  serieNfce           Int      @default(1) @map("serie_nfce")
  /// Habilita a emissao de cupom FISCAL (NFC-e). O nao fiscal independe disto.
  nfceHabilitada      Boolean  @default(false) @map("nfce_habilitada")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("fiscal_config")
}

/// Certificado digital A1 (e-CNPJ) do emitente. O PFX cru mora no MinIO
/// (pfxObjectKey) cifrado; aqui ficam so os metadados + a senha cifrada.
model FiscalCertificado {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String   @default("")
  /// CNPJ do titular extraido do proprio certificado (confere com o emitente).
  cnpjTitular    String   @map("cnpj_titular")
  pfxObjectKey   String   @map("pfx_object_key")
  senhaCifrada   String   @map("senha_cifrada")
  validoDe       DateTime @map("valido_de") @db.Timestamptz(6)
  validoAte      DateTime @map("valido_ate") @db.Timestamptz(6)
  /// ativo | inativo | vencido
  situacao       String   @default("ativo")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([situacao, validoAte])
  @@map("fiscal_certificados")
}

/// Numeracao sequencial por (tipo, serie, ambiente). NFC-e exige numeracao
/// continua e sem saltos — o salto o fisco cobra explicacao.
model FiscalSequencia {
  id            String   @id @default(uuid()) @db.Uuid
  tipoDocumento String   @map("tipo_documento") // NFCE
  serie         Int
  ambiente      String
  numeroAtual   BigInt   @default(0) @map("numero_atual")
  ativo         Boolean  @default(true)

  @@unique([tipoDocumento, serie, ambiente])
  @@map("fiscal_sequencias")
}

/// Documento fiscal emitido (ou tentativa). Guarda o ciclo completo: da
/// montagem ao protocolo de autorizacao. O XML autorizado e o PDF do cupom
/// ficam no MinIO (xmlObjectKey / pdfObjectKey).
model FiscalDocumento {
  id             String   @id @default(uuid()) @db.Uuid
  tipoDocumento  String   @map("tipo_documento") // NFCE | NAO_FISCAL
  ambiente       String
  /// rascunho | assinado | autorizado | rejeitado | cancelado | erro
  situacao       String   @default("rascunho")
  /// Venda de origem (PdvVenda) — o cupom sai de uma venda ja fechada.
  vendaId        String?  @map("venda_id") @db.Uuid
  serie          Int?
  numero         BigInt?
  /// Chave de acesso de 44 digitos (NFC-e autorizada).
  chaveAcesso    String?  @map("chave_acesso")
  protocolo      String?
  /// QR Code (texto) da NFC-e, para reimpressao do cupom.
  qrCode         String?  @map("qr_code")
  valorTotal     Decimal  @default(0) @map("valor_total") @db.Decimal(14, 2)
  clienteNome    String?  @map("cliente_nome")
  clienteDoc     String?  @map("cliente_doc")
  xmlObjectKey   String?  @map("xml_object_key")
  pdfObjectKey   String?  @map("pdf_object_key")
  codigoErro     String?  @map("codigo_erro")
  mensagemErro   String?  @map("mensagem_erro")
  /// Idempotencia: uma venda gera no maximo um cupom fiscal autorizado.
  emitidoPorId   String?  @map("emitido_por_id") @db.Uuid
  emitidoPorNome String?  @map("emitido_por_nome")
  autorizadoEm   DateTime? @map("autorizado_em") @db.Timestamptz(6)
  canceladoEm    DateTime? @map("cancelado_em") @db.Timestamptz(6)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@index([tipoDocumento, situacao, criadoEm(sort: Desc)])
  @@index([vendaId])
  @@index([chaveAcesso])
  @@map("fiscal_documentos")
}

/// Trilha bruta da conversa com a SEFAZ/SVRS (o que foi enviado, o que voltou)
/// + eventos pos-emissao (cancelamento). Auditoria fiscal (FR-011).
model FiscalEvento {
  id             String   @id @default(uuid()) @db.Uuid
  documentoId    String?  @map("documento_id") @db.Uuid
  /// EMISSAO | CANCELAMENTO | CONSULTA
  tipo           String
  operacao       String   @default("")
  situacao       String   @default("")
  justificativa  String?
  protocolo      String?
  requestXml     String?  @map("request_xml")
  responseXml    String?  @map("response_xml")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([documentoId, criadoEm(sort: Desc)])
  @@map("fiscal_eventos")
}

// --------------------------------------------------------------------
// LEGADO
// Legado do Supabase — nao usar em codigo novo.
// --------------------------------------------------------------------

/// Tabelas do Supabase Auth, mantidas so como referencia da migracao — o id
/// apontava para auth.users, que nao existe mais. Quem manda agora e
/// Usuario / PerfilSetor. Nao escreva aqui.
model PerfilLegado {
  id    String  @id @db.Uuid
  nome  String?
  setor String?
  papel String?

  @@map("perfis")
}

model PerfilSetorLegado {
