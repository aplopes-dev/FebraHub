  mesRef       DateTime? @map("mes_ref") @db.Date
  ano          Int?
  mesNome      String?   @map("mes_nome")
  periodo      String?
  curso        String?
  turma        String?
  treinador    String?
  dinheiro     Decimal?  @db.Decimal
  debito       Decimal?  @db.Decimal
  credito      Decimal?  @db.Decimal
  pix          Decimal?  @db.Decimal
  total        Decimal?  @db.Decimal
  meta         Decimal?  @db.Decimal
  alunos       Int?
  ticketMedio  Decimal?  @map("ticket_medio") @db.Decimal
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamptz(6)
  /// 'planilha' (ETL) ou 'cadastro' (CRUD) — sync não sobrescreve cadastro.
  origemDado   String    @default("planilha") @map("origem_dado")

  @@map("fato_loja_curso")
