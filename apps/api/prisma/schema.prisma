  vendaId         String       @map("venda_id") @db.Uuid
  /// Legado Omie — mantido para histórico de vendas antigas.
  produtoId       BigInt?      @map("produto_id")
  /// Catálogo nativo da Loja — usado em vendas novas.
  lojaProdutoId   String?      @map("loja_produto_id") @db.Uuid
  descricao       String
  quantidade      Decimal      @db.Decimal(12, 3)
  precoUnit       Decimal      @map("preco_unit") @db.Decimal(14, 2)
  total           Decimal      @db.Decimal(14, 2)
