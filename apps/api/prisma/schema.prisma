  valorLiquido   Decimal?  @map("valor_liquido") @db.Decimal

  @@map("fato_extrato_cispay")
}

/// Ponte pagamento -> curso, herdada de uma materialized view do Supabase.
/// Chegou sem PK, entao leva @@ignore: nao aparece no Client e e lida por
/// $queryRaw. Nao invente uma PK aqui — o par (venda, curso) se repete.
model MvVendaCurso {
  originalIdVenda String? @map("original_id_venda")
  cursoId         String? @map("curso_id")

  @@map("mv_venda_curso")
  @@ignore
}

