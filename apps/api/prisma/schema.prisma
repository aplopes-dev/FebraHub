// ====================================================================
// FORNECEDORES — cadastro corporativo UNICO (PRD Compras §36/§37).
// Antes o fornecedor era texto livre repetido em cada cotacao/pedido; aqui
// ele vira entidade referenciavel, sem duplicar por modulo/setor. Cotacoes e
// pedidos passam a poder apontar para ele (fornecedorId opcional — o texto
// continua existindo para propostas de fornecedor ainda nao cadastrado).
// ====================================================================

model Fornecedor {
  id               String   @id @default(uuid()) @db.Uuid
  razaoSocial      String   @map("razao_social")
  nomeFantasia     String?  @map("nome_fantasia")
  /// CPF/CNPJ so digitos. Unico quando informado (indice parcial na migration).
  documento        String?
  inscricao        String?
  email            String?
  telefone         String?
  whatsapp         String?
  /// Endereco em um bloco so — o cadastro corporativo nao precisa normalizar
  /// logradouro/numero/bairro para o uso de Compras.
  endereco         String?
  cidade           String?
  uf               String?  @db.VarChar(2)
  cep              String?
  /// Categorias/tags livres (ex.: "papelaria", "grafica", "servicos").
  categorias       String[] @default([])
  banco            String?
  agencia          String?
  conta            String?
  chavePix         String?  @map("chave_pix")
  prazoMedioDias   Int?     @map("prazo_medio_dias")
  condicoesComerciais String? @map("condicoes_comerciais")
  /// ativo | inativo | bloqueado | em_homologacao
  situacao         String   @default("ativo")
  observacoes      String?
  documentos       Json     @default("[]")
  criadoPor        String?  @map("criado_por") @db.Uuid
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  contatos         FornecedorContato[]
  cotacoes         CompraCotacao[]
  pedidos          CompraPedido[]

  @@index([situacao, razaoSocial])
  @@map("fornecedores")
}

