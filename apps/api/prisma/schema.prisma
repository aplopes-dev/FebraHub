// ====================================================================
// COMERCIAL CRM — módulo de pipeline de vendas (migration 41/42)
// Entidade central: CrmCliente (já existe em crm_clientes)
// ====================================================================

/// Funil comercial configurável. Separado de CrmFunil (B2B genérico).
model ComFunil {
  id          String   @id @default(uuid()) @db.Uuid
  nome        String
  descricao   String?
  cor         String   @default("#B8934A")
  /// vendas | relacionamento | pos_venda
  tipo        String   @default("vendas")
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  criadoPor   String?  @map("criado_por") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  etapas        ComEtapa[]
  oportunidades ComOportunidade[]

  @@map("com_funis")
}

/// Etapa do funil comercial (configurável, sem hardcode).
model ComEtapa {
  id            String   @id @default(uuid()) @db.Uuid
  funilId       String   @map("funil_id") @db.Uuid
  nome          String
  descricao     String?
  cor           String   @default("#6B7280")
  /// aberta | ganha | perdida
  tipo          String   @default("aberta")
  probabilidade Int      @default(0)
  ordem         Int      @default(0)
  /// etapa de sistema: nome/exclusão travados
  sistema       Boolean  @default(false)
  exigeMotivo   Boolean  @default(false) @map("exige_motivo")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  funil         ComFunil          @relation(fields: [funilId], references: [id], onDelete: Cascade)
  oportunidades ComOportunidade[]

  @@index([funilId, ordem])
  @@map("com_etapas")
}

/// Catálogo configurável de motivos de perda de oportunidade.
model ComMotivoPerdaOp {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  oportunidades ComOportunidade[]

  @@map("com_motivos_perda")
}

/// Catálogo de produtos/serviços comerciais (treinamentos, cursos, coaching).
/// NÃO é a loja (mercadorias). Compartilha a base mas tem atributos próprios.
model ComProduto {
  id             String   @id @default(uuid()) @db.Uuid
  codigo         String?  @unique
  nome           String
  descricao      String?
  /// educacional | servico | outro
  tipo           String   @default("educacional")
  precoCentavos  BigInt   @default(0) @map("preco_centavos")
  ativo          Boolean  @default(true)
  /// ID externo Salesforce (Product2.Id)
  sfProdutoId    String?  @unique @map("sf_produto_id")
  /// FK fraca para dim_cursos.curso_id (dado legado)
  dimCursoId     String?  @map("dim_curso_id")
  criadoPor      String?  @map("criado_por") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  oportunidades ComOportunidade[]
  negociacoes   ComNegociacao[]
  vendas        ComVenda[]
  metas         ComMeta[]

  @@index([tipo, ativo])
  @@map("com_produtos")
}

/// Pipeline de oportunidades comerciais.
/// Uma Pessoa (CrmCliente) pode ter múltiplas oportunidades ao longo do tempo.
model ComOportunidade {
  id                  String    @id @default(uuid()) @db.Uuid

  /// Pessoa corporativa única (via crm_clientes)
  pessoaId            String    @map("pessoa_id") @db.Uuid
  pessoa              CrmCliente @relation(fields: [pessoaId], references: [id], onDelete: Restrict)

  produtoId           String?   @map("produto_id") @db.Uuid
  produto             ComProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  /// Desnormalizado para histórico (produto pode ser removido)
  produtoNome         String?   @map("produto_nome")

  funilId             String    @map("funil_id") @db.Uuid
  funil               ComFunil  @relation(fields: [funilId], references: [id])
  etapaId             String    @map("etapa_id") @db.Uuid
  etapa               ComEtapa  @relation(fields: [etapaId], references: [id])

  /// Responsável comercial (FK fraca — pode ser externo ao sistema)
  responsavelId       String?   @map("responsavel_id") @db.Uuid

  unidade             String?

  valorEstimadoCentavos BigInt  @default(0) @map("valor_estimado_centavos")
  probabilidade       Int       @default(0)

  /// Rastreabilidade de origem (nunca apagar após conversão — PRD §5/41)
  origem              String?
  canal               String?
  campanha            String?
  eventoRef           String?   @map("evento_ref")
  utmSource           String?   @map("utm_source")
  utmMedium           String?   @map("utm_medium")
  utmCampaign         String?   @map("utm_campaign")
  utmContent          String?   @map("utm_content")
  utmTerm             String?   @map("utm_term")

  /// Salesforce
  sfOportunidadeId    String?   @unique @map("sf_oportunidade_id")
  sfLeadId            String?   @map("sf_lead_id")

  dataPrevistaFechamento DateTime? @map("data_prevista_fechamento") @db.Date
  ultimaInteracaoEm   DateTime? @map("ultima_interacao_em") @db.Timestamptz(6)
  proximaAcaoEm       DateTime? @map("proxima_acao_em") @db.Timestamptz(6)
  proximaAcaoDescricao String?  @map("proxima_acao_descricao")
  fechadaEm           DateTime? @map("fechada_em") @db.Timestamptz(6)

  /// aberta | ganha | perdida | arquivada
  status              String    @default("aberta")

  motivoPerdaId       String?   @map("motivo_perda_id") @db.Uuid
  motivoPerda         ComMotivoPerdaOp? @relation(fields: [motivoPerdaId], references: [id], onDelete: SetNull)
  motivoPerdaTexto    String?   @map("motivo_perda_texto")

  /// Turma do produto educacional (FK fraca → pedagogico_turmas)
  turmaId             String?   @map("turma_id") @db.Uuid
  turmaADefinir       Boolean   @default(true) @map("turma_a_definir")

  observacao          String?
  temAlerta           Boolean   @default(false) @map("tem_alerta")

  criadoPor           String?   @map("criado_por") @db.Uuid
  criadoEm            DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  historico           ComOportunidadeHistorico[]
  responsavelHistorico ComResponsavelHistorico[]
  proximasAcoes       ComProximaAcao[]
  negociacao          ComNegociacao?
  venda               ComVenda?
  leadsOrigem         ComLeadOrigem[]
  sympla_orders       SymplaOrder[]

  @@index([pessoaId])
  @@index([funilId, etapaId])
  @@index([responsavelId])
  @@index([status, fechadaEm])
  @@index([criadoEm(sort: Desc)])
  @@map("com_oportunidades")
}

/// Timeline 360° de cada oportunidade — cada evento relevante gera uma linha.
model ComOportunidadeHistorico {
  id              BigInt   @id @default(autoincrement())
  oportunidadeId  String   @map("oportunidade_id") @db.Uuid
  oportunidade    ComOportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  /// lead_recebido | atribuido | etapa_mudou | interacao | proxima_acao
  /// nota | ligacao | whatsapp | email | reuniao | proposta
  /// venda_criada | venda_aprovada | venda_cancelada | perdida | reaberta
  /// turma_definida | transferencia_responsavel | sistema | salesforce
  tipo            String
  titulo          String?
  descricao       String?

  etapaAnterior   String?  @map("etapa_anterior")
  etapaNova       String?  @map("etapa_nova")
  responsavelAnterior String? @map("responsavel_anterior") @db.Uuid
  responsavelNovo String?  @map("responsavel_novo") @db.Uuid

  campo           String?
  valorAnterior   String?  @map("valor_anterior")
  valorNovo       String?  @map("valor_novo")
  canal           String?

  usuarioId       String?  @map("usuario_id") @db.Uuid
  /// sistema | usuario | salesforce | webhook | automatico
  origem          String   @default("usuario")

  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([oportunidadeId, criadoEm(sort: Desc)])
  @@index([tipo, criadoEm(sort: Desc)])
  @@map("com_oportunidade_historico")
}

/// Trilha de transferências de responsável por oportunidade.
model ComResponsavelHistorico {
  id                  BigInt   @id @default(autoincrement())
  oportunidadeId      String   @map("oportunidade_id") @db.Uuid
  oportunidade        ComOportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  responsavelAnterior String?  @map("responsavel_anterior") @db.Uuid
  responsavelNovo     String?  @map("responsavel_novo") @db.Uuid
  alteradoPor         String?  @map("alterado_por") @db.Uuid
  motivo              String?
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([oportunidadeId, criadoEm(sort: Desc)])
  @@map("com_responsavel_historico")
}

/// Próximas ações / tarefas comerciais vinculadas a oportunidade + pessoa.
model ComProximaAcao {
  id              String   @id @default(uuid()) @db.Uuid
  oportunidadeId  String   @map("oportunidade_id") @db.Uuid
  oportunidade    ComOportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  pessoaId        String   @map("pessoa_id") @db.Uuid
  responsavelId   String?  @map("responsavel_id") @db.Uuid

  /// ligar | whatsapp | email | reuniao | proposta | follow_up | outro
  tipo            String   @default("follow_up")
  titulo          String
  descricao       String?

  venceEm         DateTime @map("vence_em") @db.Timestamptz(6)
  /// alta | media | baixa
  prioridade      String   @default("media")

  concluidaEm     DateTime? @map("concluida_em") @db.Timestamptz(6)
  resultado       String?

  criadoPor       String?  @map("criado_por") @db.Uuid
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([oportunidadeId])
  @@index([responsavelId, venceEm])
  @@map("com_proximas_acoes")
}

/// Condições comerciais da oportunidade em negociação (1:1 com oportunidade).
model ComNegociacao {
  id                      String   @id @default(uuid()) @db.Uuid
  oportunidadeId          String   @unique @map("oportunidade_id") @db.Uuid
  oportunidade            ComOportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  produtoId               String?  @map("produto_id") @db.Uuid
  produto                 ComProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  produtoNome             String?  @map("produto_nome")
  quantidade              Int      @default(1)

  /// Valores em centavos — OBRIGATÓRIO manter integridade (PRD §23)
  precoTabelaCentavos     BigInt   @default(0) @map("preco_tabela_centavos")
  descontoCentavos        BigInt   @default(0) @map("desconto_centavos")
  descontoPercentual      Decimal  @default(0) @map("desconto_percentual") @db.Decimal(5, 2)
  valorNegociadoCentavos  BigInt   @default(0) @map("valor_negociado_centavos")
  entradaCentavos         BigInt   @default(0) @map("entrada_centavos")
  saldoCentavos           BigInt   @default(0) @map("saldo_centavos")

  numParcelas             Int      @default(1) @map("num_parcelas")
  valorParcelaCentavos    BigInt   @default(0) @map("valor_parcela_centavos")

  /// pix | cartao_credito | cartao_debito | boleto | dinheiro | transferencia | cortesia | outro
  formaPagamento          String   @default("pix") @map("forma_pagamento")
  vencimentos             Json     @default("[]")

  condicaoEspecial        String?  @map("condicao_especial")
  observacao              String?

  /// Turma educacional (FK fraca para pedagogico_turmas)
  turmaId                 String?  @map("turma_id") @db.Uuid
  turmaADefinir           Boolean  @default(true) @map("turma_a_definir")

  /// Aprovação de desconto
  descontoAprovadoPor     String?  @map("desconto_aprovado_por") @db.Uuid
  descontoAprovadoEm      DateTime? @map("desconto_aprovado_em") @db.Timestamptz(6)
  descontoMotivo          String?  @map("desconto_motivo")

  /// rascunho | em_analise | aprovada | recusada
  statusAprovacao         String   @default("rascunho") @map("status_aprovacao")

  criadoPor               String?  @map("criado_por") @db.Uuid
  criadoEm                DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm            DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  venda ComVenda?

  @@map("com_negociacoes")
}

/// Venda fechada — entidade imutável após aprovação.
/// Status COMERCIAL ≠ Status FINANCEIRO (PRD §24 obrigatório).
/// Valor integral SEMPRE preservado (PRD §23 obrigatório).
model ComVenda {
  id                      String   @id @default(uuid()) @db.Uuid

  /// Número sequencial humano (VND-AAAA-NNNN)
  numero                  String   @unique

  /// Vínculos de origem
  oportunidadeId          String?  @unique @map("oportunidade_id") @db.Uuid
  oportunidade            ComOportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: Restrict)
  negociacaoId            String?  @unique @map("negociacao_id") @db.Uuid
  negociacao              ComNegociacao? @relation(fields: [negociacaoId], references: [id], onDelete: Restrict)

  /// Comprador (quem paga — PRD §31)
  compradorId             String   @map("comprador_id") @db.Uuid
  comprador               CrmCliente @relation("VendasComprador", fields: [compradorId], references: [id], onDelete: Restrict)

  /// Beneficiário (quem usa — pode ser diferente do comprador — PRD §31)
  beneficiarioId          String?  @map("beneficiario_id") @db.Uuid
  beneficiario            CrmCliente? @relation("VendasBeneficiario", fields: [beneficiarioId], references: [id], onDelete: SetNull)
  beneficiarioNome        String?  @map("beneficiario_nome")

  vendedorId              String?  @map("vendedor_id") @db.Uuid
  relacionadoraId         String?  @map("relacionadora_id") @db.Uuid
  unidade                 String?

  produtoId               String?  @map("produto_id") @db.Uuid
  produto                 ComProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  produtoNome             String   @map("produto_nome")
  quantidade              Int      @default(1)

  /// Valores (OBRIGATÓRIOS — PRD §23)
  precoTabelaCentavos     BigInt   @default(0) @map("preco_tabela_centavos")
  descontoCentavos        BigInt   @default(0) @map("desconto_centavos")
  descontoPercentual      Decimal  @default(0) @map("desconto_percentual") @db.Decimal(5, 2)
  valorNegociadoCentavos  BigInt   @default(0) @map("valor_negociado_centavos")
  entradaCentavos         BigInt   @default(0) @map("entrada_centavos")
  saldoCentavos           BigInt   @default(0) @map("saldo_centavos")

  numParcelas             Int      @default(1) @map("num_parcelas")
  valorParcelaCentavos    BigInt   @default(0) @map("valor_parcela_centavos")
  formaPagamento          String   @default("pix") @map("forma_pagamento")
  vencimentos             Json     @default("[]")

  turmaId                 String?  @map("turma_id") @db.Uuid
  turmaADefinir           Boolean  @default(true) @map("turma_a_definir")

  /// Rastreabilidade preservada
  origem                  String?
  campanha                String?
  eventoRef               String?  @map("evento_ref")
  utmSource               String?  @map("utm_source")

  /// Status COMERCIAL: rascunho | aguardando_aprovacao | aprovada | cancelada
  statusComercial         String   @default("aguardando_aprovacao") @map("status_comercial")

  /// Status FINANCEIRO: pendente | parcial | quitado | inadimplente | estornado
  /// Atualizado PELO MÓDULO FINANCEIRO — não pelo Comercial (PRD §24/28)
  statusFinanceiro        String   @default("pendente") @map("status_financeiro")

  aprovadoPor             String?  @map("aprovado_por") @db.Uuid
  aprovadoEm              DateTime? @map("aprovado_em") @db.Timestamptz(6)

  canceladoPor            String?  @map("cancelado_por") @db.Uuid
  canceladoEm             DateTime? @map("cancelado_em") @db.Timestamptz(6)
  motivoCancelamento      String?  @map("motivo_cancelamento")

  /// Salesforce
  sfVendaId               String?  @unique @map("sf_venda_id")
  sfOportunidadeId        String?  @map("sf_oportunidade_id")

  /// Integração: IDs gerados pelo Financeiro/Pedagógico
  financeiroLancamentoId  String?  @map("financeiro_lancamento_id")
  pedagogicoMatriculaId   String?  @map("pedagogico_matricula_id") @db.Uuid

  /// Controle de eventos corporativos disparados
  eventoAprovadaEm        DateTime? @map("evento_aprovada_em") @db.Timestamptz(6)
  eventoCanceladaEm       DateTime? @map("evento_cancelada_em") @db.Timestamptz(6)

  condicaoEspecial        String?  @map("condicao_especial")
  observacao              String?

  criadoPor               String?  @map("criado_por") @db.Uuid
  criadoEm                DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm            DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  historico               ComVendaHistorico[]

  @@index([compradorId])
  @@index([statusComercial, statusFinanceiro])
  @@index([vendedorId])
  @@index([criadoEm(sort: Desc)])
  @@map("com_vendas")
}

/// Auditoria completa da venda (PRD §50 obrigatório).
model ComVendaHistorico {
  id          BigInt   @id @default(autoincrement())
  vendaId     String   @map("venda_id") @db.Uuid
  venda       ComVenda @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  tipo        String
  titulo      String?
  descricao   String?
  campo       String?
  valorAnterior String? @map("valor_anterior")
  valorNovo   String?  @map("valor_novo")
  usuarioId   String?  @map("usuario_id") @db.Uuid
  origem      String   @default("usuario")
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([vendaId, criadoEm(sort: Desc)])
  @@map("com_venda_historico")
}

/// Fila de eventos corporativos para integração assíncrona.
/// VENDA_APROVADA → Financeiro + Pedagógico (PRD §27/54).
model ComEventoCorporativo {
  id             BigInt   @id @default(autoincrement())
  tipo           String
  payload        Json     @default("{}")
  referenciaId   String   @map("referencia_id")
  referenciaTipo String   @map("referencia_tipo")
  consumidores   Json     @default("{}")
  /// pendente | processando | processado | erro | ignorado
  status         String   @default("pendente")
  tentativas     Int      @default(0)
  erroMensagem   String?  @map("erro_mensagem")
  processadoEm   DateTime? @map("processado_em") @db.Timestamptz(6)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@unique([tipo, referenciaTipo, referenciaId], map: "ux_com_evento_ref")
  @@index([status, tentativas])
  @@index([tipo, criadoEm(sort: Desc)])
  @@map("com_eventos_corporativos")
}

/// Mapeamento de IDs Salesforce ↔ ERP (PRD §52/53).
model ComSalesforceSync {
  id             String   @id @default(uuid()) @db.Uuid
  entidadeTipo   String   @map("entidade_tipo")
  entidadeId     String   @map("entidade_id")
  sfId           String   @map("sf_id")
  sfObjeto       String?  @map("sf_objeto")
  ultimaSyncEm   DateTime? @map("ultima_sync_em") @db.Timestamptz(6)
  /// erp_para_sf | sf_para_erp | bidirecional
  direcao        String   @default("sf_para_erp")
  /// ok | erro | pendente | conflito
  status         String   @default("ok")
  erroMensagem   String?  @map("erro_mensagem")
  sistemaOrigem  String?  @map("sistema_origem")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@unique([entidadeTipo, entidadeId], map: "ux_com_sf_sync_entidade")
  @@unique([sfId, entidadeTipo], map: "ux_com_sf_sync_sfid")
  @@index([status, ultimaSyncEm])
  @@map("com_salesforce_sync")
}

/// Carteiras comerciais por responsável.
model ComCarteira {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String
  responsavelId   String?  @map("responsavel_id") @db.Uuid
  /// consultor | relacionadora | gestor
  tipoResponsavel String   @default("consultor") @map("tipo_responsavel")
  ativo           Boolean  @default(true)
  descricao       String?
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([responsavelId])
  @@map("com_carteiras")
}

/// Metas comerciais configuráveis por vendedor/unidade/produto/período.
model ComMeta {
  id             String   @id @default(uuid()) @db.Uuid
  /// mes | trimestre | ano
  escopo         String   @default("mes")
  competencia    DateTime @db.Date
  usuarioId      String?  @map("usuario_id") @db.Uuid
  unidade        String?
  produtoId      String?  @map("produto_id") @db.Uuid
  produto        ComProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  /// leads | oportunidades | vendas | valor_vendido | valor_recebido
  tipoMeta       String   @map("tipo_meta")
  valorCentavos  BigInt   @default(0) @map("valor_centavos")
  observacao     String?
  criadoPor      String?  @map("criado_por") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@index([usuarioId, competencia])
  @@index([unidade, competencia])
  @@map("com_metas")
}

/// Rastreabilidade de entrada de leads (origem nunca apagada — PRD §5).
model ComLeadOrigem {
  id              String   @id @default(uuid()) @db.Uuid
  pessoaId        String   @map("pessoa_id") @db.Uuid
  pessoa          CrmCliente @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  oportunidadeId  String?  @map("oportunidade_id") @db.Uuid
  oportunidade    ComOportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)

  /// salesforce | meta | google | whatsapp | instagram | manychat | sympla
  /// palestra | evento | indicacao | formulario | importacao | manual | outro
  canal           String   @default("manual")
  campanha        String?
  eventoRef       String?  @map("evento_ref")
  utmSource       String?  @map("utm_source")
  utmMedium       String?  @map("utm_medium")
  utmCampaign     String?  @map("utm_campaign")
  utmContent      String?  @map("utm_content")
  utmTerm         String?  @map("utm_term")
  dadosExtras     Json     @default("{}") @map("dados_extras")
  sfLeadId        String?  @map("sf_lead_id")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([pessoaId, criadoEm(sort: Desc)])
  @@index([canal, criadoEm(sort: Desc)])
  @@map("com_leads_origem")
}

// ====================================================================
// SYMPLA — Integração com a plataforma de eventos
// Migration: 00000000000047_sympla_integracao
// ====================================================================

/// Eventos da conta Sympla (cache local).
model SymplaEvento {
  id            BigInt    @id
  nome          String
  dataInicio    DateTime? @map("data_inicio") @db.Timestamptz(6)
  dataFim       DateTime? @map("data_fim") @db.Timestamptz(6)
  localNome     String?   @map("local_nome")
  cidade        String?
  estado        String?
  imagemUrl     String?   @map("imagem_url")
  urlSympla     String?   @map("url_sympla")
  publicado     Boolean   @default(true)
  cancelado     Boolean   @default(false)
  totalPedidos  Int?      @map("total_pedidos")
  totalReceita  Decimal?  @default(0) @map("total_receita") @db.Decimal(14, 2)
  totalLiquido  Decimal?  @default(0) @map("total_liquido") @db.Decimal(14, 2)
  payloadRaw    Json?     @map("payload_raw")
  sincronizadoEm DateTime? @map("sincronizado_em") @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  orders        SymplaOrder[]
  participantes SymplaParticipante[]

  @@index([dataInicio(sort: Desc)])
  @@index([estado])
  @@map("sympla_eventos")
}

/// Pedidos (vendas) por evento Sympla.
model SymplaOrder {
  id              String    @id  // ex: "2LLQZ8DJDR3"
  eventoId        BigInt    @map("evento_id")
  evento          SymplaEvento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  orderDate       DateTime? @map("order_date") @db.Timestamptz(6)
  approvedDate    DateTime? @map("approved_date") @db.Timestamptz(6)
  updatedDate     DateTime? @map("updated_date") @db.Timestamptz(6)
  /// 'A' = aprovado, 'C' = cancelado, 'P' = pendente
  status          String?
  /// FREE | PIX | CREDIT_CARD | BOLETO
  transactionType String?   @map("transaction_type")
  totalSalePrice  Decimal   @default(0) @map("total_sale_price") @db.Decimal(14, 2)
  totalNetValue   Decimal   @default(0) @map("total_net_value") @db.Decimal(14, 2)
  buyerFirstName  String?   @map("buyer_first_name")
  buyerLastName   String?   @map("buyer_last_name")
  buyerEmail      String?   @map("buyer_email")
  buyerCpf        String?   @map("buyer_cpf")
  utmSource       String?   @map("utm_source")
  utmMedium       String?   @map("utm_medium")
  utmCampaign     String?   @map("utm_campaign")
  utmTerm         String?   @map("utm_term")
  utmContent      String?   @map("utm_content")
  referrer        String?
  crmClienteId    String?   @map("crm_cliente_id") @db.Uuid
  crmCliente      CrmCliente? @relation(fields: [crmClienteId], references: [id], onDelete: SetNull)
  comOportunidadeId String? @map("com_oportunidade_id") @db.Uuid
  comOportunidade ComOportunidade? @relation(fields: [comOportunidadeId], references: [id], onDelete: SetNull)
  payloadRaw      Json?     @map("payload_raw")
  sincronizadoEm  DateTime? @map("sincronizado_em") @db.Timestamptz(6)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  participantes   SymplaParticipante[]

  @@index([eventoId])
  @@index([status])
  @@index([buyerEmail])
  @@index([buyerCpf])
  @@index([crmClienteId])
  @@index([orderDate(sort: Desc)])
  @@map("sympla_orders")
}

/// Participantes por order Sympla.
model SymplaParticipante {
  id            BigInt    @id
  orderId       String    @map("order_id")
  order         SymplaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventoId      BigInt    @map("evento_id")
  evento        SymplaEvento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  ticketNumber  String?   @map("ticket_number")
  ticketName    String?   @map("ticket_name")
  ticketPrice   Decimal   @default(0) @map("ticket_price") @db.Decimal(14, 2)
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String?
  telefone      String?
  cpf           String?
  checkin       Boolean   @default(false)
  checkinDate   DateTime? @map("checkin_date") @db.Timestamptz(6)
  customForm    Json      @default("[]") @map("custom_form")
  crmClienteId  String?   @map("crm_cliente_id") @db.Uuid
  crmCliente    CrmCliente? @relation(fields: [crmClienteId], references: [id], onDelete: SetNull)
  payloadRaw    Json?     @map("payload_raw")
  sincronizadoEm DateTime? @map("sincronizado_em") @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([orderId])
  @@index([eventoId])
  @@index([email])
  @@index([cpf])
  @@index([crmClienteId])
  @@map("sympla_participantes")
}

/// Log de sincronizações Sympla (controle de idempotência).
model SympláSyncLog {
  id             BigInt    @id @default(autoincrement())
  /// eventos | orders_evento | participantes_order | full
  tipo           String
  referenciaId   String?   @map("referencia_id")
  /// iniciado | concluido | erro
  status         String    @default("iniciado")
  totalRegistros Int?      @default(0) @map("total_registros")
  novos          Int?      @default(0)
  atualizados    Int?      @default(0)
  erros          Int?      @default(0)
  erroMensagem   String?   @map("erro_mensagem")
  iniciadoEm     DateTime  @default(now()) @map("iniciado_em") @db.Timestamptz(6)
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamptz(6)
  usuarioId      String?   @map("usuario_id") @db.Uuid

  @@index([tipo, iniciadoEm(sort: Desc)])
  @@index([status])
  @@map("sympla_sync_log")
}

// ====================================================================
// OMIE — Integração bidirecional com o ERP Omie
// ====================================================================

/// Configuração global da integração Omie. Linha única (id='omie').
model OmieConfig {
  id               String   @id @default("omie")
  appKey           String?  @map("app_key")
  /// app_secret CIFRADO (AES-256-GCM, chave FISCAL_CERT_ENCRYPTION_KEY)
  appSecret        String?  @map("app_secret")
  contaCorrente    String?  @map("conta_corrente")
  codigoCategoria  String?  @map("codigo_categoria")
  idVendedor       BigInt?  @map("id_vendedor")
  ativo            Boolean  @default(false)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("omie_config")
}

/// Lançamentos de pedidos da Loja no Omie.
model OmieLancamento {
  id              String    @id @default(uuid()) @db.Uuid
  pedidoId        String    @map("pedido_id") @db.Uuid
  pedido          LojaPedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  /// Produtos envolvidos neste pedido (para rastreio de SKU)
  produtoId       String?   @map("produto_id") @db.Uuid
  produto         LojaProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  omieNumero      String?   @map("omie_numero")
  omiePedidoId    BigInt?   @map("omie_pedido_id")
  /// pendente | lancado | erro | cancelado
  status          String    @default("pendente")
  erro            String?
  usuarioId       String?   @map("usuario_id") @db.Uuid
  usuarioNome     String?   @map("usuario_nome")
  lancadoEm       DateTime? @map("lancado_em") @db.Timestamptz(6)
  payloadEnviado  Json?     @map("payload_enviado")
  respostaOmie    Json?     @map("resposta_omie")
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([pedidoId], map: "omie_lancamentos_pedido_unico_idx")
  @@index([status])
  @@index([criadoEm(sort: Desc)])
  @@map("omie_lancamentos")
}
