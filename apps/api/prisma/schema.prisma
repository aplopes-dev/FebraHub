// --------------------------------------------------------------------
// PEDAGÓGICO P0 — Secretaria Digital do Aluno FEBRACIS
// --------------------------------------------------------------------

/// Turma operacional gerenciada pelo ERP. Distinta de DimTurma (legado
/// Salesforce somente leitura). É a entidade central do módulo pedagógico.
model PedagogicoTurma {
  id                     String    @id @default(uuid()) @db.Uuid
  /// ID Salesforce para sync idempotente (nullable: turma pode nascer no ERP)
  turmaIdSf              String?   @unique @map("turma_id_sf")
  /// FK fraca para dim_turmas.turma_id (sem constraint — dados legados)
  dimTurmaId             String?   @map("dim_turma_id")
  /// FK fraca para dim_cursos.curso_id
  cursoId                String?   @map("curso_id")
  nome                   String
  cursoNome              String    @map("curso_nome")
  unidade                String?
  local                  String?
  endereco               String?
  dataInicio             DateTime? @map("data_inicio") @db.Date
  dataFim                DateTime? @map("data_fim") @db.Date
  horarioInicio          String?   @map("horario_inicio")
  horarioFim             String?   @map("horario_fim")
  horarioCredenciamento  String?   @map("horario_credenciamento")
  treinador              String?
  /// FK fraca para usuarios.id (responsável pedagógico)
  responsavelId          String?   @map("responsavel_id") @db.Uuid
  capacidade             Int?      @default(30)
  /// Planejada|Aguardando Validação|Confirmada|Em Preparação|Em Andamento|Finalizada|Cancelada
  status                 String    @default("Planejada")
  linkGrupo              String?   @map("link_grupo")
  linkExterno            String?   @map("link_externo")
  sigla                  String?
  anoFiscal              Int?      @map("ano_fiscal")
  observacoes            String?
  criadoPor              String?   @map("criado_por") @db.Uuid
  criadoEm               DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm           DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  matriculas      PedagogicoMatricula[]
  credenciamentos PedagogicoCredenciamento[]
  presencas       PedagogicoPresenca[]
  transferenciasOrigem  PedagogicoTransferencia[] @relation("TransfOrigem")
  transferenciasDestino PedagogicoTransferencia[] @relation("TransfDestino")
  escalas         PedagogicoEscala[]

  @@index([status, dataInicio])
  @@index([unidade, status])
  @@index([dimTurmaId])
  @@index([cursoId])
  @@map("pedagogico_turmas")
}

/// Vínculo acadêmico: Pessoa ↔ Curso ↔ Turma.
/// pessoa_id é TEXT (FK fraca) pois aceita UUID do crm_clientes OU
/// aluno_id string do dim_alunos — ERP em transição.
model PedagogicoMatricula {
  id              String    @id @default(uuid()) @db.Uuid
  /// FK fraca: crm_clientes.id (UUID) ou dim_alunos.aluno_id (string)
  pessoaId        String    @map("pessoa_id")
  pessoaNome      String?   @map("pessoa_nome")
  pessoaCpf       String?   @map("pessoa_cpf")
  pessoaEmail     String?   @map("pessoa_email")
  pessoaTelefone  String?   @map("pessoa_telefone")
  turmaId         String    @map("turma_id") @db.Uuid
  /// ID Salesforce da matrícula — idempotência (§9 PRD)
  matriculaSfId   String?   @unique @map("matricula_sf_id")
  vendaId         String?   @map("venda_id")
  cursoId         String?   @map("curso_id")
  cursoNome       String?   @map("curso_nome")
  dataCompra      DateTime? @map("data_compra") @db.Date
  dataMatricula   DateTime? @default(dbgenerated("CURRENT_DATE")) @map("data_matricula") @db.Date
  validadeInicio  DateTime? @map("validade_inicio") @db.Date
  validadeFim     DateTime? @map("validade_fim") @db.Date
  dataConclusao   DateTime? @map("data_conclusao") @db.Date
  /// Matriculado|Aguardando Contato|Aguardando Resposta|Confirmado|Não Respondeu|
  /// Próxima Turma|Transferência Solicitada|Transferência Pendente|Transferido|
  /// Cancelamento Solicitado|Cancelado|Credenciado|Em Curso|Concluído|Faltou|Represado
  status          String    @default("Matriculado")
  /// salesforce|manual|portal|importacao
  origem          String?   @default("manual")
  unidade         String?
  vendedor        String?
  criadoPor       String?   @map("criado_por") @db.Uuid
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  turma           PedagogicoTurma    @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  historico       PedagogicoMatriculaHistorico[]
  confirmacoes    PedagogicoConfirmacao[]
  credenciamento  PedagogicoCredenciamento?
  presencas       PedagogicoPresenca[]
  transferencias  PedagogicoTransferencia[]
  solicitacoes    PedagogicoSolicitacao[]
  cs              PedagogicoCsAcompanhamento[]

  @@index([pessoaId])
  @@index([turmaId])
  @@index([status])
  @@index([pessoaCpf])
  @@index([validadeFim])
  @@index([pessoaId, status])
  @@map("pedagogico_matriculas")
}

/// Timeline de cada matrícula — cada evento relevante produz uma linha.
model PedagogicoMatriculaHistorico {
  id             BigInt   @id @default(autoincrement())
  matriculaId    String   @map("matricula_id") @db.Uuid
  /// status_mudou|venda_aprovada|matricula_criada|confirmado|nao_respondeu|
  /// credenciado|presenca|transferencia|cancelamento|conclusao|certificado|
  /// contato_registrado|observacao
  tipo           String
  descricao      String?
  valorAnterior  String?  @map("valor_anterior")
  valorNovo      String?  @map("valor_novo")
  usuarioId      String?  @map("usuario_id") @db.Uuid
  /// sistema|usuario|integracao|webhook|automacao
  origem         String?  @default("sistema")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  matricula PedagogicoMatricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@index([matriculaId, criadoEm(sort: Desc)])
  @@map("pedagogico_matricula_historico")
}

/// Registro de cada tentativa de contato para confirmar participação.
model PedagogicoConfirmacao {
  id            String    @id @default(uuid()) @db.Uuid
  matriculaId   String    @map("matricula_id") @db.Uuid
  /// whatsapp|email|ligacao|manual
  canal         String    @default("whatsapp")
  /// enviado|entregue|lido|respondido|confirmado|nao_respondeu|invalido|erro
  status        String    @default("enviado")
  mensagem      String?
  templateTipo  String?   @map("template_tipo")
  usuarioId     String?   @map("usuario_id") @db.Uuid
  resposta      String?
  respondidoEm  DateTime? @map("respondido_em") @db.Timestamptz(6)
  tentativaNum  Int       @default(1) @map("tentativa_num")
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  matricula PedagogicoMatricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@index([matriculaId])
  @@index([status])
  @@map("pedagogico_confirmacoes")
}

/// Check-in do aluno no evento. UNIQUE em matricula_id impede duplo credenciamento.
model PedagogicoCredenciamento {
  id          String   @id @default(uuid()) @db.Uuid
  matriculaId String   @unique @map("matricula_id") @db.Uuid
  turmaId     String   @map("turma_id") @db.Uuid
  pessoaId    String   @map("pessoa_id")
  /// credenciamento|recredenciamento
  tipo        String   @default("credenciamento")
  dispositivo String?
  usuarioId   String?  @map("usuario_id") @db.Uuid
  observacoes String?
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  matricula PedagogicoMatricula @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  turma     PedagogicoTurma     @relation(fields: [turmaId], references: [id], onDelete: Restrict)

  @@index([turmaId])
  @@map("pedagogico_credenciamentos")
}

/// Presença por aluno + turma + dia + sessão (não um booleano global).
/// UNIQUE(matriculaId, diaNume, sessao) impede duplicidade de registro.
model PedagogicoPresenca {
  id          String    @id @default(uuid()) @db.Uuid
  matriculaId String    @map("matricula_id") @db.Uuid
  turmaId     String    @map("turma_id") @db.Uuid
  pessoaId    String    @map("pessoa_id")
  diaNume     Int       @default(1) @map("dia_num")
  /// geral|manha|tarde|noite
  sessao      String    @default("geral")
  /// presente|ausente|justificado|atrasado
  status      String    @default("presente")
  entradaEm   DateTime? @map("entrada_em") @db.Timestamptz(6)
  dispositivo String?
  usuarioId   String?   @map("usuario_id") @db.Uuid
  observacoes String?
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  matricula PedagogicoMatricula @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  turma     PedagogicoTurma     @relation(fields: [turmaId], references: [id], onDelete: Restrict)

  @@unique([matriculaId, diaNume, sessao])
  @@index([turmaId])
  @@index([matriculaId])
  @@map("pedagogico_presencas")
}

/// Transferência de turma. Preserva o histórico completo — nunca sobrescreve.
model PedagogicoTransferencia {
  id              String         @id @default(uuid()) @db.Uuid
  matriculaId     String         @map("matricula_id") @db.Uuid
  turmaOrigemId   String         @map("turma_origem_id") @db.Uuid
  turmaDestinoId  String?        @map("turma_destino_id") @db.Uuid
  motivo          String?
  /// solicitada|aprovada|efetivada|cancelada
  status          String         @default("solicitada")
  taxaCobrada     Boolean        @default(false) @map("taxa_cobrada")
  valorTaxa       Decimal?       @map("valor_taxa") @db.Decimal(10, 2)
  pagamentoId     String?        @map("pagamento_id")
  usuarioId       String?        @map("usuario_id") @db.Uuid
  aprovadoPor     String?        @map("aprovado_por") @db.Uuid
  observacoes     String?
  criadoEm        DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime       @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  matricula     PedagogicoMatricula @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  turmaOrigem   PedagogicoTurma     @relation("TransfOrigem", fields: [turmaOrigemId], references: [id], onDelete: Restrict)
  turmaDestino  PedagogicoTurma?    @relation("TransfDestino", fields: [turmaDestinoId], references: [id], onDelete: SetNull)

  @@index([matriculaId])
  @@index([status])
  @@map("pedagogico_transferencias")
}

/// Monitor vinculado a cursos e turmas. pessoa_id é FK fraca.
model PedagogicoMonitor {
  id                 String   @id @default(uuid()) @db.Uuid
  /// FK fraca para usuarios.id
  usuarioId          String?  @map("usuario_id") @db.Uuid
  /// FK fraca: crm_clientes.id ou dim_alunos.aluno_id
  pessoaId           String   @map("pessoa_id")
  nome               String
  email              String?
  telefone           String?
  /// ativo|inativo|suspenso
  status             String   @default("ativo")
  cursosHabilitados  String[] @default([]) @map("cursos_habilitados")
  observacoes        String?
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  escalas PedagogicoEscala[]

  @@index([usuarioId])
  @@index([pessoaId])
  @@index([status])
  @@map("pedagogico_monitores")
}

/// Escala de monitor em uma turma. UNIQUE(turmaId, monitorId).
model PedagogicoEscala {
  id           String   @id @default(uuid()) @db.Uuid
  turmaId      String   @map("turma_id") @db.Uuid
  monitorId    String   @map("monitor_id") @db.Uuid
  /// monitor|lider|apoio|coordenador
  funcao       String?  @default("monitor")
  dataInicio   DateTime? @map("data_inicio") @db.Date
  dataFim      DateTime? @map("data_fim") @db.Date
  horario      String?
  kitEntregue  Boolean  @default(false) @map("kit_entregue")
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  turma   PedagogicoTurma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  monitor PedagogicoMonitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([turmaId, monitorId])
  @@index([monitorId])
  @@map("pedagogico_escalas")
}

/// Política configurável de validade, transferência e presença por curso.
model PedagogicoPolitica {
  id                   String         @id @default(uuid()) @db.Uuid
  /// FK fraca — aceita dim_cursos.curso_id ou nome livre
  cursoId              String         @unique @map("curso_id")
  cursoNome            String         @map("curso_nome")
  validadeQuantidade   Int            @default(12) @map("validade_quantidade")
  /// dias|meses
  validadeUnidade      String         @default("meses") @map("validade_unidade")
  /// data_compra|data_matricula|data_conclusao
  validadeRegra        String         @default("data_compra") @map("validade_regra")
  toleranciaDias       Int            @default(0) @map("tolerancia_dias")
  presencaMinimaPct    Decimal?       @default(75) @map("presenca_minima_pct") @db.Decimal(5, 2)
  taxaTransferencia    Decimal?       @default(200.00) @map("taxa_transferencia") @db.Decimal(10, 2)
  permiteTransferencia Boolean        @default(true) @map("permite_transferencia")
  maxTransferencias    Int?           @default(2) @map("max_transferencias")
  ativo                Boolean        @default(true)
  criadoPor            String?        @map("criado_por") @db.Uuid
  criadoEm             DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime       @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@index([ativo])
  @@map("pedagogico_politicas")
}

/// Log de integração com Salesforce e sistemas externos.
/// UNIQUE(sistemaOrigem, evento, idExterno) garante idempotência.
model PedagogicoIntegracaoLog {
  id            BigInt    @id @default(autoincrement())
  sistemaOrigem String    @default("salesforce") @map("sistema_origem")
  /// VENDA_APROVADA|VENDA_CANCELADA|SYNC_TURMA|SYNC_MATRICULA|etc.
  evento        String
  idExterno     String?   @map("id_externo")
  payload       Json?
  /// pendente|ok|erro|ignorado
  resultado     String    @default("pendente")
  matriculaId   String?   @map("matricula_id") @db.Uuid
  turmaId       String?   @map("turma_id") @db.Uuid
  erroMsg       String?   @map("erro_msg")
  tentativas    Int       @default(1)
  processadoEm  DateTime? @map("processado_em") @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@unique([sistemaOrigem, evento, idExterno])
  @@index([sistemaOrigem, resultado])
  @@index([idExterno])
  @@index([matriculaId])
  @@index([turmaId])
  @@map("pedagogico_integracao_logs")
}

/// Central de solicitações: certificado, declaração, transferência, etc.
model PedagogicoSolicitacao {
  id            String    @id @default(uuid()) @db.Uuid
  matriculaId   String?   @map("matricula_id") @db.Uuid
  pessoaId      String    @map("pessoa_id")
  /// certificado|declaracao|transferencia|cancelamento|titularidade|suporte
  tipo          String
  /// aberta|em_analise|aprovada|rejeitada|concluida
  status        String    @default("aberta")
  descricao     String?
  resposta      String?
  responsavelId String?   @map("responsavel_id") @db.Uuid
  /// baixa|normal|alta|urgente
  prioridade    String    @default("normal")
  prazo         DateTime? @db.Date
  resolvidoEm   DateTime? @map("resolvido_em") @db.Timestamptz(6)
  criadoPor     String?   @map("criado_por") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  matricula PedagogicoMatricula? @relation(fields: [matriculaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([tipo])
  @@index([pessoaId])
  @@index([responsavelId])
  @@map("pedagogico_solicitacoes")
}

/// Customer Success: alunos que precisam de atenção proativa.
model PedagogicoCsAcompanhamento {
  id            String    @id @default(uuid()) @db.Uuid
  matriculaId   String?   @map("matricula_id") @db.Uuid
  pessoaId      String    @map("pessoa_id")
  pessoaNome    String?   @map("pessoa_nome")
  /// nao_compareceu|nao_confirmou|nao_concluiu|transferencias_repetidas|
  /// reclamacao|validade_proxima|coaching_parado|pendencia
  motivo        String
  prioridade    String    @default("normal")
  /// aberto|em_acompanhamento|resolvido|descartado
  status        String    @default("aberto")
  responsavelId String?   @map("responsavel_id") @db.Uuid
  proximaAcao   String?   @map("proxima_acao")
  prazo         DateTime? @db.Date
  observacoes   String?
  resultado     String?
