// ====================================================================
// FebraHub — schema Prisma
//
// O banco NAO nasceu deste schema. As 43 tabelas de negocio (dim_*, fato_*,
// mv_*, stg_*) ja existiam no Supabase e vieram com os dados reais para o
// Postgres proprio. Este arquivo as descreve; nao as cria.
// Quem este arquivo cria de fato sao as 6 tabelas de aplicacao no topo —
// as que substituem o Supabase Auth e o Supabase Storage.
//
// Tres coisas de proposito NAO estao aqui:
//   1. As 109 views (vw_*) dos hubs. Elas somam, cruzam e agregam; virar
//      model do Client nao ajudaria e amarraria o schema a cada mudanca de
//      KPI. Leitura por $queryRaw, com o tipo declarado no service.
//   2. Foreign keys entre tabelas de negocio. O banco importado nao tem
//      nenhuma (o dump so trouxe as PKs), e inventar relacao aqui faria o
//      Client prometer join que o banco nao garante — nenhuma ponte deste
//      projeto chega a 100% de cobertura (ver docs/DESCOBERTAS.md §3).
//   3. Os @@index das tabelas de negocio. Eles vivem em
//      migrations/00000000000001_indices_negocio/migration.sql, porque dois
//      deles sao indices de EXPRESSAO — right(telefone, 8), a ponte lead →
//      aluno — e o Prisma nao sabe declarar isso. Descrever metade dos
//      indices aqui e a outra metade la seria pior do que descrever todos
//      em um lugar so. Os models de aplicacao, esses sim, declaram os seus.
// ====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// APLICACAO — substitui o Supabase Auth e o Supabase Storage
// ====================================================================

/// Usuario do portal, no lugar de auth.users.
/// Papel e setor moram aqui, e nao em uma tabela `perfis` a parte: aquela
/// indirecao existia so porque o Supabase nao deixava tocar em auth.users.
model Usuario {
  id                 String    @id @default(uuid()) @db.Uuid
  /// citext: "Dulce@febracis.com.br" e "dulce@febracis.com.br" sao a mesma
  /// conta. Resolver isso com lower() no app funciona ate o dia em que um
  /// caminho novo esquece o lower() e cria a segunda conta da mesma pessoa.
  email              String    @unique @db.Citext
  nome               String
  /// Nunca a senha. argon2id — a configuracao esta no AuthService e no seed.
  senhaHash          String    @map("senha_hash")
  /// admin | gestor | membro — CHECK no banco, ver a migration 00000000000000_init.
  /// Continua sendo a chave-mestra: `admin` atravessa qualquer permissao.
  papel              String
  /// Setor primario. Acesso a setores adicionais vive em PerfilSetor.
  setor              String
  /// Perfil de acesso (o QUE a pessoa pode fazer). Nulo cai no fallback
  /// derivado de papel/setor — ver PermissoesService.doUsuario.
  perfilAcessoId     String?   @map("perfil_acesso_id") @db.Uuid
  /// Desligamento nao apaga usuario: apaga-lo levaria junto a autoria dos
  /// arquivos e a leitura da trilha de auditoria.
  ativo              Boolean   @default(true)
  /// Os 6 usuarios migrados nascem com true: a Admin API do Supabase nao
  /// devolve encrypted_password, entao a senha antiga se perdeu na migracao
  /// e cada um recebe uma temporaria gerada pelo seed.
  precisaTrocarSenha Boolean   @default(false) @map("precisa_trocar_senha")
  ultimoLogin        DateTime? @map("ultimo_login") @db.Timestamptz(6)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  setores  PerfilSetor[]
  sessoes  Sessao[]
  arquivos Arquivo[]

  perfilAcesso         PerfilAcesso? @relation(fields: [perfilAcessoId], references: [id], onDelete: SetNull)
  notificacoes         Notificacao[] @relation("NotificacoesRecebidas")
  notificacoesEnviadas Notificacao[] @relation("NotificacoesEnviadas")
  brainCliente         BrainCliente?
  unidadesCompras      UsuarioUnidadeCompra[]

  @@index([perfilAcessoId])
  @@map("usuarios")
}

/// Perfil de acesso — o conjunto de FUNCIONALIDADES que a pessoa alcanca.
///
/// Nao substitui `setor`: os dois eixos respondem perguntas diferentes.
///   perfil -> o QUE se pode fazer  (abrir o Territorial, editar o organograma)
///   setor  -> SOBRE QUAIS DADOS    (as vendas do comercial, a receita do financeiro)
/// Um "Gestor de setor" e o mesmo perfil para todo mundo; quem muda de pessoa
/// para pessoa e o setor no cadastro. Quando um perfil precisa enxergar alem
/// do proprio setor, ele carrega as permissoes `setor.<hub>.ver` — e por isso
/// que podeVer() (setor.guard) consulta os dois lugares.
///
/// `permissoes` e um text[] e nao uma tabela de ligacao: a lista e curta,
/// sempre lida inteira e sempre gravada inteira. Uma tabela N:N so
/// acrescentaria um join a cada leitura.
model PerfilAcesso {
  id        String  @id @default(uuid()) @db.Uuid
  /// Chave estavel usada no seed e nas migrations. O nome pode ser reescrito
  /// pela tela; o slug, nao.
  slug      String  @unique
  nome      String
  descricao String?
  /// Perfil de sistema: nome, permissoes e exclusao ficam travados na API.
  /// Hoje so o `admin` — sem ele, uma edicao distraida tranca todo mundo
  /// para fora da propria tela de perfis.
  sistema   Boolean @default(false)
  /// Ids do catalogo (modules/permissoes/catalogo.ts). O que nao esta no
  /// catalogo e recusado na escrita.
  permissoes   String[] @default([])
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuarios Usuario[]

  @@map("perfis_acesso")
}

/// Credencial de UMA pessoa no GBrain.
///
/// O recorte de acesso ao conhecimento nao e feito filtrando a resposta
/// depois: cada pessoa tem um cliente OAuth proprio no gbrain, cujo
/// `federated_read` lista exatamente as fontes dos setores que ela alcanca.
/// Quem recusa e o gbrain, no SQL, antes de a busca acontecer — e por isso
/// nem a sintese (que le varias fontes de uma vez) pode vazar setor alheio.
///
/// `fontes` guarda o recorte com que o cliente foi provisionado. Quando o
/// perfil ou os setores da pessoa mudam, o conjunto calculado deixa de bater
/// com esta coluna e o servico reescopa o cliente la — e so entao.
model BrainCliente {
  usuarioId String   @id @map("usuario_id") @db.Uuid
  clientId  String   @unique @map("client_id")
  /// AES-256-GCM com a mesma chave dos tokens de agentes: o gbrain devolve o
  /// segredo UMA vez no registro, e sem guarda-lo a pessoa perderia o acesso
  /// no primeiro restart.
  segredo   String
  /// Fonte onde a pessoa ESCREVE (o setor primario dela).
  fonteEscrita String   @map("fonte_escrita")
  /// Fontes que ela LE. Espelho do que foi enviado ao gbrain.
  fontes       String[]
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("brain_clientes")
}

/// Credencial de MAQUINA no GBrain, uma por fonte.
///
/// Existe porque no gbrain um cliente OAuth escreve em UMA fonte so —
/// `put_page` ignora o source_id do corpo e usa a fonte do grant. A
/// sincronizacao dos indicadores publica em todas (uma pagina por setor),
/// entao precisa de uma credencial por fonte. Nao pertencem a pessoa
/// nenhuma, e por isso nao cabem em BrainCliente (que tem FK para Usuario).
model BrainClienteServico {
  fonte        String   @id
  clientId     String   @unique @map("client_id")
  segredo      String
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("brain_clientes_servico")
}

/// Configuracao do motor de resposta da memoria institucional.
///
/// Linha unica (id fixo 'brain'). A chave do provedor vive AQUI, cifrada com
/// a mesma chave dos tokens de agentes, e nao numa variavel de ambiente: quem
/// troca de chave e a diretoria pela tela, e variavel de ambiente exigiria
/// deploy. Nunca sai da API em texto claro — a tela recebe so `temChave`.
model BrainConfig {
  id            String   @id @default("brain")
  /// AES-256-GCM. Nulo = sem provedor pago: a sintese cai no modelo local.
  chaveOpenai   String?  @map("chave_openai")
  /// Modelo de sintese. gpt-5.6-luna e o padrao (qualidade/custo).
  modelo        String   @default("gpt-5.6-luna")
  /// Cron diario ligado? Desligar congela a republicacao automatica.
  consolidacaoAtiva Boolean @default(true) @map("consolidacao_ativa")
  /// Horario local HH:MM (America/Bahia por padrao). Vira cron `M H * * *`.
  consolidacaoHora  String  @default("04:05") @map("consolidacao_hora")
  consolidacaoFuso  String  @default("America/Bahia") @map("consolidacao_fuso")
  ultimaConsolidacaoEm DateTime? @map("ultima_consolidacao_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  atualizadoPor String?  @map("atualizado_por") @db.Uuid

  @@map("brain_config")
}

/// Configuracao da integracao com o Zernio (redes sociais).
///
/// Linha unica (id fixo 'social'), mesma decisao do BrainConfig: a chave fica
/// cifrada no banco e e trocada pela tela. A API e o UNICO cliente do Zernio —
/// o navegador nunca recebe a chave, so o resultado ja traduzido.
model SocialConfig {
  id            String   @id @default("social")
  /// AES-256-GCM. Nulo = integracao desligada; a tela pede a chave.
  chaveZernio   String?  @map("chave_zernio")
  /// Profile (workspace) do Zernio quando a conta tem mais de um. Nulo = todos.
  perfilZernio  String?  @map("perfil_zernio")
  /// Conta de anuncios padrao do painel de campanhas (act_<n> no Meta).
  contaAnuncio  String?  @map("conta_anuncio")
  /// Fuso usado no agendamento. A Febracis Salvador opera em America/Bahia.
  fuso          String   @default("America/Bahia")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  atualizadoPor String?  @map("atualizado_por") @db.Uuid

  @@map("social_config")
}

/// Notificacao de uma pessoa. Uma linha POR DESTINATARIO, mesmo quando o
/// envio foi em lote: quem leu, quando leu e quem apagou sao respostas
/// individuais, e uma tabela de "envio" com outra de "leitura" precisaria de
/// join em toda abertura do sino.
model Notificacao {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  titulo    String
  mensagem  String
  /// info | sucesso | alerta | erro — CHECK no banco; decide a cor no sino.
  tipo      String    @default("info")
  /// Rotulo curto de agrupamento ('sistema', 'acesso', 'comunicado'…).
  categoria String?
  /// Rota interna que o item abre ao ser clicado. Sempre comeca com '/':
  /// notificacao nao leva ninguem para fora do hub.
  href      String?
  lidaEm    DateTime? @map("lida_em") @db.Timestamptz(6)
  criadaEm  DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)
  /// Quem disparou. Nulo quando quem gerou foi o proprio sistema.
  criadaPor String?   @map("criada_por") @db.Uuid

  usuario Usuario  @relation("NotificacoesRecebidas", fields: [usuarioId], references: [id], onDelete: Cascade)
  autor   Usuario? @relation("NotificacoesEnviadas", fields: [criadaPor], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadaEm(sort: Desc)])
  @@map("notificacoes")
}

/// Setores extras que o usuario enxerga alem do proprio.
/// Existe porque o acesso real nao e 1:1: o Financeiro tambem precisa do
/// Comercial para conciliar venda contra recebimento.
model PerfilSetor {
  usuarioId String @map("usuario_id") @db.Uuid
  setor     String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, setor])
  @@map("usuario_setores")
}

/// Uma linha por sessao viva. O id E o jti do refresh token, entao revogar
/// e um UPDATE em linha conhecida, sem varrer tabela nem decodificar JWT.
/// Guarda o hash, nunca o token: um dump vazado nao vira sessao valida.
model Sessao {
  /// Texto livre, nao uuid: o formato do jti e decisao do AuthService.
  id         String    @id
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  ip         String?
  agente     String?
  criadaEm   DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(6)
  /// Preenchido no logout e na troca de senha (que derruba todas as sessoes).
  revogadaEm DateTime? @map("revogada_em") @db.Timestamptz(6)
  /// Id (jti) da sessao que sucedeu esta numa rotacao legitima. Ausente em
  /// revogacao explicita — e o que separa "rodou" de "foi derrubada".
  substituidaPor String? @map("substituida_por")
  /// Teto absoluto da familia: o vencimento desliza a cada refresh, mas
  /// nunca ultrapassa esta data (nasce no login).
  absolutaExpiraEm DateTime? @map("absoluta_expira_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  /// Para o expurgo periodico varrer so o que ja venceu.
  @@index([expiraEm])
  @@map("sessoes")
}

/// Tentativa de login — alimenta o rate limit por e-mail e por IP.
/// Separada de AuditoriaAcesso porque cresce em outra ordem de grandeza
/// (todo bot que achar o /login escreve aqui) e tem expurgo proprio.
model TentativaLogin {
  id       BigInt   @id @default(autoincrement())
  /// String comum, nao citext: aqui e o que a pessoa digitou, inclusive
  /// e-mail que nao existe. E dado de tentativa, nao chave de usuario.
  email    String
  ip       String
  agente   String?
  sucesso  Boolean
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

/// Metadado do que esta no MinIO. O bucket guarda bytes; quem sabe o nome
/// original, quem subiu e a que registro o arquivo pertence e o banco.
model Arquivo {
  id           String    @id @default(uuid()) @db.Uuid
  /// Caminho do objeto no bucket. Unico porque um objeto so pode ter um dono
  /// de metadado — duas linhas apontando para a mesma chave fariam a exclusao
  /// de uma apagar o arquivo da outra.
  chave        String    @unique
  nomeOriginal String    @map("nome_original")
  mime         String
  tamanho      Int
  /// Hash do conteudo: deduplicacao na subida e integridade no download.
  sha256       String
  pasta        String
  enviadoPor   String    @map("enviado_por") @db.Uuid
  /// Vinculo generico (tipo + id) em vez de uma FK por hub: o anexo pode
  /// pendurar em turma, evento ou pagamento, e os ids de negocio sao text de
  /// sistemas diferentes. FK real exigiria uma coluna nova a cada hub novo.
  vinculoTipo  String?   @map("vinculo_tipo")
  vinculoId    String?   @map("vinculo_id")
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  /// Exclusao logica: o objeto sai do MinIO, a linha fica para a auditoria
  /// saber que existiu e quem apagou.
  excluidoEm   DateTime? @map("excluido_em") @db.Timestamptz(6)

  /// Restrict de proposito: quem subiu arquivo nao se apaga, se desativa.
  usuario Usuario @relation(fields: [enviadoPor], references: [id], onDelete: Restrict)

  @@index([vinculoTipo, vinculoId])
  @@index([enviadoPor, criadoEm])
  @@index([pasta])
  @@index([sha256])
  @@map("arquivos")
}

/// Trilha de login, logout, upload e exclusao.
/// Meta real de um indicador do Hub Executivo. docs/DIVIDAS.md §9 pedia
/// exatamente isto: meta que existe de verdade, com trilha de quem mudou o
/// quê (a trilha vive em AuditoriaAcesso, acao 'meta_definida'). Sem linha
/// aqui o painel mostra "Sem meta definida" — nunca um número inventado.
model MetaIndicador {
  id           String   @id @default(uuid()) @db.Uuid
  /// Código do catálogo de indicadores (modules/executivo). Sem FK: o
  /// catálogo é código; a API valida o código antes de gravar.
  indicador    String
  /// 'mes' = meta do mês da competência; 'ano' = meta anual (competência 01/01).
  escopo       String   @default("mes")
  competencia  DateTime @db.Date
  valor        Decimal  @db.Decimal
  observacao   String?
  /// Solto, sem FK, como em AuditoriaAcesso: a meta sobrevive ao usuário.
  criadoPor    String?  @map("criado_por") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@unique([indicador, escopo, competencia], map: "ux_meta_indicador_periodo")
  @@map("meta_indicador")
}

/// Personalização do Hub Executivo. id é o uuid do usuário como texto, ou o
/// literal 'empresa' — a visão padrão administrável que vale para quem nunca
/// personalizou. jsonb porque o conjunto de preferências evolui com o painel
/// e cada chave nova não pode exigir migration.
model HubPreferencia {
  id           String   @id
  config       Json     @default("{}") @db.JsonB
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@map("hub_preferencia")
}

model AuditoriaAcesso {
  id        BigInt   @id @default(autoincrement())
  /// Solto, SEM foreign key: a trilha tem que sobreviver ao usuario, e uma FK
  /// aqui impediria registrar acao de conta que nunca existiu.
  usuarioId String?  @map("usuario_id") @db.Uuid
  acao      String
  recurso   String
  /// Contexto livre por acao (chave do arquivo, filtro da consulta, motivo).
  /// jsonb e nao json: da para indexar e comparar depois.
  detalhe   Json?    @db.JsonB
  ip        String?
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([usuarioId, criadoEm])
  @@index([acao, criadoEm])
  @@map("auditoria_acesso")
}

// ====================================================================
// NEGOCIO — as 43 tabelas que ja vieram com dados
//
// Regras que valem para o bloco inteiro:
//
//  * Todo *_id de negocio e text. Nao e desleixo: CPF tem zero a esquerda
//    (05107434550). Vira bigint, perde o zero, fica com 10 digitos e nunca
//    mais casa com nada — o mesmo vale para telefone e para id de sistema
//    externo (Salesforce, Clint, Sympla) que so parece numero.
//    A excecao esta na loja: la os ids sao contadores do PDV e sao bigint
//    de verdade no banco (ver o comentario em FatoLojaCupom).
//
//  * Dinheiro e Decimal @db.Decimal, sem precisao declarada, porque as
//    colunas sao numeric sem precisao no banco. Fixar (18,4) aqui faria o
//    Prisma querer ALTER em 40 tabelas cheias na primeira migration.
//
//  * Quase toda coluna e opcional: a carga veio de 5 integracoes e so as PKs
//    sao NOT NULL. O `?` aqui e o retrato honesto do dado, nao pessimismo.
//
//  * Data e date, timestamptz ou timestamp conforme o banco. Os tres
//    convivem porque as fontes gravam diferente; nao unifique no schema —
//    unifique na consulta, senao o Client passa a mentir sobre o fuso.
// ====================================================================

// --------------------------------------------------------------------
// DIMENSOES
// Dimensoes — o "quem" e o "o que". Chave natural do sistema de origem,
// nunca id sintetico: e por ela que o ETL faz upsert todo dia.
// --------------------------------------------------------------------

/// cpf, telefone e doc_norm sao text e continuam text. CPF com zero a
/// esquerda (05107434550) vira 10 digitos em qualquer tipo numerico e para
/// de casar com tudo. doc_norm e o CPF so com digitos: e a ponte de 74% de
/// cobertura entre comprador de evento e aluno.
model DimAluno {
  alunoId               String    @id @map("aluno_id")
  nome                  String?
  email                 String?
  cidade                String?
  estado                String?
  idade                 Int?
  dataNascimento        DateTime? @map("data_nascimento") @db.Date
  cargo                 String?
  empresa               String?
  ultimaAtividade       DateTime? @map("ultima_atividade") @db.Date
  dataUltimaModificacao DateTime? @map("data_ultima_modificacao") @db.Date
  unidade               String?
  consultorAtual        String?   @map("consultor_atual")
  cursoAtual            String?   @map("curso_atual")
  cpf                   String?
  telefone              String?
  sexo                  String?
  docNorm               String?   @map("doc_norm")

  @@map("dim_alunos")
}

model DimCalendario {
  data        DateTime @id @db.Date
  ano         Int?
  mes         Int?
  trimestre   Int?
  diaSemana   String?  @map("dia_semana")
  feriado     Boolean?
  feriadoNome String?  @map("feriado_nome")

  @@map("dim_calendario")
}

model DimConsultor {
  consultorId  String   @id @map("consultor_id")
  nome         String?
  equipe       String?
  ativo        Boolean?
  email        String?
  primeiroNome String?  @map("primeiro_nome")
  sobrenome    String?
  fotoUrl      String?  @map("foto_url")
  ativa        Boolean?

  @@map("dim_consultores")
}

model DimCurso {
  cursoId         String   @id @map("curso_id")
  nomeCurso       String?  @map("nome_curso")
  tipo            String?
  nomeCurto       String?  @map("nome_curto")
  gradePedagogico Boolean? @map("grade_pedagogico")

  @@map("dim_cursos")
}

model DimEvento {
  eventoId     String    @id @map("evento_id")
  idReferencia String?   @map("id_referencia")
  nomeEvento   String?   @map("nome_evento")
  dataInicio   DateTime? @map("data_inicio") @db.Timestamptz(6)
  dataFinal    DateTime? @map("data_final") @db.Timestamptz(6)
  localEvento  String?   @map("local_evento")
  endereco     String?
  bairro       String?
  cidade       String?

  @@map("dim_eventos")
}

/// grupoId aqui e uuid de verdade: a tabela nasceu no proprio app, nao veio
