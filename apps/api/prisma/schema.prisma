  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  sessao    PdvCaixaSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  @@index([sessaoId, criadoEm(sort: Desc)])
  @@map("pdv_caixa_movimentos")
}

model PdvVenda {
