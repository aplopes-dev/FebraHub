  ano          Int?
  mesNome      String?   @map("mes_nome")
  faturamento  Decimal?  @db.Decimal
  metaMinima   Decimal?  @map("meta_minima") @db.Decimal
  metaBasica   Decimal?  @map("meta_basica") @db.Decimal
  metaMaster   Decimal?  @map("meta_master") @db.Decimal
  detalhe      String?
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamptz(6)
