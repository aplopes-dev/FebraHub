}

// --------------------------------------------------------------------
// PEDAGOGICO
// Pedagogico — credenciamento, presenca, avaliacao e retencao.
// --------------------------------------------------------------------

/// PK composta (alunoId, cursoNorm, turma): o mesmo aluno se credencia em
/// varias turmas, e o nome do curso chega sujo da fonte — cursoNorm e a
/// versao normalizada que serve de chave.
model FatoCredenciamento {
  alunoId            String    @map("aluno_id")
  cursoId            String?   @map("curso_id")
  cursoNorm          String    @map("curso_norm")
  turma              String
  dataCredenciamento DateTime? @map("data_credenciamento") @db.Date
  unidade            String?

  @@id([alunoId, cursoNorm, turma])
  @@map("fato_credenciamento")
}

/// Staging cru do ETL: tudo text, inclusive dataCredenciamento, e sem PK.
/// @@ignore — nao e para consumir daqui, e o rascunho antes do
/// FatoCredenciamento.
model StgCredenciamento {
  alunoId            String? @map("aluno_id")
  cursoId            String? @map("curso_id")
  cursoNorm          String? @map("curso_norm")
  turma              String?
  dataCredenciamento String? @map("data_credenciamento")
  unidade            String?

  @@map("stg_credenciamento")
  @@ignore
}

