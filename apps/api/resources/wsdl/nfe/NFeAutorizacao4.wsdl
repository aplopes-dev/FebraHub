<?xml version="1.0" encoding="UTF-8"?>
<!--
  ATENÇÃO — WSDL de autoria própria, NÃO obtido do endpoint oficial.

  Este arquivo NÃO foi baixado nem verificado contra o WSDL real publicado
  pela SEFAZ-BA (sem acesso de rede a hnfe.sefaz.ba.gov.br neste ambiente de
  desenvolvimento — confirmado via tentativa de WebFetch, que falhou com
  "unable to get local issuer certificate": a cadeia de CA raiz ICP-Brasil
  não está nas trust stores padrão, um problema conhecido de integrações
  Node/TLS com certificados ICP-Brasil, distinto de bloqueio de rede).

  Modela o contrato nacional estável e documentado do webservice
  NFeAutorizacao4 (idêntico em estrutura — só o endpoint muda — para todas as
  UFs desde a NF-e versão 3.10): uma única operação `nfeAutorizacaoLote` que
  recebe `nfeDadosMsg` (a string contendo o XML `<enviNFe>` bruto, já
  assinado) e devolve `nfeResultMsg` (a string contendo o XML `<retEnviNFe>`
  bruto de resposta). Os elementos são tipados como `xsd:string` (não
  `xsd:any`/complexo) deliberadamente — o cliente (`sefaz-soap-client.ts`)
  embute/extrai o XML bruto manualmente (`escapeXML: false` no envio,
  `client.lastResponse` + libxmljs2/XPath na leitura), então o tipo exato
  declarado aqui só precisa ser suficiente para o `soap` (node-soap) montar o
  envelope — não precisa espelhar a estrutura completa do enviNFe/retEnviNFe.

  Antes do primeiro teste real em homologação, confirmar este contrato contra
  o WSDL oficial, por exemplo:
  https://hnfe.sefaz.ba.gov.br/webservices/NFeAutorizacao4/NFeAutorizacao4.asmx?wsdl
  (endpoints de produção/homologação confirmados pelo usuário em
  `NF-e versão 4.0_ambientes.txt`, neste mesmo diretório).
-->
<wsdl:definitions
    name="NFeAutorizacao4"
    targetNamespace="http://www.portalfiscal.inf.br/nfe/wsdl/NFeAutorizacao4"
    xmlns:tns="http://www.portalfiscal.inf.br/nfe/wsdl/NFeAutorizacao4"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">

  <wsdl:types>
    <xsd:schema targetNamespace="http://www.portalfiscal.inf.br/nfe/wsdl/NFeAutorizacao4">
      <xsd:element name="nfeDadosMsg" type="xsd:string"/>
      <xsd:element name="nfeResultMsg" type="xsd:string"/>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="nfeAutorizacaoLoteRequest">
    <wsdl:part name="parameters" element="tns:nfeDadosMsg"/>
  </wsdl:message>
  <wsdl:message name="nfeAutorizacaoLoteResponse">
    <wsdl:part name="parameters" element="tns:nfeResultMsg"/>
  </wsdl:message>

  <wsdl:portType name="NfeAutorizacao4Soap">
    <wsdl:operation name="nfeAutorizacaoLote">
      <wsdl:input message="tns:nfeAutorizacaoLoteRequest"/>
      <wsdl:output message="tns:nfeAutorizacaoLoteResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="NfeAutorizacao4SoapBinding" type="tns:NfeAutorizacao4Soap">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
    <wsdl:operation name="nfeAutorizacaoLote">
      <soap:operation soapAction="http://www.portalfiscal.inf.br/nfe/wsdl/NFeAutorizacao4/nfeAutorizacaoLote" style="document"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="NfeAutorizacao4">
    <wsdl:port name="NfeAutorizacao4Soap" binding="tns:NfeAutorizacao4SoapBinding">
      <soap:address location="https://hnfe.sefaz.ba.gov.br/webservices/NFeAutorizacao4/NFeAutorizacao4.asmx"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
