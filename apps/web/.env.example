# URL que o BROWSER usa para falar com a API. Deixe em `/api` (mesma origem):
# é o que permite o cookie httpOnly de sessão viajar sem CORS.
NEXT_PUBLIC_API_URL=/api

# URL interna da API NestJS (rede do Docker). Só o SERVIDOR Next usa — o
# rewrite de `/api/*` aponta pra cá. Vazia em dev, quando a API roda no host.
# API_INTERNAL_URL=http://api:3000
