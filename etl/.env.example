# FebraHub · etl/.env.example
#
# Copie para etl/.env e preencha. O .env está no .gitignore — nenhum valor
# real deste arquivo pode ser commitado.
#
# No GitHub Actions estes mesmos nomes viram secrets (ou vars, no caso da
# URL); os workflows exportam só o que cada passo precisa.

# ---------------------------------------------------------------------
# API do FebraHub — o destino de TODA a carga
# ---------------------------------------------------------------------
# Substituiu o PostgREST do Supabase. O token abaixo é de máquina: só abre
# as rotas /ingest e só as tabelas do catálogo de ingestão. Não é sessão de
# usuário e não lê hub nenhum.
FEBRAHUB_API_URL=https://febracis.aplopes.com/api
FEBRAHUB_ETL_TOKEN=

# ---------------------------------------------------------------------
# Sympla — pedidos e participantes de evento
# ---------------------------------------------------------------------
SYMPLA_TOKEN=
SYMPLA_BASE_URL=https://api.sympla.com.br/public/v1.5.1

# ---------------------------------------------------------------------
# CisPay — liquidação de cartão e extrato
# ---------------------------------------------------------------------
CISPAY_API_KEY=
CISPAY_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# ---------------------------------------------------------------------
# Conta Azul — contas a receber e a pagar
# ---------------------------------------------------------------------
# Só o par client id/secret vive aqui. O refresh_token fica na tabela
# integracao_tokens (ele rotaciona a cada renovação; arquivo não acompanha).
# Para semear o primeiro:
#   python contaazul_sync.py --semear-token <refresh_token_inicial>
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Meta Ads — investimento por anúncio
# ---------------------------------------------------------------------
# ATENÇÃO: o token de longa duração expira a cada 60 dias. Quando expira, o
# investimento simplesmente para de atualizar.
META_TOKEN=
META_ACCOUNT_ID=act_000000000000000

# ---------------------------------------------------------------------
# Omie — cupons, pagamentos e estoque da loja
# ---------------------------------------------------------------------
OMIE_APP_KEY=
OMIE_APP_SECRET=

# ---------------------------------------------------------------------
# Google Sheets — planilhas da loja (faturamento, metas, receitas extras)
# ---------------------------------------------------------------------
# JSON inteiro da conta de serviço, em uma linha. Alternativa local:
# GOOGLE_SERVICE_ACCOUNT_FILE com o caminho do arquivo.
# As 5 planilhas precisam estar compartilhadas com o client_email da conta,
# senão o passo falha com 403.
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ---------------------------------------------------------------------
# Gmail — relatórios agendados do Salesforce chegam por e-mail
# ---------------------------------------------------------------------
# GMAIL_APP_PASSWORD é senha de APP (conta com 2FA), NUNCA a senha real.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Opcionais: texto procurado no assunto. Vazio cai no padrão do script.
SF_ASSUNTO_PAGAMENTO=Base pagamentos
SF_ASSUNTO_ALUNOS=Base alunos
