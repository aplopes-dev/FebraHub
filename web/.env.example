# A anon key é PÚBLICA por design. Não há segredo aqui.
# Quem protege o dado é a RLS no Postgres — não esta chave.
# Supabase → Project Settings → API → anon public
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# "producao" (padrão, pode deixar de fora) ou "homologacao".
# Homologação liga a faixa de aviso no topo e marca a página como noindex.
# Ver docs/HOMOLOGACAO.md
VITE_APP_ENV=producao
